          "name": "punctuation.accessor.optional.somonscript"
        },
        {
          "match": "\\?(?=\\s*:)",
          "name": "keyword.operator.optional.somonscript"
        },
        {
          "match": "\\?|:",
          "name": "keyword.operator.ternary.somonscript"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ";",
          "name": "punctuation.terminator.statement.somonscript"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.somonscript"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.somonscript"
        }
      ]
    }
  }
}
