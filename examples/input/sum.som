// Ду рақамро мехонад ва ҷамъи онҳоро чоп мекунад.
//
// Иҷро (рақамҳоро нависед ва Enter-ро пахш кунед):
//   somon run examples/input/sum.som
// Вуруд аз файл:
//   somon run examples/input/sum.som < examples/input/sum.txt

тағ а = хонданиРақам("Рақами якум: ");
тағ б = хонданиРақам("Рақами дуюм: ");
чоп("Ҷамъ:", а + б);
