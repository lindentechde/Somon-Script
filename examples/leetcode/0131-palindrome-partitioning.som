// 131. Тақсимот ба палиндромҳо (Palindrome Partitioning)
// https://leetcode.com/problems/palindrome-partitioning/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сатри с дода шудааст. Онро ба қисмҳое тақсим кунед, ки ҳар қисм
// палиндром бошад. Ҳамаи тақсимоти имконпазирро баргардонед.
//
// Усул: Аввал бо барномасозии динамикӣ ҷадвали палиндромҳоро месозем:
// пал[и][ҷ] = с[и] === с[ҷ] ва (ҷ - и < 2 ё пал[и+1][ҷ-1]). Баъд бо
// ақибгардӣ (backtracking) аз ҳар мавқеъ ҳар префикси палиндромиро ҳамчун
// қисми навбатӣ интихоб карда, боқимондаро ба таври рекурсивӣ тақсим мекунем.
// Мураккабӣ: вақт O(n · 2^n), хотира O(n^2) барои ҷадвал (бе ҳисоби ҷавоб).

функсия тақсимотиПалиндромӣ(с: сатр): сатр[][] {
    собит н = с.дарозӣ;
    // пал[и][ҷ] — оё с[и..ҷ] палиндром аст.
    собит пал: мантиқӣ[][] = рӯйхат.аз({ length: н }, () => нав рӯйхат(н).пурКардан(нодуруст));
    барои (тағ и = н - 1; и >= 0; и--) {
        барои (тағ ҷ = и; ҷ < н; ҷ++) {
            пал[и][ҷ] = с[и] === с[ҷ] && (ҷ - и < 2 || пал[и + 1][ҷ - 1]);
        }
    }

    собит ҷавобҳо: сатр[][] = [];
    собит ҷорӣ: сатр[] = [];
    функсия ақибгардӣ(оғоз: рақам): беджавоб {
        агар (оғоз === н) {
            ҷавобҳо.илова(ҷорӣ.буридан());
            бозгашт;
        }
        барои (тағ анҷом = оғоз; анҷом < н; анҷом++) {
            агар (пал[оғоз][анҷом]) {
                ҷорӣ.илова(с.қисмат(оғоз, анҷом + 1));
                ақибгардӣ(анҷом + 1);
                ҷорӣ.баровардан();
            }
        }
    }
    ақибгардӣ(0);
    бозгашт ҷавобҳо;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Тартиби тақсимот аҳамият надорад — ҳар ду тарафро мураттаб мекунем.
функсия мураттаб(тақсимот: сатр[][]): сатр[] {
    бозгашт тақсимот.харита((қисмҳо: сатр[]) => JSON.stringify(қисмҳо)).тартиб();
}

санҷ("мисол 1", мураттаб(тақсимотиПалиндромӣ("aab")), мураттаб([["a", "a", "b"], ["aa", "b"]]));
санҷ("мисол 2", мураттаб(тақсимотиПалиндромӣ("a")), мураттаб([["a"]]));
санҷ(
    "ҳарфҳои якхела",
    мураттаб(тақсимотиПалиндромӣ("aaa")),
    мураттаб([["a", "a", "a"], ["a", "aa"], ["aa", "a"], ["aaa"]])
);
санҷ("бе палиндроми дароз", мураттаб(тақсимотиПалиндромӣ("abc")), мураттаб([["a", "b", "c"]]));
санҷ(
    "палиндроми ҷуфт",
    мураттаб(тақсимотиПалиндромӣ("abba")),
    мураттаб([["a", "b", "b", "a"], ["a", "bb", "a"], ["abba"]])
);
санҷ(
    "racecar",
    мураттаб(тақсимотиПалиндромӣ("racecar")),
    мураттаб([
        ["r", "a", "c", "e", "c", "a", "r"],
        ["r", "a", "cec", "a", "r"],
        ["r", "aceca", "r"],
        ["racecar"],
    ])
);
санҷ("ҳарфҳои кириллӣ", мураттаб(тақсимотиПалиндромӣ("кок")), мураттаб([["к", "о", "к"], ["кок"]]));
// Барои n ҳарфи якхела 2^(n-1) тақсимот вуҷуд дорад.
санҷ("16 ҳарфи якхела (шумора)", тақсимотиПалиндромӣ("a".такрор(16)).дарозӣ, 32768);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
