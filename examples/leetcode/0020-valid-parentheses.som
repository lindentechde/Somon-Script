// 20. Қавсҳои дуруст (Valid Parentheses)
// https://leetcode.com/problems/valid-parentheses/
// Сатҳ: Осон (Easy)
//
// Шарт: Сатре дода шудааст, ки танҳо аз аломатҳои '(', ')', '{', '}', '[' ва
// ']' иборат аст. Муайян кунед, ки сатр дуруст аст: ҳар қавси кушода бо
// қавси ҳамон навъ ва бо тартиби дуруст пӯшида мешавад.
//
// Усул: Стек — қавсҳои кушодаро ба стек мегузорем; ҳангоми дидани қавси
// пӯшида болои стек бояд ҷуфти мувофиқи он бошад.
// Мураккабӣ: вақт O(n), хотира O(n).

функсия қавсҳоиДуруст(с: сатр): мантиқӣ {
    собит ҷуфтҳо = нав Map<сатр, сатр>([
        [")", "("],
        ["]", "["],
        ["}", "{"],
    ]);
    собит стек: сатр[] = [];
    барои (собит аломат аз с) {
        собит кушода = ҷуфтҳо.бозгирифтан(аломат);
        агар (кушода === беқимат) {
            // Қавси кушода.
            стек.илова(аломат);
        } вагарна агар (стек.баровардан() !== кушода) {
            бозгашт нодуруст;
        }
    }
    бозгашт стек.дарозӣ === 0;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", қавсҳоиДуруст("()"), дуруст);
санҷ("мисол 2", қавсҳоиДуруст("()[]{}"), дуруст);
санҷ("мисол 3", қавсҳоиДуруст("(]"), нодуруст);
санҷ("мисол 4", қавсҳоиДуруст("([])"), дуруст);
санҷ("мисол 5", қавсҳоиДуруст("([)]"), нодуруст);
санҷ("як қавси кушода", қавсҳоиДуруст("("), нодуруст);
санҷ("як қавси пӯшида", қавсҳоиДуруст("]"), нодуруст);
санҷ("пӯшида пеш аз кушода", қавсҳоиДуруст(")("), нодуруст);
санҷ("лонаи чуқур", қавсҳоиДуруст("{[()()]}[{}]"), дуруст);
санҷ("кушодаи зиёдатӣ", қавсҳоиДуруст("(()"), нодуруст);
санҷ("сатри дароз", қавсҳоиДуруст("(".такрор(5000) + ")".такрор(5000)), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
