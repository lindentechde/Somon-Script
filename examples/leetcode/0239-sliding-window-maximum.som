// 239. Ҳадди аксар дар равзанаи лағжанда (Sliding Window Maximum)
// https://leetcode.com/problems/sliding-window-maximum/
// Сатҳ: Душвор (Hard)
//
// Шарт: Рӯйхати рақамҳо ва андозаи равзана k дода шудааст. Равзана аз
// чап ба рост як қадамӣ ҳаракат мекунад. Барои ҳар мавқеи равзана
// қимати калонтаринро баргардонед.
//
// Усул: Навбати дутарафаи якнавохт (monotonic deque). Дар навбат индексҳоро
// нигоҳ медорем, ки қиматҳояшон аз сар ба охир кам мешаванд. Пеш аз илова
// кардани унсури нав ҳамаи индексҳои охиреро, ки қиматашон хурдтар ё
// баробар аст, хориҷ мекунем; индекси сар, агар аз равзана берун монда
// бошад, хориҷ мешавад. Сари навбат ҳамеша ҳадди аксари равзана аст.
// Навбат бо рӯйхат ва нишондиҳандаи "сар" сохта шудааст, то хориҷ кардан
// аз аввал O(1) бошад.
// Мураккабӣ: вақт O(n), хотира O(k).

функсия ҳаддиАксариРавзана(рақамҳо: рақам[], к: рақам): рақам[] {
    собит навбат: рақам[] = []; // индексҳо; қиматҳо аз сар ба охир кам мешаванд
    тағ сар = 0;
    собит натиҷа: рақам[] = [];
    барои (тағ и = 0; и < рақамҳо.дарозӣ; и++) {
        // Индекси сар аз равзана берун монд — хориҷ мекунем.
        агар (сар < навбат.дарозӣ && навбат[сар] <= и - к) {
            сар++;
        }
        // Унсурҳои хурдтар ё баробар дигар ҳеҷ гоҳ ҳадди аксар намешаванд.
        то (навбат.дарозӣ > сар && рақамҳо[навбат[навбат.дарозӣ - 1]] <= рақамҳо[и]) {
            навбат.баровардан();
        }
        навбат.илова(и);
        агар (и >= к - 1) {
            натиҷа.илова(рақамҳо[навбат[сар]]);
        }
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҳаддиАксариРавзана([1, 3, -1, -3, 5, 3, 6, 7], 3), [3, 3, 5, 5, 6, 7]);
санҷ("мисол 2", ҳаддиАксариРавзана([1], 1), [1]);
санҷ("k = 1", ҳаддиАксариРавзана([4, -2, 7], 1), [4, -2, 7]);
санҷ("k = n", ҳаддиАксариРавзана([2, 9, 4, 1], 4), [9]);
санҷ("камшаванда", ҳаддиАксариРавзана([9, 8, 7, 6, 5], 2), [9, 8, 7, 6]);
санҷ("такрорӣ", ҳаддиАксариРавзана([1, 3, 1, 2, 0, 5], 3), [3, 3, 2, 5]);
санҷ("манфӣ ва мусбат", ҳаддиАксариРавзана([-7, -8, 7, 5, 7, 1, 6, 0], 4), [7, 7, 7, 7, 7]);
санҷ("қиматҳои баробар", ҳаддиАксариРавзана([4, 4, 4, 4], 2), [4, 4, 4]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
