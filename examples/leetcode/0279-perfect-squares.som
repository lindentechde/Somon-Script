// 279. Квадратҳои комил (Perfect Squares)
// https://leetcode.com/problems/perfect-squares/
// Сатҳ: Миёна (Medium)
//
// Шарт: Адади бутуни n дода шудааст. Камтарин шумораи квадратҳои комилро
// (1, 4, 9, 16, ...) ёбед, ки ҷамъашон ба n баробар аст.
//
// Усул: Барномасозии динамикӣ — кам[и] = 1 + min(кам[и - ҷ²]) барои ҳамаи
// ҷ, ки ҷ² <= и. Квадратҳоро як бор пешакӣ ҳисоб мекунем.
// Мураккабӣ: вақт O(n·√n), хотира O(n).

функсия квадратҳоиКомил(н: рақам): рақам {
    собит квадратҳо: рақам[] = [];
    барои (тағ ҷ = 1; ҷ * ҷ <= н; ҷ++) {
        квадратҳо.илова(ҷ * ҷ);
    }
    собит кам: рақам[] = нав рӯйхат(н + 1).пурКардан(Infinity);
    кам[0] = 0;
    барои (тағ и = 1; и <= н; и++) {
        барои (собит квадрат аз квадратҳо) {
            агар (квадрат > и) {
                шикастан;
            }
            кам[и] = Риёзӣ.ҳаддиАқал(кам[и], кам[и - квадрат] + 1);
        }
    }
    бозгашт кам[н];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", квадратҳоиКомил(12), 3);
санҷ("мисол 2", квадратҳоиКомил(13), 2);
санҷ("як", квадратҳоиКомил(1), 1);
санҷ("ду", квадратҳоиКомил(2), 2);
санҷ("худаш квадрат", квадратҳоиКомил(4), 1);
санҷ("чор квадрат лозим (7)", квадратҳоиКомил(7), 4);
санҷ("43", квадратҳоиКомил(43), 3);
санҷ("ҳадди аксар (10000)", квадратҳоиКомил(10000), 1);
санҷ("9999", квадратҳоиКомил(9999), 4);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
