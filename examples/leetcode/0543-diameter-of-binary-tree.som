// 543. Диаметри дарахти дуӣ (Diameter of Binary Tree)
// https://leetcode.com/problems/diameter-of-binary-tree/
// Сатҳ: Осон (Easy)
//
// Шарт: Решаи дарахти дуӣ дода шудааст. Дарозии диаметри дарахтро
// баргардонед — шумораи қирраҳо дар роҳи дарозтарин байни ду гиреҳи
// дилхоҳ. Ин роҳ метавонад аз реша нагузарад.
//
// Усул: DFS: барои ҳар гиреҳ баландии зердарахтҳои чап ва ростро ҳисоб
// мекунем; роҳи дарозтарине, ки аз ин гиреҳ мегузарад, чап + рост қирра
// дорад. Ҳадди аксари ин қиматро дар тамоми дарахт нигоҳ медорем.
// Мураккабӣ: вақт O(n), хотира O(h) (h — баландии дарахт).

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

функсия диаметр(реша: ГиреҳиДарахт | холӣ): рақам {
    тағ беҳтарин = 0;
    // Баландии зердарахтро (бо шумораи гиреҳҳо) бармегардонад ва беҳтаринро нав мекунад
    функсия баландӣ(гиреҳ: ГиреҳиДарахт | холӣ): рақам {
        агар (гиреҳ === холӣ) {
            бозгашт 0;
        }
        собит чапӣ = баландӣ(гиреҳ.чап);
        собит ростӣ = баландӣ(гиреҳ.рост);
        беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, чапӣ + ростӣ);
        бозгашт 1 + Риёзӣ.ҳаддиАксар(чапӣ, ростӣ);
    }
    баландӣ(реша);
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", диаметр(сохтаниДарахт([1, 2, 3, 4, 5])), 3);
санҷ("мисол 2", диаметр(сохтаниДарахт([1, 2])), 1);
санҷ("як гиреҳ", диаметр(сохтаниДарахт([1])), 0);
санҷ("дарахти холӣ", диаметр(сохтаниДарахт([])), 0);
санҷ("занҷири 5 гиреҳ", диаметр(сохтаниДарахт([1, холӣ, 2, холӣ, 3, холӣ, 4, холӣ, 5])), 4);
санҷ(
    "роҳ аз реша намегузарад",
    диаметр(сохтаниДарахт([1, 2, холӣ, 3, 4, 5, холӣ, холӣ, 6, 7, холӣ, холӣ, 8])),
    6
);
санҷ(
    "қиматҳои манфӣ (санҷиши LeetCode)",
    диаметр(сохтаниДарахт([4, -7, -3, холӣ, холӣ, -9, -3, 9, -7, -4, холӣ, 6, холӣ, -6, -6, холӣ, холӣ, 0, 6, 5, холӣ, 9, холӣ, холӣ, -1, -4, холӣ, холӣ, холӣ, -2])),
    8
);

// Калон: дарахти пурраи 10 сатҳ (1023 гиреҳ) — диаметр 2 × 9 = 18
собит пурра: (рақам | холӣ)[] = [];
барои (тағ и = 1; и <= 1023; и++) {
    пурра.илова(и);
}
санҷ("дарахти пурраи 1023 гиреҳ", диаметр(сохтаниДарахт(пурра)), 18);

// Калон: ду занҷири 500-гиреҳа аз реша (чап ва рост) — диаметр 1000
собит реша = нав ГиреҳиДарахт(0);
тағ чапӣ = реша;
тағ ростӣ = реша;
барои (тағ и = 1; и <= 500; и++) {
    собит н1 = нав ГиреҳиДарахт(-и);
    чапӣ.чап = н1;
    чапӣ = н1;
    собит н2 = нав ГиреҳиДарахт(и);
    ростӣ.рост = н2;
    ростӣ = н2;
}
санҷ("ду занҷири 500 гиреҳ", диаметр(реша), 1000);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
