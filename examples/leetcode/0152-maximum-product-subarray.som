// 152. Зеррӯйхат бо ҳосили зарби калонтарин (Maximum Product Subarray)
// https://leetcode.com/problems/maximum-product-subarray/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳои бутун дода шудааст. Зеррӯйхати пайвастаи
// ғайрихолиеро ёбед, ки ҳосили зарби унсурҳояш калонтарин аст, ва ин
// ҳосилро баргардонед.
//
// Усул: Барномасозии динамикӣ — барои ҳар мавқеъ ҳам калонтарин ва ҳам
// хурдтарин ҳосили зарби зеррӯйхати ба он анҷомёбандаро нигоҳ медорем, зеро
// зарб бо адади манфӣ хурдтаринро ба калонтарин табдил медиҳад (ва баръакс).
// Мураккабӣ: вақт O(n), хотира O(1).

функсия ҳосилиЗарбиАксар(рақамҳо: рақам[]): рақам {
    тағ аксар: рақам = рақамҳо[0]; // калонтарин ҳосил, ки дар и анҷом меёбад
    тағ ақал: рақам = рақамҳо[0]; // хурдтарин ҳосил, ки дар и анҷом меёбад
    тағ натиҷа: рақам = рақамҳо[0];
    барои (тағ и = 1; и < рақамҳо.дарозӣ; и++) {
        собит х = рақамҳо[и];
        собит боАксар = аксар * х;
        собит боАқал = ақал * х;
        аксар = Риёзӣ.ҳаддиАксар(х, боАксар, боАқал);
        ақал = Риёзӣ.ҳаддиАқал(х, боАксар, боАқал);
        натиҷа = Риёзӣ.ҳаддиАксар(натиҷа, аксар);
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҳосилиЗарбиАксар([2, 3, -2, 4]), 6);
санҷ("мисол 2", ҳосилиЗарбиАксар([-2, 0, -1]), 0);
санҷ("як унсури манфӣ", ҳосилиЗарбиАксар([-2]), -2);
санҷ("ду манфӣ", ҳосилиЗарбиАксар([-2, 3, -4]), 24);
санҷ("сифр дар аввал", ҳосилиЗарбиАксар([0, 2]), 2);
санҷ("се манфӣ ва сифр", ҳосилиЗарбиАксар([-1, -2, -3, 0]), 6);
санҷ("омехта", ҳосилиЗарбиАксар([2, -5, -2, -4, 3]), 24);
санҷ("сифрҳо ва манфӣ", ҳосилиЗарбиАксар([0, -3, 0]), 0);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
