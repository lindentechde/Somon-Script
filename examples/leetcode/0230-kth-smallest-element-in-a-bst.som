// 230. K-умин хурдтарин унсур дар дарахти ҷустуҷӯии дуӣ (Kth Smallest Element in a BST)
// https://leetcode.com/problems/kth-smallest-element-in-a-bst/
// Сатҳ: Миёна (Medium)
//
// Шарт: Решаи дарахти ҷустуҷӯии дуӣ (BST) ва адади k дода шудааст. K-умин
// хурдтарин қиматро (бо шумориш аз 1) дар байни ҳамаи қиматҳои гиреҳҳо баргардонед.
//
// Усул: Гузариши мобайнии (inorder) итеративӣ бо стек — дар BST он қиматҳоро
// бо тартиби афзоиш медиҳад; ҳангоми расидан ба k-умин гиреҳ қатъ мекунем.
// Мураккабӣ: вақт O(h + k), хотира O(h), ки h баландии дарахт аст.

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

функсия кумХурдтарин(реша: ГиреҳиДарахт | холӣ, к: рақам): рақам {
    собит стек: ГиреҳиДарахт[] = [];
    тағ ҷорӣ = реша;
    тағ боқӣ = к;
    то (ҷорӣ !== холӣ || стек.дарозӣ > 0) {
        то (ҷорӣ !== холӣ) {
            стек.илова(ҷорӣ);
            ҷорӣ = ҷорӣ.чап;
        }
        собит гиреҳ = стек.баровардан();
        агар (гиреҳ === беқимат) {
            шикастан;
        }
        боқӣ--;
        агар (боқӣ === 0) {
            бозгашт гиреҳ.қимат;
        }
        ҷорӣ = гиреҳ.рост;
    }
    бозгашт -1;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", кумХурдтарин(сохтаниДарахт([3, 1, 4, холӣ, 2]), 1), 1);
санҷ("мисол 2", кумХурдтарин(сохтаниДарахт([5, 3, 6, 2, 4, холӣ, холӣ, 1]), 3), 3);
санҷ("як гиреҳ", кумХурдтарин(сохтаниДарахт([1]), 1), 1);
санҷ("калонтарин (k = n)", кумХурдтарин(сохтаниДарахт([5, 3, 6, 2, 4, холӣ, холӣ, 1]), 6), 6);
санҷ("танҳо рост", кумХурдтарин(сохтаниДарахт([1, холӣ, 2, холӣ, 3]), 2), 2);
санҷ("қиматҳои манфӣ", кумХурдтарин(сохтаниДарахт([0, -5, 5, -8, -2]), 2), -5);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
