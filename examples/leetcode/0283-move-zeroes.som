// 283. Кӯчонидани сифрҳо (Move Zeroes)
// https://leetcode.com/problems/move-zeroes/
// Сатҳ: Осон (Easy)
//
// Шарт: Ҳамаи сифрҳои рӯйхатро ба охир кӯчонед, тартиби нисбии унсурҳои
// ғайрисифриро нигоҳ доред. Тағйирот бояд дар ҷои худ (in-place), бе
// нусхабардории рӯйхат иҷро шавад.
//
// Усул: Ду нишондиҳанда — "навис" ҷои навбатии унсури ғайрисифриро нишон
// медиҳад. Ҳангоми дидани унсури ғайрисифрӣ онро бо ҷойи "навис" иваз
// мекунем; ҳамин тавр сифрҳо худ ба худ ба охир мегузаранд.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия кӯчониданиСифрҳо(рақамҳо: рақам[]): беджавоб {
    тағ навис = 0;
    барои (тағ и = 0; и < рақамҳо.дарозӣ; и++) {
        агар (рақамҳо[и] !== 0) {
            агар (и !== навис) {
                собит муваққат = рақамҳо[навис];
                рақамҳо[навис] = рақамҳо[и];
                рақамҳо[и] = муваққат;
            }
            навис++;
        }
    }
}

// Ёрирасон: рӯйхатро дар ҷояш тағйир медиҳад ва ҳамон рӯйхатро бармегардонад.
функсия кӯчондаШуда(рақамҳо: рақам[]): рақам[] {
    кӯчониданиСифрҳо(рақамҳо);
    бозгашт рақамҳо;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", кӯчондаШуда([0, 1, 0, 3, 12]), [1, 3, 12, 0, 0]);
санҷ("мисол 2", кӯчондаШуда([0]), [0]);
санҷ("рӯйхати холӣ", кӯчондаШуда([]), []);
санҷ("бе сифр", кӯчондаШуда([1, 2, 3]), [1, 2, 3]);
санҷ("ҳама сифр", кӯчондаШуда([0, 0, 0]), [0, 0, 0]);
санҷ("рақамҳои манфӣ", кӯчондаШуда([-1, 0, -2, 0, 0, 3]), [-1, -2, 3, 0, 0, 0]);

// Санҷиши он ки тағйирот дар ҳамон рӯйхат (in-place) рух медиҳад.
собит асл: рақам[] = [0, 0, 1, 0, 2];
кӯчониданиСифрҳо(асл);
санҷ("дар ҷои худ", асл, [1, 2, 0, 0, 0]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
