// 98. Санҷиши дарахти ҷустуҷӯии дуӣ (Validate Binary Search Tree)
// https://leetcode.com/problems/validate-binary-search-tree/
// Сатҳ: Миёна (Medium)
//
// Шарт: Муайян кунед, ки оё дарахти дуӣ дарахти ҷустуҷӯии дуии дуруст (BST)
// аст: ҳамаи қиматҳои зердарахти чап аз реша қатъиян хурд, ҳамаи қиматҳои
// зердарахти рост қатъиян калон ва ҳарду зердарахт низ BST мебошанд.
//
// Усул: Ҷустуҷӯ дар умқ (DFS) бо ҳудуд — ҳар гиреҳ бояд дар бозаи кушодаи
// (ҳадиПоён, ҳадиБоло) бошад; ба чап ҳадди болоӣ ва ба рост ҳадди поёнӣ танг мешавад.
// Мураккабӣ: вақт O(n), хотира O(h), ки h баландии дарахт аст.

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

функсия дарахтиҶустуҷӯӣАст(реша: ГиреҳиДарахт | холӣ): мантиқӣ {
    функсия дарБоза(гиреҳ: ГиреҳиДарахт | холӣ, ҳадиПоён: рақам, ҳадиБоло: рақам): мантиқӣ {
        агар (гиреҳ === холӣ) {
            бозгашт дуруст;
        }
        агар (гиреҳ.қимат <= ҳадиПоён || гиреҳ.қимат >= ҳадиБоло) {
            бозгашт нодуруст;
        }
        бозгашт дарБоза(гиреҳ.чап, ҳадиПоён, гиреҳ.қимат) &&
            дарБоза(гиреҳ.рост, гиреҳ.қимат, ҳадиБоло);
    }
    бозгашт дарБоза(реша, -Infinity, Infinity);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дарахтиҶустуҷӯӣАст(сохтаниДарахт([2, 1, 3])), дуруст);
санҷ("мисол 2", дарахтиҶустуҷӯӣАст(сохтаниДарахт([5, 1, 4, холӣ, холӣ, 3, 6])), нодуруст);
санҷ("як гиреҳ", дарахтиҶустуҷӯӣАст(сохтаниДарахт([1])), дуруст);
санҷ("қиматҳои такрорӣ", дарахтиҶустуҷӯӣАст(сохтаниДарахт([2, 2, 2])), нодуруст);
санҷ("вайронкунӣ дар набера", дарахтиҶустуҷӯӣАст(сохтаниДарахт([5, 4, 6, холӣ, холӣ, 3, 7])), нодуруст);
санҷ("ҳудуди 32-битӣ", дарахтиҶустуҷӯӣАст(сохтаниДарахт([-2147483648, холӣ, 2147483647])), дуруст);
санҷ("BST-и калонтар", дарахтиҶустуҷӯӣАст(сохтаниДарахт([8, 4, 12, 2, 6, 10, 14, 1, 3, 5, 7])), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
