// 207. Ҷадвали курсҳо (Course Schedule)
// https://leetcode.com/problems/course-schedule/
// Сатҳ: Миёна (Medium)
//
// Шарт: numCourses курс аз 0 то numCourses - 1 рақамгузорӣ шудаанд. Ҳар ҷуфти
// [a, b] дар prerequisites маънои онро дорад, ки пеш аз курси a бояд курси b
// гузашта шавад. Оё ҳамаи курсҳоро тамом кардан мумкин аст?
//
// Усул: Тартиби топологӣ бо алгоритми Кан (Kahn): дараҷаи вурудии ҳар қуллаи
// графро ҳисоб мекунем, курсҳои бе шарти пешакиро ба навбат мегузорем ва
// пай дар пай "мегузарем". Агар ҳамаи курсҳо гузашта шаванд — давра нест.
// Мураккабӣ: вақт O(V + E), хотира O(V + E).

функсия метавонТамомКард(шумораиКурсҳо: рақам, шартҳо: рақам[][]): мантиқӣ {
    собит ҳамсояҳо: рақам[][] = рӯйхат.аз({ length: шумораиКурсҳо }, (): рақам[] => []);
    собит дараҷаиВурудӣ: рақам[] = нав рӯйхат<рақам>(шумораиКурсҳо).пурКардан(0);
    барои (собит ҷуфт аз шартҳо) {
        собит [курс, пешакӣ] = ҷуфт;
        ҳамсояҳо[пешакӣ].илова(курс);
        дараҷаиВурудӣ[курс]++;
    }

    собит навбат: рақам[] = [];
    барои (тағ к = 0; к < шумораиКурсҳо; к++) {
        агар (дараҷаиВурудӣ[к] === 0) {
            навбат.илова(к);
        }
    }

    тағ сар = 0;
    то (сар < навбат.дарозӣ) {
        собит ҷорӣ = навбат[сар];
        сар++;
        барои (собит баъдӣ аз ҳамсояҳо[ҷорӣ]) {
            дараҷаиВурудӣ[баъдӣ]--;
            агар (дараҷаиВурудӣ[баъдӣ] === 0) {
                навбат.илова(баъдӣ);
            }
        }
    }
    // Ҳар курсе, ки ба навбат даромад, гузашта шуд
    бозгашт навбат.дарозӣ === шумораиКурсҳо;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", метавонТамомКард(2, [[1, 0]]), дуруст);
санҷ("мисол 2", метавонТамомКард(2, [[1, 0], [0, 1]]), нодуруст);
санҷ("як курс, бе шарт", метавонТамомКард(1, []), дуруст);
санҷ("курс ба худаш вобаста", метавонТамомКард(1, [[0, 0]]), нодуруст);
санҷ("бе шартҳо", метавонТамомКард(5, []), дуруст);
санҷ("алмос (diamond)", метавонТамомКард(4, [[1, 0], [2, 0], [3, 1], [3, 2]]), дуруст);
санҷ("давраи се курс", метавонТамомКард(4, [[1, 0], [2, 1], [3, 2], [1, 3]]), нодуруст);
санҷ("шарти такрорӣ", метавонТамомКард(3, [[1, 0], [1, 0], [2, 1]]), дуруст);
санҷ("ду ҷузъи алоҳида, яке бо давра", метавонТамомКард(5, [[1, 0], [3, 2], [4, 3], [2, 4]]), нодуруст);

// Занҷири дароз: 0 → 1 → 2 → … → 1999
собит занҷир: рақам[][] = [];
барои (тағ и = 1; и < 2000; и++) {
    занҷир.илова([и, и - 1]);
}
санҷ("занҷири 2000 курс", метавонТамомКард(2000, занҷир), дуруст);
занҷир.илова([0, 1999]);
санҷ("занҷири 2000 курс бо давра", метавонТамомКард(2000, занҷир), нодуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
