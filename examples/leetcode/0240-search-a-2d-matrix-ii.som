// 240. Ҷустуҷӯ дар матритсаи дученака II (Search a 2D Matrix II)
// https://leetcode.com/problems/search-a-2d-matrix-ii/
// Сатҳ: Миёна (Medium)
//
// Шарт: Матритсаи m x n дода шудааст, ки дар ҳар сатр рақамҳо аз чап ба рост
// ва дар ҳар сутун аз боло ба поён афзоиш меёбанд. Муайян кунед, ки оё
// рақами ҳадаф дар матритса ҳаст.
//
// Усул: "Зинапоя" — аз кунҷи болоии рост сар мекунем. Агар қимати ҷорӣ аз
// ҳадаф калон бошад, тамоми сутунаш калон аст — ба чап меравем; агар хурд
// бошад, тамоми сатраш хурд аст — ба поён меравем.
// Мураккабӣ: вақт O(m + n), хотира O(1).

функсия матритсаДорад(матритса: рақам[][], ҳадаф: рақам): мантиқӣ {
    агар (матритса.дарозӣ === 0 || матритса[0].дарозӣ === 0) {
        бозгашт нодуруст;
    }
    тағ қатор = 0;
    тағ сутун = матритса[0].дарозӣ - 1;
    то (қатор < матритса.дарозӣ && сутун >= 0) {
        собит қимат = матритса[қатор][сутун];
        агар (қимат === ҳадаф) {
            бозгашт дуруст;
        }
        агар (қимат > ҳадаф) {
            сутун--;
        } вагарна {
            қатор++;
        }
    }
    бозгашт нодуруст;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

собит мисол: рақам[][] = [
    [1, 4, 7, 11, 15],
    [2, 5, 8, 12, 19],
    [3, 6, 9, 16, 22],
    [10, 13, 14, 17, 24],
    [18, 21, 23, 26, 30]
];

санҷ("мисол 1", матритсаДорад(мисол, 5), дуруст);
санҷ("мисол 2", матритсаДорад(мисол, 20), нодуруст);
санҷ("як унсур — ҳаст", матритсаДорад([[-5]], -5), дуруст);
санҷ("як унсур — нест", матритсаДорад([[-5]], 3), нодуруст);
санҷ("як сатр", матритсаДорад([[1, 3, 5, 7, 9]], 7), дуруст);
санҷ("як сутун", матритсаДорад([[1], [3], [5]], 4), нодуруст);
санҷ("кунҷи поёни чап", матритсаДорад(мисол, 18), дуруст);
санҷ("аз ҳама хурдтар", матритсаДорад(мисол, 0), нодуруст);
санҷ("аз ҳама калонтар", матритсаДорад(мисол, 31), нодуруст);
санҷ("рақамҳои манфӣ", матритсаДорад([[-10, -5, 0], [-8, -2, 4], [-1, 3, 9]], -2), дуруст);

// Матритсаи калон: м[и][ҷ] = 2 * (и + ҷ) — танҳо рақамҳои ҷуфт ҳастанд
собит калон: рақам[][] = рӯйхат.аз({ length: 300 }, (_: ҳар, и: рақам) =>
    рӯйхат.аз({ length: 300 }, (__: ҳар, ҷ: рақам) => 2 * (и + ҷ)));
санҷ("матритсаи калон — ҳаст", матритсаДорад(калон, 598), дуруст);
санҷ("матритсаи калон — нест", матритсаДорад(калон, 599), нодуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
