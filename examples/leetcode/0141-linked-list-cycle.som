// 141. Давр дар рӯйхати пайваст (Linked List Cycle)
// https://leetcode.com/problems/linked-list-cycle/
// Сатҳ: Осон (Easy)
//
// Шарт: Сари рӯйхати пайваст дода шудааст. Муайян кунед, ки оё дар рӯйхат
// давр (гиреҳе, ки ба яке аз гиреҳҳои пештара ишора мекунад) ҳаст.
//
// Усул: Алгоритми Флойд ("сангпушт ва харгӯш") — ишорагари суст як қадам,
// тез ду қадам меравад. Агар давр бошад, онҳо ҳатман вомехӯранд; агар не,
// тез ба охири рӯйхат (холӣ) мерасад.
// Мураккабӣ: вақт O(n), хотира O(1).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

функсия даврДорад(сар: ГиреҳиРӯйхат | холӣ): мантиқӣ {
    тағ суст = сар;
    тағ тез = сар;
    то (суст !== холӣ && тез !== холӣ && тез.навбатӣ !== холӣ) {
        суст = суст.навбатӣ;
        тез = тез.навбатӣ.навбатӣ;
        агар (суст === тез) {
            бозгашт дуруст;
        }
    }
    бозгашт нодуруст;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Рӯйхат месозад ва думашро ба гиреҳи индекси `мавқеъ` мепайвандад
// (мавқеъ = -1 — давр нест), мисли вуруди LeetCode.
функсия рӯйхатиДаврӣ(рақамҳо: рақам[], мавқеъ: рақам): ГиреҳиРӯйхат | холӣ {
    собит сар = рӯйхатиПайваст(рақамҳо);
    тағ дум = сар;
    тағ даромадгоҳ: ГиреҳиРӯйхат | холӣ = холӣ;
    тағ и = 0;
    то (дум !== холӣ) {
        агар (и === мавқеъ) {
            даромадгоҳ = дум;
        }
        агар (дум.навбатӣ === холӣ) {
            дум.навбатӣ = даромадгоҳ;
            шикастан;
        }
        дум = дум.навбатӣ;
        и++;
    }
    бозгашт сар;
}

санҷ("мисол 1", даврДорад(рӯйхатиДаврӣ([3, 2, 0, -4], 1)), дуруст);
санҷ("мисол 2", даврДорад(рӯйхатиДаврӣ([1, 2], 0)), дуруст);
санҷ("мисол 3", даврДорад(рӯйхатиДаврӣ([1], -1)), нодуруст);
санҷ("рӯйхати холӣ", даврДорад(рӯйхатиДаврӣ([], -1)), нодуруст);
санҷ("як гиреҳ ба худаш", даврДорад(рӯйхатиДаврӣ([1], 0)), дуруст);
санҷ("дум ба худаш", даврДорад(рӯйхатиДаврӣ([1, 2, 3, 4, 5], 4)), дуруст);
санҷ("ду гиреҳ бе давр", даврДорад(рӯйхатиДаврӣ([1, 2], -1)), нодуруст);

собит дароз = рӯйхат.аз({ length: 10000 }, (_: ҳар, и: рақам) => и);
санҷ("рӯйхати дароз бе давр", даврДорад(рӯйхатиДаврӣ(дароз, -1)), нодуруст);
санҷ("рӯйхати дароз бо давр", даврДорад(рӯйхатиДаврӣ(дароз, 5000)), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
