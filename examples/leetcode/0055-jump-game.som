// 55. Бозии ҷаҳиш (Jump Game)
// https://leetcode.com/problems/jump-game/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳо дода шудааст; аз индекси 0 сар мекунем ва ҳар унсур
// дарозии ҳадди аксари ҷаҳишро аз он мавқеъ нишон медиҳад. Муайян кунед, ки оё
// ба индекси охирин расидан мумкин аст.
//
// Усул: Ҳарисона (greedy) — дуртарин индекси дастрасро нигоҳ медорем. Агар
// индекси ҷорӣ аз он гузарад, ба он ҷо расида наметавонем; агар дуртарин ба
// охир расад, ҷавоб "ҳа" аст.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия ҷаҳидаМетавонад(рақамҳо: рақам[]): мантиқӣ {
    тағ дуртарин = 0;
    барои (тағ и = 0; и < рақамҳо.дарозӣ; и++) {
        агар (и > дуртарин) {
            бозгашт нодуруст;
        }
        дуртарин = Риёзӣ.ҳаддиАксар(дуртарин, и + рақамҳо[и]);
        агар (дуртарин >= рақамҳо.дарозӣ - 1) {
            бозгашт дуруст;
        }
    }
    бозгашт дуруст;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷаҳидаМетавонад([2, 3, 1, 1, 4]), дуруст);
санҷ("мисол 2", ҷаҳидаМетавонад([3, 2, 1, 0, 4]), нодуруст);
санҷ("як унсур", ҷаҳидаМетавонад([0]), дуруст);
санҷ("сифр дар аввал", ҷаҳидаМетавонад([0, 1]), нодуруст);
санҷ("сифр дар мобайн", ҷаҳидаМетавонад([1, 0, 1]), нодуруст);
санҷ("сифрҳо дар охир", ҷаҳидаМетавонад([2, 0, 0]), дуруст);
собит якҳо: рақам[] = нав рӯйхат(10000).пурКардан(1);
санҷ("10000 яка", ҷаҳидаМетавонад(якҳо), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
