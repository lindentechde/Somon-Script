// 74. Ҷустуҷӯ дар матритсаи дученака (Search a 2D Matrix)
// https://leetcode.com/problems/search-a-2d-matrix/
// Сатҳ: Миёна (Medium)
//
// Шарт: Матритсаи m×n дода шудааст: ҳар сатр аз чап ба рост мураттаб аст ва
// аввалин рақами ҳар сатр аз охирин рақами сатри пешина калонтар аст.
// Муайян кунед, ки ҳадаф дар матритса ҳаст ё не.
//
// Усул: Матритсаро ҳамчун як рӯйхати мураттаби дарозиаш m·n мебинем ва
// ҷустуҷӯи дуӣ мекунем: индекси к ба унсури [к / n][к % n] мувофиқ аст.
// Мураккабӣ: вақт O(log(m·n)), хотира O(1).

функсия ҷустуҷӯиМатритса(матритса: рақам[][], ҳадаф: рақам): мантиқӣ {
    собит м = матритса.дарозӣ;
    агар (м === 0) {
        бозгашт нодуруст;
    }
    собит н = матритса[0].дарозӣ;
    тағ чап = 0;
    тағ рост = м * н - 1;
    то (чап <= рост) {
        собит миёна = чап + Риёзӣ.поён((рост - чап) / 2);
        собит қимат = матритса[Риёзӣ.поён(миёна / н)][миёна % н];
        агар (қимат === ҳадаф) {
            бозгашт дуруст;
        }
        агар (қимат < ҳадаф) {
            чап = миёна + 1;
        } вагарна {
            рост = миёна - 1;
        }
    }
    бозгашт нодуруст;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

собит мисол: рақам[][] = [
    [1, 3, 5, 7],
    [10, 11, 16, 20],
    [23, 30, 34, 60],
];
санҷ("мисол 1", ҷустуҷӯиМатритса(мисол, 3), дуруст);
санҷ("мисол 2", ҷустуҷӯиМатритса(мисол, 13), нодуруст);
санҷ("унсури аввал", ҷустуҷӯиМатритса(мисол, 1), дуруст);
санҷ("унсури охир", ҷустуҷӯиМатритса(мисол, 60), дуруст);
санҷ("аз ҳама хурдтар", ҷустуҷӯиМатритса(мисол, 0), нодуруст);
санҷ("аз ҳама калонтар", ҷустуҷӯиМатритса(мисол, 61), нодуруст);
санҷ("як унсур, ҳаст", ҷустуҷӯиМатритса([[5]], 5), дуруст);
санҷ("як унсур, нест", ҷустуҷӯиМатритса([[5]], -5), нодуруст);
санҷ("як сутун", ҷустуҷӯиМатритса([[-4], [-2], [0], [9]], -2), дуруст);
санҷ("як сатр", ҷустуҷӯиМатритса([[-4, -2, 0, 9]], 8), нодуруст);
санҷ("матритсаи холӣ", ҷустуҷӯиМатритса([], 1), нодуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
