// 42. Ҷамъ шудани оби борон (Trapping Rain Water)
// https://leetcode.com/problems/trapping-rain-water/
// Сатҳ: Душвор (Hard)
//
// Шарт: n адади ғайриманфӣ харитаи баландиҳоро тасвир мекунанд (паҳнои ҳар
// сутун 1). Ҳисоб кунед, ки пас аз борон чӣ қадар об дар байни сутунҳо
// ҷамъ мешавад.
//
// Усул: Ду нишондиҳанда аз ду канор бо баландии ҳадди аксари чап ва рост.
// Тарафе, ки ҳадди аксараш пасттар аст, сатҳи обро муайян мекунад: дар он
// тараф об = ҳаддиАксар - баландӣ. Ҳамон тарафро ба дарун мекӯчонем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия обиҶамъшуда(баландӣ: рақам[]): рақам {
    тағ чап = 0;
    тағ рост = баландӣ.дарозӣ - 1;
    тағ аксариЧап = 0;
    тағ аксариРост = 0;
    тағ об = 0;
    то (чап < рост) {
        агар (баландӣ[чап] < баландӣ[рост]) {
            агар (баландӣ[чап] >= аксариЧап) {
                аксариЧап = баландӣ[чап];
            } вагарна {
                об += аксариЧап - баландӣ[чап];
            }
            чап++;
        } вагарна {
            агар (баландӣ[рост] >= аксариРост) {
                аксариРост = баландӣ[рост];
            } вагарна {
                об += аксариРост - баландӣ[рост];
            }
            рост--;
        }
    }
    бозгашт об;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", обиҶамъшуда([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]), 6);
санҷ("мисол 2", обиҶамъшуда([4, 2, 0, 3, 2, 5]), 9);
санҷ("рӯйхати холӣ", обиҶамъшуда([]), 0);
санҷ("як сутун", обиҶамъшуда([5]), 0);
санҷ("афзоянда", обиҶамъшуда([1, 2, 3, 4]), 0);
санҷ("як чуқурӣ", обиҶамъшуда([5, 0, 5]), 5);
санҷ("чуқуриҳои гуногун", обиҶамъшуда([3, 0, 0, 2, 0, 4]), 10);

// Вуруди калон: ду девори баланд ва 10000 сутуни сифр дар мобайн.
собит калон: рақам[] = нав рӯйхат(10002).пурКардан(0);
калон[0] = 7;
калон[10001] = 9;
санҷ("вуруди калон", обиҶамъшуда(калон), 70000);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
