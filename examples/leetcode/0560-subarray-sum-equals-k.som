// 560. Зеррӯйхатҳо бо ҷамъи баробари k (Subarray Sum Equals K)
// https://leetcode.com/problems/subarray-sum-equals-k/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳо ва адади k дода шудааст. Шумораи зеррӯйхатҳои
// пайвастаро (subarray) ёбед, ки ҷамъи унсурҳояшон ба k баробар аст.
//
// Усул: Ҷамъҳои префиксӣ (prefix sums) ва хеш-ҷадвал. Агар ҷамъи префиксӣ
// то индекси ҷорӣ "ҷамъ" бошад, пас ҳар префикси пештараи бо қимати
// "ҷамъ - k" як зеррӯйхати мувофиқро медиҳад. Дар Map шумораи ҳар ҷамъи
// префиксии дидашударо нигоҳ медорем.
// Мураккабӣ: вақт O(n), хотира O(n).

функсия шумораиЗерРӯйхатҳо(рақамҳо: рақам[], к: рақам): рақам {
    собит басомад = нав Map<рақам, рақам>();
    басомад.гузоштан(0, 1); // префикси холӣ
    тағ ҷамъ = 0;
    тағ шумора = 0;
    барои (собит р аз рақамҳо) {
        ҷамъ += р;
        шумора += басомад.бозгирифтан(ҷамъ - к) ?? 0;
        басомад.гузоштан(ҷамъ, (басомад.бозгирифтан(ҷамъ) ?? 0) + 1);
    }
    бозгашт шумора;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", шумораиЗерРӯйхатҳо([1, 1, 1], 2), 2);
санҷ("мисол 2", шумораиЗерРӯйхатҳо([1, 2, 3], 3), 2);
санҷ("як унсур, мувофиқ", шумораиЗерРӯйхатҳо([5], 5), 1);
санҷ("як унсур, номувофиқ", шумораиЗерРӯйхатҳо([5], 3), 0);
санҷ("рақамҳои манфӣ", шумораиЗерРӯйхатҳо([1, -1, 0], 0), 3);
санҷ("ҳама сифр", шумораиЗерРӯйхатҳо([0, 0, 0, 0], 0), 10);
санҷ("омехта", шумораиЗерРӯйхатҳо([3, 4, 7, 2, -3, 1, 4, 2], 7), 4);
санҷ("k манфӣ", шумораиЗерРӯйхатҳо([-1, -1, 1], -2), 1);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
