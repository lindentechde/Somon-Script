// 101. Дарахти симметрӣ (Symmetric Tree)
// https://leetcode.com/problems/symmetric-tree/
// Сатҳ: Осон (Easy)
//
// Шарт: Решаи дарахти дуӣ дода шудааст. Санҷед, ки оё дарахт инъикоси
// оинавии худ аст (нисбат ба маркази худ симметрӣ аст).
//
// Усул: Ду зердарахт инъикоси ҳамдигаранд, агар решаҳояшон баробар бошанд,
// чапи якум инъикоси рости дуюм ва рости якум инъикоси чапи дуюм бошад.
// Варианти рекурсивӣ ва варианти такрорӣ бо навбати ҷуфтҳо.
// Мураккабӣ: вақт O(n), хотира O(h) барои рекурсия, O(n) барои навбат.

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

// Оё ду зердарахт инъикоси оинавии ҳамдигаранд?
функсия инъикосАст(а: ГиреҳиДарахт | холӣ, б: ГиреҳиДарахт | холӣ): мантиқӣ {
    агар (а === холӣ && б === холӣ) {
        бозгашт дуруст;
    }
    агар (а === холӣ || б === холӣ) {
        бозгашт нодуруст;
    }
    бозгашт а.қимат === б.қимат && инъикосАст(а.чап, б.рост) && инъикосАст(а.рост, б.чап);
}

// Варианти рекурсивӣ
функсия симметрӣАст(реша: ГиреҳиДарахт | холӣ): мантиқӣ {
    бозгашт реша === холӣ || инъикосАст(реша.чап, реша.рост);
}

// Варианти такрорӣ: ҷуфтҳои гиреҳҳоро, ки бояд инъикос бошанд, дар навбат нигоҳ медорем
функсия симметрӣАстТакрорӣ(реша: ГиреҳиДарахт | холӣ): мантиқӣ {
    агар (реша === холӣ) {
        бозгашт дуруст;
    }
    собит навбат: (ГиреҳиДарахт | холӣ)[] = [реша.чап, реша.рост];
    барои (тағ и = 0; и + 1 < навбат.дарозӣ; и += 2) {
        собит а = навбат[и];
        собит б = навбат[и + 1];
        агар (а === холӣ && б === холӣ) {
            давом;
        }
        агар (а === холӣ || б === холӣ || а.қимат !== б.қимат) {
            бозгашт нодуруст;
        }
        навбат.илова(а.чап, б.рост, а.рост, б.чап);
    }
    бозгашт дуруст;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Ҳар ду вариантро месанҷад
функсия санҷиДарахт(ном: сатр, қиматҳо: (рақам | холӣ)[], интизорӣ: мантиқӣ): беджавоб {
    собит реша = сохтаниДарахт(қиматҳо);
    санҷ(ном, симметрӣАст(реша), интизорӣ);
    санҷ(ном + " (такрорӣ)", симметрӣАстТакрорӣ(реша), интизорӣ);
}

санҷиДарахт("мисол 1", [1, 2, 2, 3, 4, 4, 3], дуруст);
санҷиДарахт("мисол 2", [1, 2, 2, холӣ, 3, холӣ, 3], нодуруст);
санҷиДарахт("як гиреҳ", [1], дуруст);
санҷиДарахт("дарахти холӣ", [], дуруст);
санҷиДарахт("сохтор номутаносиб", [1, 2, 2, 2, холӣ, 2], нодуруст);
санҷиДарахт("қиматҳо фарқ мекунанд", [1, 2, 3], нодуруст);
санҷиДарахт("танҳо канораҳо", [1, 2, 2, 3, холӣ, холӣ, 3], дуруст);
санҷиДарахт("манфӣ, дохилӣ", [1, -2, -2, холӣ, 4, 4, холӣ], дуруст);
санҷиДарахт("чуқур, симметрӣ", [1, 2, 2, холӣ, 3, 3, холӣ, 4, холӣ, холӣ, 4], дуруст);

// Калон: дарахти пурраи 10 сатҳ, ки қиматаш танҳо аз сатҳ вобаста аст — симметрӣ
собит пурра: (рақам | холӣ)[] = [];
барои (тағ сатҳ = 0; сатҳ < 10; сатҳ++) {
    барои (тағ к = 0; к < 2 ** сатҳ; к++) {
        пурра.илова(сатҳ);
    }
}
санҷиДарахт("дарахти пурраи 1023 гиреҳ", пурра, дуруст);
// Як барги охиринро иваз мекунем — дигар симметрӣ нест
собит вайрон = пурра.буридан();
вайрон[вайрон.дарозӣ - 1] = -1;
санҷиДарахт("дарахти пурра бо як барги иваз", вайрон, нодуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
