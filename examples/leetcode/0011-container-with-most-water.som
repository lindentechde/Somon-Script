// 11. Зарф бо бештарин об (Container With Most Water)
// https://leetcode.com/problems/container-with-most-water/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати баландиҳо дода шудааст; хати амудии и-ум аз (и, 0) то
// (и, баландӣ[и]) мекашад. Ду хатеро ёбед, ки бо меҳвари х зарфе месозанд,
// ки бештарин обро дар бар мегирад. Ҳаҷми ҳадди аксарро баргардонед.
//
// Усул: Ду нишондиҳанда аз ду канор. Масоҳат = (рост - чап) · ҳадди ақали
// баландиҳо. Ҳар дафъа хати пасттарро ба дарун мекӯчонем, зеро хати
// баландтарро кӯчонидан масоҳатро ҳеҷ гоҳ зиёд намекунад.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия бештаринОб(баландӣ: рақам[]): рақам {
    тағ чап = 0;
    тағ рост = баландӣ.дарозӣ - 1;
    тағ беҳтарин = 0;
    то (чап < рост) {
        собит паст = Риёзӣ.ҳаддиАқал(баландӣ[чап], баландӣ[рост]);
        беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, паст * (рост - чап));
        агар (баландӣ[чап] < баландӣ[рост]) {
            чап++;
        } вагарна {
            рост--;
        }
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", бештаринОб([1, 8, 6, 2, 5, 4, 8, 3, 7]), 49);
санҷ("мисол 2", бештаринОб([1, 1]), 1);
санҷ("баландиҳои сифр", бештаринОб([0, 0]), 0);
санҷ("ду сутуни баланд дар мобайн", бештаринОб([2, 3, 4, 5, 18, 17, 6]), 17);
санҷ("афзоянда", бештаринОб([1, 2, 4, 3]), 4);
санҷ("ду хати баланд дар канорҳо", бештаринОб([10, 1, 1, 1, 10]), 40);

// Вуруди калон: 1000 сутуни баробар бо баландии 10000.
собит баробар: рақам[] = нав рӯйхат(1000).пурКардан(10000);
санҷ("вуруди калон", бештаринОб(баробар), 10000 * 999);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
