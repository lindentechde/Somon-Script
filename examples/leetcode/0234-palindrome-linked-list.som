// 234. Рӯйхати пайвасти палиндромӣ (Palindrome Linked List)
// https://leetcode.com/problems/palindrome-linked-list/
// Сатҳ: Осон (Easy)
//
// Шарт: Сари рӯйхати яксӯяи пайваст дода шудааст. Агар рӯйхат палиндром бошад
// (аз пеш ва аз қафо якхела хонда шавад), дуруст баргардонед.
//
// Усул: Ишорагарҳои суст ва тез миёнаи рӯйхатро меёбанд. Нимаи дуюмро дар
// ҷояш баръакс карда, бо нимаи аввал муқоиса мекунем ва баъд рӯйхатро ба
// ҳолати аввалааш бармегардонем.
// Мураккабӣ: вақт O(n), хотира O(1).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

функсия баргардониРӯйхат(сар: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    тағ пешина: ГиреҳиРӯйхат | холӣ = холӣ;
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        собит баъдӣ = ҷорӣ.навбатӣ;
        ҷорӣ.навбатӣ = пешина;
        пешина = ҷорӣ;
        ҷорӣ = баъдӣ;
    }
    бозгашт пешина;
}

функсия палиндромАст(сар: ГиреҳиРӯйхат | холӣ): мантиқӣ {
    // 1. Миёна: вақте ки тез ба охир мерасад, суст дар сари нимаи дуюм аст
    тағ суст = сар;
    тағ тез = сар;
    то (суст !== холӣ && тез !== холӣ && тез.навбатӣ !== холӣ) {
        суст = суст.навбатӣ;
        тез = тез.навбатӣ.навбатӣ;
    }

    // 2. Нимаи дуюмро баръакс карда, бо нимаи аввал муқоиса мекунем
    собит сариДуюм = баргардониРӯйхат(суст);
    тағ аввал = сар;
    тағ дуюм = сариДуюм;
    тағ натиҷа = дуруст;
    то (аввал !== холӣ && дуюм !== холӣ) {
        агар (аввал.қимат !== дуюм.қимат) {
            натиҷа = нодуруст;
            шикастан;
        }
        аввал = аввал.навбатӣ;
        дуюм = дуюм.навбатӣ;
    }

    // 3. Рӯйхатро барқарор мекунем
    баргардониРӯйхат(сариДуюм);
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", палиндромАст(рӯйхатиПайваст([1, 2, 2, 1])), дуруст);
санҷ("мисол 2", палиндромАст(рӯйхатиПайваст([1, 2])), нодуруст);
санҷ("як гиреҳ", палиндромАст(рӯйхатиПайваст([5])), дуруст);
санҷ("рӯйхати холӣ", палиндромАст(холӣ), дуруст);
санҷ("дарозии тоқ", палиндромАст(рӯйхатиПайваст([1, 2, 3, 2, 1])), дуруст);
санҷ("фарқ дар миёна", палиндромАст(рӯйхатиПайваст([1, 2, 3, 4, 2, 1])), нодуруст);
санҷ("фарқ дар канор", палиндромАст(рӯйхатиПайваст([1, 1, 2, 1])), нодуруст);
санҷ("ҳама якхела", палиндромАст(рӯйхатиПайваст([9, 9, 9, 9, 9])), дуруст);

собит р = рӯйхатиПайваст([1, 0, 3, 0, 1]);
палиндромАст(р);
санҷ("рӯйхат барқарор шуд", баРақамҳо(р), [1, 0, 3, 0, 1]);

собит нима = рӯйхат.аз({ length: 5000 }, (_: ҳар, и: рақам) => и % 10);
собит калон = нима.пайвастан(нима.буридан().баргардон());
санҷ("рӯйхати калон — палиндром", палиндромАст(рӯйхатиПайваст(калон)), дуруст);
калон[3] = 42;
санҷ("рӯйхати калон — не", палиндромАст(рӯйхатиПайваст(калон)), нодуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
