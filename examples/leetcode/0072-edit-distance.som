// 72. Масофаи таҳрир (Edit Distance)
// https://leetcode.com/problems/edit-distance/
// Сатҳ: Миёна (Medium)
//
// Шарт: Ду калима дода шудааст. Шумораи хурдтарини амалҳоеро ёбед, ки
// калимаи якумро ба дуюм табдил медиҳанд. Амалҳои иҷозатдодашуда:
// гузоштани аломат, нест кардани аломат, иваз кардани аломат.
//
// Усул: Барномасозии динамикӣ (масофаи Левенштейн):
// дп[и][ҷ] = дп[и-1][ҷ-1], агар аломатҳо баробар бошанд, вагарна
// 1 + min(дп[и-1][ҷ-1] (иваз), дп[и-1][ҷ] (нест), дп[и][ҷ-1] (гузоштан)).
// Ҷадвал ба як сатр фишурда мешавад.
// Мураккабӣ: вақт O(m·n), хотира O(n).

функсия масофаиТаҳрир(калима1: сатр, калима2: сатр): рақам {
    собит m = калима1.дарозӣ;
    собит n = калима2.дарозӣ;
    // дп[ҷ] — масофа аз пешвандҳои калима1 ва калима2[0..ҷ).
    собит дп: рақам[] = рӯйхат.аз({ length: n + 1 }, (_: ҳар, ҷ: рақам) => ҷ);
    барои (тағ и = 1; и <= m; и++) {
        тағ диагонал = дп[0]; // дп[и-1][ҷ-1]
        дп[0] = и;
        барои (тағ ҷ = 1; ҷ <= n; ҷ++) {
            собит пештара = дп[ҷ]; // дп[и-1][ҷ]
            агар (калима1[и - 1] === калима2[ҷ - 1]) {
                дп[ҷ] = диагонал;
            } вагарна {
                дп[ҷ] = 1 + Риёзӣ.ҳаддиАқал(диагонал, дп[ҷ], дп[ҷ - 1]);
            }
            диагонал = пештара;
        }
    }
    бозгашт дп[n];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", масофаиТаҳрир("horse", "ros"), 3);
санҷ("мисол 2", масофаиТаҳрир("intention", "execution"), 5);
санҷ("ду сатри холӣ", масофаиТаҳрир("", ""), 0);
санҷ("аз холӣ", масофаиТаҳрир("", "abc"), 3);
санҷ("ба холӣ", масофаиТаҳрир("abc", ""), 3);
санҷ("калимаҳои баробар", масофаиТаҳрир("abc", "abc"), 0);
санҷ("kitten → sitting", масофаиТаҳрир("kitten", "sitting"), 3);
санҷ("калимаҳои дароз", масофаиТаҳрир("dinitrophenylhydrazine", "benzalphenylhydrazone"), 7);
санҷ("кириллӣ", масофаиТаҳрир("китоб", "китобҳо"), 2);
санҷ("ҳама гуногун", масофаиТаҳрир("a".такрор(200), "b".такрор(150)), 200);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
