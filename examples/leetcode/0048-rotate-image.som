// 48. Гардонидани тасвир (Rotate Image)
// https://leetcode.com/problems/rotate-image/
// Сатҳ: Миёна (Medium)
//
// Шарт: Матритсаи квадратии n x n (тасвир) дода шудааст. Онро 90 дараҷа
// бо ақрабаки соат гардонед. Гардониш бояд дар худи матритса (in-place)
// анҷом дода шавад — матритсаи дигар сохтан мумкин нест.
//
// Усул: Гардиш ба 90° = транспонкунӣ (ивази матритса[и][ҷ] бо
// матритса[ҷ][и]) ва баъд чаппа кардани ҳар қатор.
// Мураккабӣ: вақт O(n²), хотираи иловагӣ O(1).

функсия гардониданиТасвир(матритса: рақам[][]): беджавоб {
    собит н = матритса.дарозӣ;
    // Транспонкунӣ.
    барои (тағ и = 0; и < н; и++) {
        барои (тағ ҷ = и + 1; ҷ < н; ҷ++) {
            собит муваққатӣ = матритса[и][ҷ];
            матритса[и][ҷ] = матритса[ҷ][и];
            матритса[ҷ][и] = муваққатӣ;
        }
    }
    // Чаппа кардани ҳар қатор.
    барои (собит қатор аз матритса) {
        тағ чап = 0;
        тағ рост = н - 1;
        то (чап < рост) {
            собит муваққатӣ = қатор[чап];
            қатор[чап] = қатор[рост];
            қатор[рост] = муваққатӣ;
            чап++;
            рост--;
        }
    }
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия гардонидашуда(матритса: рақам[][]): рақам[][] {
    гардониданиТасвир(матритса);
    бозгашт матритса;
}

санҷ("мисол 1", гардонидашуда([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [[7, 4, 1], [8, 5, 2], [9, 6, 3]]);
санҷ(
    "мисол 2",
    гардонидашуда([[5, 1, 9, 11], [2, 4, 8, 10], [13, 3, 6, 7], [15, 14, 12, 16]]),
    [[15, 13, 2, 5], [14, 3, 4, 1], [12, 6, 8, 9], [16, 7, 10, 11]]
);
санҷ("як ҳуҷайра", гардонидашуда([[42]]), [[42]]);
санҷ("2 x 2", гардонидашуда([[1, 2], [3, 4]]), [[3, 1], [4, 2]]);
санҷ("манфӣ", гардонидашуда([[-1, -2], [-3, -4]]), [[-3, -1], [-4, -2]]);

// Чор гардиш матритсаро ба ҳолати аввал бармегардонад (5 x 5).
собит аслӣ: рақам[][] = рӯйхат.аз({ length: 5 }, (_, и) => рӯйхат.аз({ length: 5 }, (__, ҷ) => и * 5 + ҷ));
собит нусха: рақам[][] = аслӣ.харита((қ) => қ.буридан());
барои (тағ к = 0; к < 4; к++) {
    гардониданиТасвир(нусха);
}
санҷ("чор гардиш = ҳолати аввал", нусха, аслӣ);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
