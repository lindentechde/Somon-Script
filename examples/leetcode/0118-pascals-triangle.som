// 118. Секунҷаи Паскал (Pascal's Triangle)
// https://leetcode.com/problems/pascals-triangle/
// Сатҳ: Осон (Easy)
//
// Шарт: Адади бутуни numRows дода шудааст. Аввалин numRows сатри секунҷаи
// Паскалро баргардонед. Ҳар адад ба ҷамъи ду адади болои худ баробар аст.
//
// Усул: Сатрҳоро пай дар пай месозем — канорҳо 1, ҳар унсури дохилии сатри и
// ба ҷамъи унсурҳои ҷ-1 ва ҷ-и сатри пешина баробар аст.
// Мураккабӣ: вақт O(n²), хотира O(n²) (барои худи ҷавоб).

функсия секунҷаиПаскал(шумораиСатрҳо: рақам): рақам[][] {
    собит секунҷа: рақам[][] = [];
    барои (тағ и = 0; и < шумораиСатрҳо; и++) {
        собит сатрӣ: рақам[] = нав рӯйхат(и + 1).пурКардан(1);
        барои (тағ ҷ = 1; ҷ < и; ҷ++) {
            сатрӣ[ҷ] = секунҷа[и - 1][ҷ - 1] + секунҷа[и - 1][ҷ];
        }
        секунҷа.илова(сатрӣ);
    }
    бозгашт секунҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", секунҷаиПаскал(5), [[1], [1, 1], [1, 2, 1], [1, 3, 3, 1], [1, 4, 6, 4, 1]]);
санҷ("мисол 2", секунҷаиПаскал(1), [[1]]);
санҷ("ду сатр", секунҷаиПаскал(2), [[1], [1, 1]]);
санҷ("сатри 10-ум", секунҷаиПаскал(10)[9], [1, 9, 36, 84, 126, 126, 84, 36, 9, 1]);
собит калонтарин = секунҷаиПаскал(30);
санҷ("30 сатр — шумора", калонтарин.дарозӣ, 30);
санҷ("30 сатр — адади миёнаи охирин", калонтарин[29][15], 77558760);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
