// 64. Ҷамъи хурдтарини роҳ (Minimum Path Sum)
// https://leetcode.com/problems/minimum-path-sum/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дар шабакаи m x n аз рақамҳои ғайриманфӣ роҳеро аз кунҷи болои
// чап то кунҷи поёни рост ёбед, ки ҷамъи рақамҳояш хурдтарин бошад.
// Ҳаракат танҳо ба рост ё ба поён иҷозат аст.
//
// Усул: Барномасозии динамикӣ бо як сатр — арзиши ҳуҷра ба рақами худи
// ҳуҷра ҷамъ хурдтарини арзишҳои ҳуҷраи боло ва ҳуҷраи чап баробар аст.
// Мураккабӣ: вақт O(m·n), хотира O(n).

функсия ҷамъиХурдтариниРоҳ(шабака: рақам[][]): рақам {
    собит m = шабака.дарозӣ;
    собит n = шабака[0].дарозӣ;
    собит дп: рақам[] = нав рӯйхат(n).пурКардан(0);
    дп[0] = шабака[0][0];
    барои (тағ с = 1; с < n; с++) {
        дп[с] = дп[с - 1] + шабака[0][с];
    }
    барои (тағ қ = 1; қ < m; қ++) {
        дп[0] += шабака[қ][0];
        барои (тағ с = 1; с < n; с++) {
            дп[с] = Риёзӣ.ҳаддиАқал(дп[с], дп[с - 1]) + шабака[қ][с];
        }
    }
    бозгашт дп[n - 1];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷамъиХурдтариниРоҳ([[1, 3, 1], [1, 5, 1], [4, 2, 1]]), 7);
санҷ("мисол 2", ҷамъиХурдтариниРоҳ([[1, 2, 3], [4, 5, 6]]), 12);
санҷ("як ҳуҷра", ҷамъиХурдтариниРоҳ([[5]]), 5);
санҷ("як сатр", ҷамъиХурдтариниРоҳ([[1, 2, 3, 4]]), 10);
санҷ("як сутун", ҷамъиХурдтариниРоҳ([[2], [3], [4]]), 9);
санҷ("ҳама сифр", ҷамъиХурдтариниРоҳ([[0, 0], [0, 0]]), 0);
санҷ("роҳи печдор", ҷамъиХурдтариниРоҳ([[1, 9, 9, 9], [1, 1, 9, 9], [9, 1, 1, 1]]), 6);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
