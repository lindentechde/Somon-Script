// 295. Ёфтани миёна аз ҷараёни додаҳо (Find Median from Data Stream)
// https://leetcode.com/problems/find-median-from-data-stream/
// Сатҳ: Душвор (Hard)
//
// Шарт: Синфи MedianFinder-ро созед: addNum(num) рақамро ба ҷараён илова
// мекунад, findMedian() миёнаи (median) ҳамаи рақамҳои то ҳол иловашударо
// бармегардонад. Агар шумора ҷуфт бошад, миёна — ҳисоби миёнаи ду рақами мобайнӣ.
//
// Усул: Ду тӯдаи (heap) дастнавис — тӯдаи максималӣ барои нимаи поёнӣ ва тӯдаи
// минималӣ барои нимаи болоӣ. Ҳар рақами нав аввал ба нимаи поёнӣ, сипас
// бузургтарини он ба нимаи болоӣ мегузарад; агар нимаи болоӣ калонтар шавад,
// хурдтарини он баргардонида мешавад. Ҳамин тавр нимаи поёнӣ ҳамеша баробар ё
// як унсур зиёдтар дорад ва миёна дар қуллаҳо аст.
// Мураккабӣ: addNum — O(log n), findMedian — O(1), хотира O(n).

// Тӯдаи дуӣ (binary heap): "пештар(а, б)" мегӯяд, ки оё а бояд болотар аз б бошад
синф Тӯда {
    хосусӣ унсурҳо: рақам[];
    хосусӣ пештар: (а: рақам, б: рақам) => мантиқӣ;

    конструктор(пештар: (а: рақам, б: рақам) => мантиқӣ) {
        ин.унсурҳо = [];
        ин.пештар = пештар;
    }

    андоза(): рақам {
        бозгашт ин.унсурҳо.дарозӣ;
    }

    қулла(): рақам {
        бозгашт ин.унсурҳо[0];
    }

    андохтан(қимат: рақам): беджавоб {
        собит у = ин.унсурҳо;
        у.илова(қимат);
        тағ и = у.дарозӣ - 1;
        то (и > 0) {
            собит падар = (и - 1) >> 1;
            агар (!ин.пештар(у[и], у[падар])) {
                шикастан;
            }
            [у[и], у[падар]] = [у[падар], у[и]];
            и = падар;
        }
    }

    кашидан(): рақам {
        собит у = ин.унсурҳо;
        собит аввал = у[0];
        собит охирин = у.баровардан() ?? 0;
        агар (у.дарозӣ > 0) {
            у[0] = охирин;
            тағ и = 0;
            то (дуруст) {
                собит чап = 2 * и + 1;
                собит рост = чап + 1;
                тағ беҳ = и;
                агар (чап < у.дарозӣ && ин.пештар(у[чап], у[беҳ])) {
                    беҳ = чап;
                }
                агар (рост < у.дарозӣ && ин.пештар(у[рост], у[беҳ])) {
                    беҳ = рост;
                }
                агар (беҳ === и) {
                    шикастан;
                }
                [у[и], у[беҳ]] = [у[беҳ], у[и]];
                и = беҳ;
            }
        }
        бозгашт аввал;
    }
}

синф ЁбандаиМиёна {
    хосусӣ нимаиПоён: Тӯда; // тӯдаи максималӣ
    хосусӣ нимаиБоло: Тӯда; // тӯдаи минималӣ

    конструктор() {
        ин.нимаиПоён = нав Тӯда((а: рақам, б: рақам) => а > б);
        ин.нимаиБоло = нав Тӯда((а: рақам, б: рақам) => а < б);
    }

    иловаиРақам(адад: рақам): беджавоб {
        ин.нимаиПоён.андохтан(адад);
        ин.нимаиБоло.андохтан(ин.нимаиПоён.кашидан());
        агар (ин.нимаиБоло.андоза() > ин.нимаиПоён.андоза()) {
            ин.нимаиПоён.андохтан(ин.нимаиБоло.кашидан());
        }
    }

    ёфтаниМиёна(): рақам {
        агар (ин.нимаиПоён.андоза() > ин.нимаиБоло.андоза()) {
            бозгашт ин.нимаиПоён.қулла();
        }
        бозгашт (ин.нимаиПоён.қулла() + ин.нимаиБоло.қулла()) / 2;
    }
}

// Пайдарпаии амалҳои LeetCode-ро иҷро карда, рӯйхати натиҷаҳоро бармегардонад
функсия иҷро(амалҳо: сатр[], далелҳо: рақам[][]): (рақам | холӣ)[] {
    собит натиҷа: (рақам | холӣ)[] = [];
    тағ ёбанда = нав ЁбандаиМиёна();
    барои (тағ и = 0; и < амалҳо.дарозӣ; и++) {
        собит амал = амалҳо[и];
        агар (амал === "MedianFinder") {
            ёбанда = нав ЁбандаиМиёна();
            натиҷа.илова(холӣ);
        } вагарна агар (амал === "addNum") {
            ёбанда.иловаиРақам(далелҳо[и][0]);
            натиҷа.илова(холӣ);
        } вагарна {
            натиҷа.илова(ёбанда.ёфтаниМиёна());
        }
    }
    бозгашт натиҷа;
}

// Пас аз ҳар илова миёнаро сабт мекунад
функсия миёнаҳоиПайдарпай(рақамҳо: рақам[]): рақам[] {
    собит ёбанда = нав ЁбандаиМиёна();
    собит натиҷа: рақам[] = [];
    барои (собит адад аз рақамҳо) {
        ёбанда.иловаиРақам(адад);
        натиҷа.илова(ёбанда.ёфтаниМиёна());
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ(
    "мисол 1",
    иҷро(
        ["MedianFinder", "addNum", "addNum", "findMedian", "addNum", "findMedian"],
        [[], [1], [2], [], [3], []]
    ),
    [холӣ, холӣ, холӣ, 1.5, холӣ, 2.0]
);
санҷ("як рақам", иҷро(["MedianFinder", "addNum", "findMedian"], [[], [7], []]), [холӣ, холӣ, 7]);
санҷ("рақамҳои манфӣ", миёнаҳоиПайдарпай([-1, -2, -3, -4, -5]), [-1, -1.5, -2, -2.5, -3]);
санҷ("такрорҳо", миёнаҳоиПайдарпай([5, 5, 5, 1]), [5, 5, 5, 5]);
санҷ(
    "омехта",
    миёнаҳоиПайдарпай([6, 10, 2, 6, 5, 0, 6, 3, 1, 0, 0]),
    [6, 8, 6, 6, 6, 5.5, 6, 5.5, 5, 4, 3]
);

// Ҷараёни калон: ҷойивазкунии 0..10006, миёна — 5003
собит калон = нав ЁбандаиМиёна();
барои (тағ и = 0; и < 10007; и++) {
    калон.иловаиРақам((и * 7919) % 10007);
}
санҷ("ҷараёни калон (тоқ)", калон.ёфтаниМиёна(), 5003);
калон.иловаиРақам(10007);
санҷ("ҷараёни калон (ҷуфт)", калон.ёфтаниМиёна(), 5003.5);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
