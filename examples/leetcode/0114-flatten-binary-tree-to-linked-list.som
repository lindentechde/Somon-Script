// 114. Ҳамвор кардани дарахти дуӣ ба рӯйхати пайваст (Flatten Binary Tree to Linked List)
// https://leetcode.com/problems/flatten-binary-tree-to-linked-list/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дарахти дуиро дар ҷояш (in-place) ба "рӯйхати пайваст" табдил диҳед:
// ишоракунаки рост ба гиреҳи навбатӣ ва ишоракунаки чап ҳамеша холӣ бошад;
// тартиби гиреҳҳо бояд ба гузариши пеш-тартиб (preorder) мувофиқ бошад.
//
// Усул: Монанди гузариши Моррис — агар гиреҳи ҷорӣ фарзанди чап дошта бошад,
// гиреҳи ростарини зердарахти чапро меёбем, зердарахти ростро ба он мепайвандем,
// зердарахти чапро ба рост мегузаронем ва ба гиреҳи навбатӣ мегузарем.
// Мураккабӣ: вақт O(n), хотираи иловагӣ O(1).

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

// Дарахтро ба тартиби сатҳӣ табдил медиҳад (холӣ-ҳои охир бурида мешаванд)
функсия баСатҳӣ(реша: ГиреҳиДарахт | холӣ): (рақам | холӣ)[] {
    собит натиҷа: (рақам | холӣ)[] = [];
    собит навбат: (ГиреҳиДарахт | холӣ)[] = [реша];
    барои (тағ и = 0; и < навбат.дарозӣ; и++) {
        собит гиреҳ = навбат[и];
        агар (гиреҳ === холӣ) {
            натиҷа.илова(холӣ);
        } вагарна {
            натиҷа.илова(гиреҳ.қимат);
            навбат.илова(гиреҳ.чап);
            навбат.илова(гиреҳ.рост);
        }
    }
    то (натиҷа.дарозӣ > 0 && натиҷа[натиҷа.дарозӣ - 1] === холӣ) {
        натиҷа.баровардан();
    }
    бозгашт натиҷа;
}

функсия ҳамворКун(реша: ГиреҳиДарахт | холӣ): беджавоб {
    тағ ҷорӣ = реша;
    то (ҷорӣ !== холӣ) {
        собит чапӣ = ҷорӣ.чап;
        агар (чапӣ !== холӣ) {
            // Гиреҳи ростарини зердарахти чап — пешгузарандаи ҷорӣ.рост дар preorder
            тағ пешгузаранда = чапӣ;
            то (пешгузаранда.рост !== холӣ) {
                пешгузаранда = пешгузаранда.рост;
            }
            пешгузаранда.рост = ҷорӣ.рост;
            ҷорӣ.рост = чапӣ;
            ҷорӣ.чап = холӣ;
        }
        ҷорӣ = ҷорӣ.рост;
    }
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия ҳамворШуда(қиматҳо: (рақам | холӣ)[]): (рақам | холӣ)[] {
    собит реша = сохтаниДарахт(қиматҳо);
    ҳамворКун(реша);
    бозгашт баСатҳӣ(реша);
}

санҷ("мисол 1", ҳамворШуда([1, 2, 5, 3, 4, холӣ, 6]), [1, холӣ, 2, холӣ, 3, холӣ, 4, холӣ, 5, холӣ, 6]);
санҷ("мисол 2", ҳамворШуда([]), []);
санҷ("мисол 3", ҳамворШуда([0]), [0]);
санҷ("танҳо чап", ҳамворШуда([1, 2, холӣ, 3]), [1, холӣ, 2, холӣ, 3]);
санҷ("аллакай ҳамвор", ҳамворШуда([1, холӣ, 2, холӣ, 3]), [1, холӣ, 2, холӣ, 3]);
санҷ("дарахти пурра", ҳамворШуда([1, 2, 3, 4, 5, 6, 7]), [1, холӣ, 2, холӣ, 4, холӣ, 5, холӣ, 3, холӣ, 6, холӣ, 7]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
