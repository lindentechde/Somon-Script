// 5. Дарозтарин зерсатри палиндромӣ (Longest Palindromic Substring)
// https://leetcode.com/problems/longest-palindromic-substring/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дар сатри с дарозтарин зерсатреро ёбед, ки палиндром аст
// (аз чап ба рост ва аз рост ба чап якхела хонда мешавад).
//
// Усул: Васеъкунӣ аз марказ (expand around center) — ҳар аломат (барои
// дарозии тоқ) ва ҳар ҷуфти аломатҳои ҳамсоя (барои дарозии ҷуфт)-ро
// марказ гирифта, то вақте ки аломатҳои ду тараф баробаранд, васеъ мекунем.
// Мураккабӣ: вақт O(n²), хотира O(1).

// Дарозии палиндромро бо васеъкунӣ аз марказ [чап, рост] бармегардонад.
функсия дарозииВасеъшуда(с: сатр, чап: рақам, рост: рақам): рақам {
    то (чап >= 0 && рост < с.дарозӣ && с[чап] === с[рост]) {
        чап--;
        рост++;
    }
    бозгашт рост - чап - 1;
}

функсия дарозтаринПалиндром(с: сатр): сатр {
    тағ оғоз = 0;
    тағ дарозтарин = 0;
    барои (тағ и = 0; и < с.дарозӣ; и++) {
        собит тоқ = дарозииВасеъшуда(с, и, и);
        собит ҷуфт = дарозииВасеъшуда(с, и, и + 1);
        собит беҳтарин = Риёзӣ.ҳаддиАксар(тоқ, ҷуфт);
        агар (беҳтарин > дарозтарин) {
            дарозтарин = беҳтарин;
            оғоз = и - Риёзӣ.поён((беҳтарин - 1) / 2);
        }
    }
    бозгашт с.қисмат(оғоз, оғоз + дарозтарин);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Дар мисоли 1 ҷавоби "aba" низ дуруст аст; мо ҳар дуро қабул мекунем.
собит натиҷа1 = дарозтаринПалиндром("babad");
санҷ("мисол 1", натиҷа1 === "bab" || натиҷа1 === "aba", дуруст);
санҷ("мисол 2", дарозтаринПалиндром("cbbd"), "bb");
санҷ("як аломат", дарозтаринПалиндром("a"), "a");
санҷ("ду аломати гуногун", дарозтаринПалиндром("ac"), "a");
санҷ("тамоми сатр палиндром", дарозтаринПалиндром("racecar"), "racecar");
санҷ("аломатҳои якхела", дарозтаринПалиндром("aaaa"), "aaaa");
санҷ("палиндроми ҷуфт дар миёна", дарозтаринПалиндром("forgeeksskeegfor"), "geeksskeeg");
санҷ("кириллӣ", дарозтаринПалиндром("ушалашу!"), "ушалашу");
санҷ("сатри дароз", дарозтаринПалиндром("ab".такрор(500) + "x"), "ab".такрор(499) + "a");

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
