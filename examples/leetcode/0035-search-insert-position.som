// 35. Ҷойи гузоштан дар ҷустуҷӯ (Search Insert Position)
// https://leetcode.com/problems/search-insert-position/
// Сатҳ: Осон (Easy)
//
// Шарт: Рӯйхати мураттаби рақамҳои гуногун ва ҳадаф дода шудааст. Агар
// ҳадаф дар рӯйхат бошад, индекси онро баргардонед; вагарна индексеро
// баргардонед, ки ҳадаф бояд ба он ҷо гузошта шавад, то тартиб вайрон нашавад.
//
// Усул: Ҷустуҷӯи дуӣ (binary search) барои ёфтани аввалин индексе, ки
// қиматаш >= ҳадаф аст (lower bound).
// Мураккабӣ: вақт O(log n), хотира O(1).

функсия ҷойиГузоштан(рақамҳо: рақам[], ҳадаф: рақам): рақам {
    тағ чап = 0;
    тағ рост = рақамҳо.дарозӣ;
    то (чап < рост) {
        собит миёна = чап + ((рост - чап) >> 1);
        агар (рақамҳо[миёна] < ҳадаф) {
            чап = миёна + 1;
        } вагарна {
            рост = миёна;
        }
    }
    бозгашт чап;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷойиГузоштан([1, 3, 5, 6], 5), 2);
санҷ("мисол 2", ҷойиГузоштан([1, 3, 5, 6], 2), 1);
санҷ("мисол 3", ҷойиГузоштан([1, 3, 5, 6], 7), 4);
санҷ("пеш аз ҳама", ҷойиГузоштан([1, 3, 5, 6], 0), 0);
санҷ("як унсур, ёфт шуд", ҷойиГузоштан([1], 1), 0);
санҷ("як унсур, пас аз он", ҷойиГузоштан([1], 2), 1);
санҷ("рақамҳои манфӣ", ҷойиГузоштан([-10, -5, -2, 0, 3], -3), 2);
санҷ("унсури охирин", ҷойиГузоштан([-10, -5, -2, 0, 3], 3), 4);
собит калонРӯйхат: рақам[] = рӯйхат.аз({ length: 10000 }, (_: ҳар, и: рақам) => и * 2);
санҷ("рӯйхати калон, тоқ", ҷойиГузоштан(калонРӯйхат, 9999), 5000);
санҷ("рӯйхати калон, ҷуфт", ҷойиГузоштан(калонРӯйхат, 19998), 9999);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
