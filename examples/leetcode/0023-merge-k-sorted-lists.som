// 23. Якҷоя кардани k рӯйхати мураттаб (Merge k Sorted Lists)
// https://leetcode.com/problems/merge-k-sorted-lists/
// Сатҳ: Душвор (Hard)
//
// Шарт: Массиви k рӯйхати пайваст дода шудааст, ки ҳар кадоми онҳо бо
// тартиби афзуншавӣ мураттаб аст. Ҳамаи рӯйхатҳоро ба як рӯйхати мураттаб
// якҷоя карда, онро баргардонед.
//
// Усул: Тақсим ва ғалаба (divide & conquer). Рӯйхатҳоро ҷуфт-ҷуфт якҷоя
// мекунем: дар ҳар давр рӯйхати и бо рӯйхати и + фосила якҷоя мешавад ва
// фосила ду баробар меафзояд. Ҳамагӣ log k давр, ҳар давр O(N) кор.
// Мураккабӣ: вақт O(N log k) (N — шумораи ҳамаи гиреҳҳо), хотира O(1)
// (ғайр аз массиви вурудӣ).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

// Ду рӯйхати мураттабро якҷоя мекунад
функсия якҷояиДу(а: ГиреҳиРӯйхат | холӣ, б: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    собит сохтагӣ = нав ГиреҳиРӯйхат(0);
    тағ дум: ГиреҳиРӯйхат = сохтагӣ;
    тағ чап = а;
    тағ рост = б;
    то (чап !== холӣ && рост !== холӣ) {
        агар (чап.қимат <= рост.қимат) {
            дум.навбатӣ = чап;
            чап = чап.навбатӣ;
        } вагарна {
            дум.навбатӣ = рост;
            рост = рост.навбатӣ;
        }
        дум = дум.навбатӣ;
    }
    дум.навбатӣ = чап !== холӣ ? чап : рост;
    бозгашт сохтагӣ.навбатӣ;
}

функсия якҷояиРӯйхатҳо(рӯйхатҳо: (ГиреҳиРӯйхат | холӣ)[]): ГиреҳиРӯйхат | холӣ {
    собит к = рӯйхатҳо.дарозӣ;
    агар (к === 0) {
        бозгашт холӣ;
    }
    собит корӣ = рӯйхатҳо.буридан(); // массиви вурудиро тағйир намедиҳем
    барои (тағ фосила = 1; фосила < к; фосила *= 2) {
        барои (тағ и = 0; и + фосила < к; и += фосила * 2) {
            корӣ[и] = якҷояиДу(корӣ[и], корӣ[и + фосила]);
        }
    }
    бозгашт корӣ[0];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия ҳал(массивҳо: рақам[][]): рақам[] {
    собит рӯйхатҳо = массивҳо.харита((м: рақам[]) => рӯйхатиПайваст(м));
    бозгашт баРақамҳо(якҷояиРӯйхатҳо(рӯйхатҳо));
}

санҷ("мисол 1", ҳал([[1, 4, 5], [1, 3, 4], [2, 6]]), [1, 1, 2, 3, 4, 4, 5, 6]);
санҷ("мисол 2 (бе рӯйхат)", ҳал([]), []);
санҷ("мисол 3 (як рӯйхати холӣ)", ҳал([[]]), []);
санҷ("як рӯйхат", ҳал([[-3, 0, 2]]), [-3, 0, 2]);
санҷ("рӯйхатҳои холӣ дар байн", ҳал([[], [5], [], [1, 9], []]), [1, 5, 9]);
санҷ("шумораи тоқи рӯйхатҳо, манфӣ", ҳал([[-10, -5], [-7, 0], [-6, 3], [1]]), [-10, -7, -6, -5, 0, 1, 3]);
санҷ("такрорҳо", ҳал([[2, 2], [2], [1, 2, 3]]), [1, 2, 2, 2, 2, 3]);

// Калон: 50 рӯйхат, ҳар кадом 40 рақами мураттаб; натиҷа бо тартиби ҷорӣ муқоиса
собит калон: рақам[][] = [];
собит ҳамаиРақамҳо: рақам[] = [];
тағ тухм = 2024;
барои (тағ р = 0; р < 50; р++) {
    собит қатор: рақам[] = [];
    барои (тағ и = 0; и < 40; и++) {
        тухм = (тухм * 48271) % 2147483647;
        қатор.илова((тухм % 2001) - 1000);
    }
    қатор.тартиб((а: рақам, б: рақам) => а - б);
    калон.илова(қатор);
    барои (собит х аз қатор) {
        ҳамаиРақамҳо.илова(х);
    }
}
ҳамаиРақамҳо.тартиб((а: рақам, б: рақам) => а - б);
санҷ("50 рӯйхат × 40 гиреҳ", ҳал(калон), ҳамаиРақамҳо);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
