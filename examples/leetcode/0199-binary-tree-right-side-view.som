// 199. Намуди тарафи рости дарахти дуӣ (Binary Tree Right Side View)
// https://leetcode.com/problems/binary-tree-right-side-view/
// Сатҳ: Миёна (Medium)
//
// Шарт: Тасаввур кунед, ки дар тарафи рости дарахти дуӣ истодаед. Қиматҳои
// гиреҳҳоеро, ки мебинед, аз боло ба поён баргардонед.
//
// Усул: Ҷустуҷӯ дар паҳнӣ (BFS) сатҳ ба сатҳ — гиреҳи охирини ҳар сатҳ
// аз тарафи рост намоён аст.
// Мураккабӣ: вақт O(n), хотира O(w), ки w бештарин паҳнии сатҳ аст.

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

функсия намудиРост(реша: ГиреҳиДарахт | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    агар (реша === холӣ) {
        бозгашт натиҷа;
    }
    тағ навбат: ГиреҳиДарахт[] = [реша];
    то (навбат.дарозӣ > 0) {
        натиҷа.илова(навбат[навбат.дарозӣ - 1].қимат);
        собит навбатиНав: ГиреҳиДарахт[] = [];
        барои (собит гиреҳ аз навбат) {
            агар (гиреҳ.чап !== холӣ) {
                навбатиНав.илова(гиреҳ.чап);
            }
            агар (гиреҳ.рост !== холӣ) {
                навбатиНав.илова(гиреҳ.рост);
            }
        }
        навбат = навбатиНав;
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", намудиРост(сохтаниДарахт([1, 2, 3, холӣ, 5, холӣ, 4])), [1, 3, 4]);
санҷ("мисол 2", намудиРост(сохтаниДарахт([1, 2, 3, 4, холӣ, холӣ, холӣ, 5])), [1, 3, 4, 5]);
санҷ("мисол 3", намудиРост(сохтаниДарахт([1, холӣ, 3])), [1, 3]);
санҷ("мисол 4", намудиРост(сохтаниДарахт([])), []);
санҷ("танҳо чап", намудиРост(сохтаниДарахт([1, 2, холӣ, 3])), [1, 2, 3]);
санҷ("шохаи чапи дарозтар", намудиРост(сохтаниДарахт([1, 2, 3, 4, 5, 6, холӣ, 7])), [1, 3, 6, 7]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
