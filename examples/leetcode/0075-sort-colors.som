// 75. Тартиб додани рангҳо (Sort Colors)
// https://leetcode.com/problems/sort-colors/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхат аз рақамҳои 0 (сурх), 1 (сафед) ва 2 (кабуд) иборат аст.
// Онро дар ҷояш (in-place) тавре тартиб диҳед, ки рангҳои якхела паи ҳам
// бо тартиби 0, 1, 2 оянд. Функсияи тартибдиҳии китобхонаро истифода набаред.
//
// Усул: Парчами миллии Нидерланд (Dutch national flag, Дейкстра) — се
// ишорагар: паст (сарҳади 0-ҳо), ҷорӣ ва баланд (сарҳади 2-ҳо). Дар як гузар
// 0-ро ба чап ва 2-ро ба рост мегузаронем.
// Мураккабӣ: вақт O(n), хотира O(1), як гузар.

функсия ивазиҶой(рақамҳо: рақам[], а: рақам, б: рақам): беджавоб {
    собит муваққат = рақамҳо[а];
    рақамҳо[а] = рақамҳо[б];
    рақамҳо[б] = муваққат;
}

функсия тартибиРангҳо(рақамҳо: рақам[]): беджавоб {
    тағ паст = 0;
    тағ ҷорӣ = 0;
    тағ баланд = рақамҳо.дарозӣ - 1;
    то (ҷорӣ <= баланд) {
        агар (рақамҳо[ҷорӣ] === 0) {
            ивазиҶой(рақамҳо, паст, ҷорӣ);
            паст++;
            ҷорӣ++;
        } вагарна агар (рақамҳо[ҷорӣ] === 1) {
            ҷорӣ++;
        } вагарна {
            // Унсури аз рост омадаро ҳанӯз санҷида нашудааст — ҷорӣ-ро зиёд намекунем.
            ивазиҶой(рақамҳо, ҷорӣ, баланд);
            баланд--;
        }
    }
}

// Нусхаи рӯйхатро тартиб медиҳад ва бармегардонад (барои санҷишҳо).
функсия тартибдодашуда(рақамҳо: рақам[]): рақам[] {
    собит нусха = рақамҳо.буридан();
    тартибиРангҳо(нусха);
    бозгашт нусха;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", тартибдодашуда([2, 0, 2, 1, 1, 0]), [0, 0, 1, 1, 2, 2]);
санҷ("мисол 2", тартибдодашуда([2, 0, 1]), [0, 1, 2]);
санҷ("як унсур", тартибдодашуда([1]), [1]);
санҷ("рӯйхати холӣ", тартибдодашуда([]), []);
санҷ("ҳама якхела", тартибдодашуда([2, 2, 2]), [2, 2, 2]);
санҷ("тартиби баръакс", тартибдодашуда([2, 2, 1, 1, 0, 0]), [0, 0, 1, 1, 2, 2]);
санҷ("аллакай тартибдодашуда", тартибдодашуда([0, 1, 2]), [0, 1, 2]);
санҷ("бе сафед", тартибдодашуда([2, 0, 2, 0]), [0, 0, 2, 2]);

// Санҷиши дар ҷояш тағйир ёфтани ҳамон рӯйхат.
собит дарҶояш = [1, 2, 0];
тартибиРангҳо(дарҶояш);
санҷ("дар ҷояш (in-place)", дарҶояш, [0, 1, 2]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
