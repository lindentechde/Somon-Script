// 15. Се адад бо ҷамъи сифр (3Sum)
// https://leetcode.com/problems/3sum/
// Сатҳ: Миёна (Medium)
//
// Шарт: Ҳамаи сегонаҳои [а, б, в]-ро аз рӯйхат ёбед (бо индексҳои гуногун),
// ки а + б + в = 0. Ҷавоб набояд сегонаҳои такрорӣ дошта бошад.
// Тартиби сегонаҳо аҳамият надорад.
//
// Усул: Рӯйхатро тартиб медиҳем. Барои ҳар унсури и (ҳамчун адади якум)
// дар қисми рости он бо ду нишондиҳанда ҷуфтеро меҷӯем, ки ҷамъашон
// ба -рақамҳо[и] баробар аст. Қиматҳои такрориро гузаронида, такрори
// сегонаҳоро пешгирӣ мекунем.
// Мураккабӣ: вақт O(n²), хотира O(1) (ба ғайр аз тартибдиҳӣ ва ҷавоб).

функсия сеҶамъ(рақамҳо: рақам[]): рақам[][] {
    собит р = рақамҳо.буридан().тартиб((а: рақам, б: рақам) => а - б);
    собит натиҷа: рақам[][] = [];
    барои (тағ и = 0; и < р.дарозӣ - 2; и++) {
        агар (р[и] > 0) {
            шикастан; // Ҳамаи қиматҳои баъдӣ мусбатанд — ҷамъ 0 шуда наметавонад.
        }
        агар (и > 0 && р[и] === р[и - 1]) {
            давом;
        }
        тағ чап = и + 1;
        тағ рост = р.дарозӣ - 1;
        то (чап < рост) {
            собит ҷамъ = р[и] + р[чап] + р[рост];
            агар (ҷамъ < 0) {
                чап++;
            } вагарна агар (ҷамъ > 0) {
                рост--;
            } вагарна {
                натиҷа.илова([р[и], р[чап], р[рост]]);
                чап++;
                рост--;
                то (чап < рост && р[чап] === р[чап - 1]) {
                    чап++;
                }
                то (чап < рост && р[рост] === р[рост + 1]) {
                    рост--;
                }
            }
        }
    }
    бозгашт натиҷа;
}

// Тартиби сегонаҳо аҳамият надорад: ҳар сегона ва рӯйхати онҳоро тартиб медиҳем.
функсия муқаррарсозӣ(сегонаҳо: рақам[][]): рақам[][] {
    собит натиҷа = сегонаҳо.харита((с: рақам[]) =>
        с.буридан().тартиб((а: рақам, б: рақам) => а - б)
    );
    натиҷа.тартиб((а: рақам[], б: рақам[]) => {
        барои (тағ и = 0; и < 3; и++) {
            агар (а[и] !== б[и]) {
                бозгашт а[и] - б[и];
            }
        }
        бозгашт 0;
    });
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ(
    "мисол 1",
    муқаррарсозӣ(сеҶамъ([-1, 0, 1, 2, -1, -4])),
    муқаррарсозӣ([[-1, -1, 2], [-1, 0, 1]])
);
санҷ("мисол 2", сеҶамъ([0, 1, 1]), []);
санҷ("мисол 3", сеҶамъ([0, 0, 0]), [[0, 0, 0]]);
санҷ("сифрҳои зиёд", сеҶамъ([0, 0, 0, 0, 0]), [[0, 0, 0]]);
санҷ("рӯйхати холӣ", сеҶамъ([]), []);
санҷ("бе ҷавоб", сеҶамъ([1, 2, -2, -1]), []);
санҷ(
    "такрорҳо",
    муқаррарсозӣ(сеҶамъ([-2, 0, 1, 1, 2, -2, 0, 2])),
    муқаррарсозӣ([[-2, 0, 2], [-2, 1, 1]])
);
санҷ(
    "якчанд сегона",
    муқаррарсозӣ(сеҶамъ([-4, -2, -2, -2, 0, 1, 2, 2, 2, 3, 3, 4, 4, 6, 6])),
    муқаррарсозӣ([
        [-4, -2, 6], [-4, 0, 4], [-4, 1, 3], [-4, 2, 2],
        [-2, -2, 4], [-2, 0, 2]
    ])
);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
