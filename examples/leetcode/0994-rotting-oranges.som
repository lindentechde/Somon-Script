// 994. Афлесунҳои пӯсида (Rotting Oranges)
// https://leetcode.com/problems/rotting-oranges/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дар шабакаи m×n ҳар хона 0 (холӣ), 1 (афлесуни тоза) ё 2 (афлесуни
// пӯсида) аст. Ҳар дақиқа афлесунҳои тозаи ҳамсоя (боло, поён, чап, рост) бо
// афлесуни пӯсида низ мепӯсанд. Шумораи камтарини дақиқаҳоро то он ки ягон
// афлесуни тоза намонад, баргардонед; агар имконнопазир бошад — -1.
//
// Усул: Ҷустуҷӯ дар паҳнӣ (BFS) аз ҳамаи манбаъҳо якбора: ҳамаи афлесунҳои
// пӯсидаро ба навбат мегузорем ва сатҳ ба сатҳ (дақиқа ба дақиқа) паҳн мекунем.
// Навбат бо массив ва нишондиҳандаи сар сохта шудааст (бе ҳазфиАввал-и O(n)).
// Мураккабӣ: вақт O(m·n), хотира O(m·n).

функсия дақиқаҳоиПӯсидан(шабака: рақам[][]): рақам {
    собит қаторҳо = шабака.дарозӣ;
    агар (қаторҳо === 0) {
        бозгашт 0;
    }
    собит сутунҳо = шабака[0].дарозӣ;
    собит нусха = шабака.харита((қатор: рақам[]) => қатор.буридан());
    собит навбат: рақам[][] = [];
    тағ тозаҳо = 0;

    барои (тағ р = 0; р < қаторҳо; р++) {
        барои (тағ с = 0; с < сутунҳо; с++) {
            агар (нусха[р][с] === 2) {
                навбат.илова([р, с]);
            } вагарна агар (нусха[р][с] === 1) {
                тозаҳо++;
            }
        }
    }

    собит самтҳо: рақам[][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];
    тағ сар = 0;
    тағ дақиқаҳо = 0;
    то (сар < навбат.дарозӣ && тозаҳо > 0) {
        // Як сатҳи BFS = як дақиқа
        собит охириСатҳ = навбат.дарозӣ;
        то (сар < охириСатҳ) {
            собит хона = навбат[сар];
            сар++;
            барои (собит самт аз самтҳо) {
                собит нр = хона[0] + самт[0];
                собит нс = хона[1] + самт[1];
                агар (нр >= 0 && нр < қаторҳо && нс >= 0 && нс < сутунҳо && нусха[нр][нс] === 1) {
                    нусха[нр][нс] = 2;
                    тозаҳо--;
                    навбат.илова([нр, нс]);
                }
            }
        }
        дақиқаҳо++;
    }
    бозгашт тозаҳо === 0 ? дақиқаҳо : -1;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дақиқаҳоиПӯсидан([[2, 1, 1], [1, 1, 0], [0, 1, 1]]), 4);
санҷ("мисол 2", дақиқаҳоиПӯсидан([[2, 1, 1], [0, 1, 1], [1, 0, 1]]), -1);
санҷ("мисол 3", дақиқаҳоиПӯсидан([[0, 2]]), 0);
санҷ("ягон афлесун нест", дақиқаҳоиПӯсидан([[0]]), 0);
санҷ("танҳо тоза, бе пӯсида", дақиқаҳоиПӯсидан([[1]]), -1);
санҷ("ҳама аллакай пӯсида", дақиқаҳоиПӯсидан([[2, 2], [2, 2]]), 0);
санҷ("ду манбаъ", дақиқаҳоиПӯсидан([[2, 1, 1, 1, 2]]), 2);
санҷ("як қатор", дақиқаҳоиПӯсидан([[2, 1, 1, 1, 1]]), 4);

// Шабакаи 10×10 пур аз 1, танҳо кунҷи чапи боло пӯсида: 9 + 9 = 18 дақиқа
собит шабакаиКалон: рақам[][] = [];
барои (тағ р = 0; р < 10; р++) {
    шабакаиКалон.илова(нав рӯйхат<рақам>(10).пурКардан(1));
}
шабакаиКалон[0][0] = 2;
санҷ("шабакаи 10×10", дақиқаҳоиПӯсидан(шабакаиКалон), 18);
санҷ("вуруд тағйир наёфт", шабакаиКалон[9][9], 1);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
