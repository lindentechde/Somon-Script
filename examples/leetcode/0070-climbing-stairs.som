// 70. Баромадан аз зинапоя (Climbing Stairs)
// https://leetcode.com/problems/climbing-stairs/
// Сатҳ: Осон (Easy)
//
// Шарт: Барои расидан ба болои зинапоя n қадам лозим аст. Ҳар дафъа
// метавон 1 ё 2 зина баромад. Чанд роҳи гуногун барои расидан ба боло ҳаст?
//
// Усул: Барномасозии динамикӣ — шумораи роҳҳо то зинаи и ба ҷамъи роҳҳо то
// зинаҳои и-1 ва и-2 баробар аст (адади Фибоначчи). Танҳо ду қимати охиринро
// нигоҳ медорем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия баромаданАзЗина(н: рақам): рақам {
    тағ пешина: рақам = 1; // роҳҳо то зинаи и-2
    тағ ҷорӣ: рақам = 1; // роҳҳо то зинаи и-1
    барои (тағ и = 2; и <= н; и++) {
        собит баъдӣ = пешина + ҷорӣ;
        пешина = ҷорӣ;
        ҷорӣ = баъдӣ;
    }
    бозгашт ҷорӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", баромаданАзЗина(2), 2);
санҷ("мисол 2", баромаданАзЗина(3), 3);
санҷ("як зина", баромаданАзЗина(1), 1);
санҷ("панҷ зина", баромаданАзЗина(5), 8);
санҷ("даҳ зина", баромаданАзЗина(10), 89);
санҷ("ҳадди аксар (45)", баромаданАзЗина(45), 1836311903);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
