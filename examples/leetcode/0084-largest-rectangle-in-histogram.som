// 84. Бузургтарин росткунҷа дар гистограмма (Largest Rectangle in Histogram)
// https://leetcode.com/problems/largest-rectangle-in-histogram/
// Сатҳ: Душвор (Hard)
//
// Шарт: Баландии сутунҳои гистограмма дода шудааст (паҳнои ҳар сутун 1).
// Масоҳати бузургтарин росткунҷаеро, ки дар гистограмма ҷой мегирад, ёбед.
//
// Усул: Стеки монотонӣ (monotonic stack) — индексҳои сутунҳо бо баландии
// афзоянда нигоҳ дошта мешаванд. Вақте сутуни пасттар меояд, сутунҳои
// баландтарро аз стек мебарорем: барои ҳар яки онҳо сарҳади рост — индекси
// ҷорӣ, сарҳади чап — унсури нави болои стек. Дар охир сутуни "сифрӣ"
// (sentinel) ҳамаи боқимондаҳоро ҳисоб мекунад.
// Мураккабӣ: вақт O(n), хотира O(n).

функсия бузургтаринРосткунҷа(баландиҳо: рақам[]): рақам {
    собит н = баландиҳо.дарозӣ;
    собит стек: рақам[] = [];
    тағ беҳтарин = 0;
    барои (тағ и = 0; и <= н; и++) {
        собит ҷорӣ = и === н ? 0 : баландиҳо[и];
        то (стек.дарозӣ > 0 && баландиҳо[стек[стек.дарозӣ - 1]] >= ҷорӣ) {
            собит баландӣ = баландиҳо[стек.баровардан() ?? 0];
            собит чап = стек.дарозӣ > 0 ? стек[стек.дарозӣ - 1] : -1;
            беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, баландӣ * (и - чап - 1));
        }
        стек.илова(и);
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", бузургтаринРосткунҷа([2, 1, 5, 6, 2, 3]), 10);
санҷ("мисол 2", бузургтаринРосткунҷа([2, 4]), 4);
санҷ("як сутуни сифрӣ", бузургтаринРосткунҷа([0]), 0);
санҷ("як сутун", бузургтаринРосткунҷа([5]), 5);
санҷ("баландиҳои баробар", бузургтаринРосткунҷа([2, 2, 2, 2]), 8);
санҷ("афзоянда", бузургтаринРосткунҷа([1, 2, 3, 4, 5]), 9);
санҷ("камшаванда", бузургтаринРосткунҷа([5, 4, 3, 2, 1]), 9);
санҷ("омехта", бузургтаринРосткунҷа([6, 2, 5, 4, 5, 1, 6]), 12);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
