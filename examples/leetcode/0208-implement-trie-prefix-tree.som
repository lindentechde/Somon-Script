// 208. Сохтани дарахти пешвандӣ (Implement Trie (Prefix Tree))
// https://leetcode.com/problems/implement-trie-prefix-tree/
// Сатҳ: Миёна (Medium)
//
// Шарт: Синфи Trie-ро бо амалҳои зерин созед:
//   insert(word)        — калимаро ба дарахт илова мекунад;
//   search(word)        — оё ин калима пурра илова шуда буд;
//   startsWith(prefix)  — оё ягон калимаи иловашуда бо ин пешванд оғоз мешавад.
//
// Усул: Ҳар гиреҳ ҷадвали фарзандон (Map: ҳарф → гиреҳ) ва нишонаи "охири
// калима" дорад. Ҳар амал аз реша ҳарф ба ҳарф поён меравад.
// Мураккабӣ: вақти ҳар амал O(L) (L — дарозии калима), хотира O(ҷамъи
// дарозиҳои калимаҳо).

синф ГиреҳиПешвандӣ {
    фарзандон: Map<сатр, ГиреҳиПешвандӣ>;
    охириКалима: мантиқӣ;

    конструктор() {
        ин.фарзандон = нав Map<сатр, ГиреҳиПешвандӣ>();
        ин.охириКалима = нодуруст;
    }
}

синф ДарахтиПешвандӣ {
    хосусӣ реша: ГиреҳиПешвандӣ;

    конструктор() {
        ин.реша = нав ГиреҳиПешвандӣ();
    }

    // insert
    дохилКардан(калима: сатр): беджавоб {
        тағ гиреҳ = ин.реша;
        барои (собит ҳарф аз калима) {
            тағ фарзанд = гиреҳ.фарзандон.бозгирифтан(ҳарф);
            агар (фарзанд === беқимат) {
                фарзанд = нав ГиреҳиПешвандӣ();
                гиреҳ.фарзандон.гузоштан(ҳарф, фарзанд);
            }
            гиреҳ = фарзанд;
        }
        гиреҳ.охириКалима = дуруст;
    }

    // search
    калимаҲаст(калима: сатр): мантиқӣ {
        собит гиреҳ = ин.гиреҳиОхир(калима);
        бозгашт гиреҳ !== холӣ && гиреҳ.охириКалима;
    }

    // startsWith
    пешвандҲаст(пешванд: сатр): мантиқӣ {
        бозгашт ин.гиреҳиОхир(пешванд) !== холӣ;
    }

    // Гиреҳеро, ки ба охири пешванд мувофиқ аст, бармегардонад (ё холӣ)
    хосусӣ гиреҳиОхир(пешванд: сатр): ГиреҳиПешвандӣ | холӣ {
        тағ гиреҳ = ин.реша;
        барои (собит ҳарф аз пешванд) {
            собит фарзанд = гиреҳ.фарзандон.бозгирифтан(ҳарф);
            агар (фарзанд === беқимат) {
                бозгашт холӣ;
            }
            гиреҳ = фарзанд;
        }
        бозгашт гиреҳ;
    }
}

// Пайдарпаии амалҳои LeetCode-ро иҷро карда, рӯйхати натиҷаҳоро бармегардонад
функсия иҷроиАмалҳо(амалҳо: сатр[], аргументҳо: сатр[][]): (мантиқӣ | холӣ)[] {
    собит натиҷаҳо: (мантиқӣ | холӣ)[] = [];
    тағ дарахт = нав ДарахтиПешвандӣ();
    барои (тағ и = 0; и < амалҳо.дарозӣ; и++) {
        собит арг = аргументҳо[и];
        интихоб (амалҳо[и]) {
            ҳолат "Trie":
                дарахт = нав ДарахтиПешвандӣ();
                натиҷаҳо.илова(холӣ);
                шикастан;
            ҳолат "insert":
                дарахт.дохилКардан(арг[0]);
                натиҷаҳо.илова(холӣ);
                шикастан;
            ҳолат "search":
                натиҷаҳо.илова(дарахт.калимаҲаст(арг[0]));
                шикастан;
            ҳолат "startsWith":
                натиҷаҳо.илова(дарахт.пешвандҲаст(арг[0]));
                шикастан;
            пешфарз:
                партофтан нав Хато("Амали номаълум: " + амалҳо[и]);
        }
    }
    бозгашт натиҷаҳо;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", иҷроиАмалҳо(
    ["Trie", "insert", "search", "search", "startsWith", "insert", "search"],
    [[], ["apple"], ["apple"], ["app"], ["app"], ["app"], ["app"]]
), [холӣ, холӣ, дуруст, нодуруст, дуруст, холӣ, дуруст]);

санҷ("дарахти холӣ", иҷроиАмалҳо(
    ["Trie", "search", "startsWith"],
    [[], ["a"], ["a"]]
), [холӣ, нодуруст, нодуруст]);

санҷ("калимаи як ҳарфӣ", иҷроиАмалҳо(
    ["Trie", "insert", "search", "startsWith", "search"],
    [[], ["a"], ["a"], ["a"], ["ab"]]
), [холӣ, холӣ, дуруст, дуруст, нодуруст]);

санҷ("калимаи дарозтар аз калимаи иловашуда", иҷроиАмалҳо(
    ["Trie", "insert", "search", "startsWith", "startsWith"],
    [[], ["car"], ["cart"], ["cart"], ["ca"]]
), [холӣ, холӣ, нодуруст, нодуруст, дуруст]);

санҷ("илова такрорӣ ва шохаҳо", иҷроиАмалҳо(
    ["Trie", "insert", "insert", "insert", "search", "search", "search", "startsWith", "startsWith"],
    [[], ["to"], ["tea"], ["to"], ["to"], ["te"], ["tea"], ["te"], ["tx"]]
), [холӣ, холӣ, холӣ, холӣ, дуруст, нодуруст, дуруст, дуруст, нодуруст]);

санҷ("ҳарфҳои тоҷикӣ", иҷроиАмалҳо(
    ["Trie", "insert", "search", "startsWith", "search"],
    [[], ["салом"], ["салом"], ["сал"], ["сал"]]
), [холӣ, холӣ, дуруст, дуруст, нодуруст]);

// Санҷиши калон: 1000 калима илова карда, ҳамаашро меҷӯем
собит дарахтиКалон = нав ДарахтиПешвандӣ();
барои (тағ и = 0; и < 1000; и++) {
    дарахтиКалон.дохилКардан("word" + и);
}
тағ ҳамаЁфт = дуруст;
барои (тағ и = 0; и < 1000; и++) {
    агар (!дарахтиКалон.калимаҲаст("word" + и)) {
        ҳамаЁфт = нодуруст;
    }
}
санҷ("1000 калима ёфт шуд", ҳамаЁфт, дуруст);
санҷ("калимаи нест", дарахтиКалон.калимаҲаст("word1000"), нодуруст);
санҷ("пешванди ҳаст", дарахтиКалон.пешвандҲаст("word99"), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
