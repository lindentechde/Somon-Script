// 76. Хурдтарин равзанаи зерсатр (Minimum Window Substring)
// https://leetcode.com/problems/minimum-window-substring/
// Сатҳ: Душвор (Hard)
//
// Шарт: Ду сатри с ва т дода шудаанд. Кӯтоҳтарин зерсатри с-ро ёбед, ки
// ҳамаи аломатҳои т-ро (бо назардошти такрорҳо) дар бар гирад. Агар чунин
// зерсатр набошад, сатри холӣ "" баргардонед. Ҷавоб ягона аст.
//
// Усул: Равзанаи лағжанда бо ду нишондиҳанда. Дар рӯйхати "қарз" (бо коди
// аломат) нигоҳ медорем, ки ҳар аломат боз чанд маротиба лозим аст, ва
// "боқимонда" — шумораи умумии аломатҳои ҳанӯз норасо. Канори ростро
// васеъ мекунем; вақте ки боқимонда 0 шуд, канори чапро то ҳадди имкон
// танг карда, равзанаи хурдтаринро сабт мекунем.
// Мураккабӣ: вақт O(|с| + |т|), хотира O(1) (128 ҳисобкунак барои ASCII).

функсия хурдтаринРавзана(с: сатр, т: сатр): сатр {
    агар (т.дарозӣ === 0 || т.дарозӣ > с.дарозӣ) {
        бозгашт "";
    }
    собит қарз: рақам[] = нав рӯйхат(128).пурКардан(0);
    барои (тағ и = 0; и < т.дарозӣ; и++) {
        қарз[т.кодиАломатДар(и)]++;
    }
    тағ боқимонда = т.дарозӣ;
    тағ чап = 0;
    тағ беҳтаринОғоз = 0;
    тағ беҳтаринДарозӣ = Infinity;
    барои (тағ рост = 0; рост < с.дарозӣ; рост++) {
        собит кодиРост = с.кодиАломатДар(рост);
        агар (қарз[кодиРост] > 0) {
            боқимонда--;
        }
        қарз[кодиРост]--;
        то (боқимонда === 0) {
            агар (рост - чап + 1 < беҳтаринДарозӣ) {
                беҳтаринОғоз = чап;
                беҳтаринДарозӣ = рост - чап + 1;
            }
            собит кодиЧап = с.кодиАломатДар(чап);
            қарз[кодиЧап]++;
            агар (қарз[кодиЧап] > 0) {
                боқимонда++;
            }
            чап++;
        }
    }
    агар (беҳтаринДарозӣ === Infinity) {
        бозгашт "";
    }
    бозгашт с.қисмат(беҳтаринОғоз, беҳтаринОғоз + беҳтаринДарозӣ);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", хурдтаринРавзана("ADOBECODEBANC", "ABC"), "BANC");
санҷ("мисол 2", хурдтаринРавзана("a", "a"), "a");
санҷ("мисол 3", хурдтаринРавзана("a", "aa"), "");
санҷ("як аломат", хурдтаринРавзана("ab", "b"), "b");
санҷ("такрорҳо дар т", хурдтаринРавзана("aa", "aa"), "aa");
санҷ("тартиби дигар", хурдтаринРавзана("bba", "ab"), "ba");
санҷ("ҳарфҳои калону хурд", хурдтаринРавзана("aAbBcC", "Ab"), "Ab");
санҷ("бе ҷавоб", хурдтаринРавзана("xyz", "q"), "");
санҷ("мисоли дароз", хурдтаринРавзана("cabwefgewcwaefgcf", "cae"), "cwae");

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
