// 206. Баргардонидани рӯйхати пайваст (Reverse Linked List)
// https://leetcode.com/problems/reverse-linked-list/
// Сатҳ: Осон (Easy)
//
// Шарт: Сари рӯйхати яксӯяи пайваст дода шудааст. Рӯйхатро баръакс кунед ва
// сари рӯйхати баръаксшударо баргардонед.
//
// Усул: Такрорӣ — бо се ишорагар (пешина, ҷорӣ, навбатӣ) ҳар гиреҳро ба
// гиреҳи пешина равона мекунем. Варианти бозгаштӣ (рекурсивӣ) ҳам ҳаст.
// Мураккабӣ: вақт O(n), хотира O(1) (бозгаштӣ: O(n) барои стек).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

// Варианти такрорӣ (iterative)
функсия баргардониРӯйхат(сар: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    тағ пешина: ГиреҳиРӯйхат | холӣ = холӣ;
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        собит баъдӣ = ҷорӣ.навбатӣ;
        ҷорӣ.навбатӣ = пешина;
        пешина = ҷорӣ;
        ҷорӣ = баъдӣ;
    }
    бозгашт пешина;
}

// Варианти бозгаштӣ (recursive)
функсия баргардониБозгаштӣ(сар: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    агар (сар === холӣ) {
        бозгашт холӣ;
    }
    собит дуюм = сар.навбатӣ;
    агар (дуюм === холӣ) {
        бозгашт сар;
    }
    собит навСар = баргардониБозгаштӣ(дуюм);
    дуюм.навбатӣ = сар;
    сар.навбатӣ = холӣ;
    бозгашт навСар;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия ҳарДу(ном: сатр, рақамҳо: рақам[], интизорӣ: рақам[]): беджавоб {
    санҷ(ном, баРақамҳо(баргардониРӯйхат(рӯйхатиПайваст(рақамҳо))), интизорӣ);
    санҷ(ном + " (бозгаштӣ)", баРақамҳо(баргардониБозгаштӣ(рӯйхатиПайваст(рақамҳо))), интизорӣ);
}

ҳарДу("мисол 1", [1, 2, 3, 4, 5], [5, 4, 3, 2, 1]);
ҳарДу("мисол 2", [1, 2], [2, 1]);
ҳарДу("мисол 3", [], []);
ҳарДу("як гиреҳ", [7], [7]);
ҳарДу("такрорҳо ва манфӣ", [-1, 0, 0, -1, 5], [5, -1, 0, 0, -1]);

собит дароз = рӯйхат.аз({ length: 1000 }, (_: ҳар, и: рақам) => и);
ҳарДу("рӯйхати дароз", дароз, дароз.буридан().баргардон());

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
