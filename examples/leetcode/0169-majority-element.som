// 169. Унсури аксарият (Majority Element)
// https://leetcode.com/problems/majority-element/
// Сатҳ: Осон (Easy)
//
// Шарт: Дар рӯйхати андозаи n унсуреро ёбед, ки беш аз ⌊n / 2⌋ маротиба
// омадааст. Кафолат дода мешавад, ки чунин унсур ҳамеша вуҷуд дорад.
//
// Усул: Овоздиҳии Бойер–Мур (Boyer–Moore voting) — номзад ва ҳисобкунакро
// нигоҳ медорем: унсури баробар ҳисобро зиёд, унсури дигар кам мекунад;
// вақте ки ҳисоб 0 мешавад, унсури ҷориро номзади нав мегирем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия унсуриАксарият(рақамҳо: рақам[]): рақам {
    тағ номзад = 0;
    тағ ҳисоб = 0;
    барои (собит р аз рақамҳо) {
        агар (ҳисоб === 0) {
            номзад = р;
        }
        ҳисоб += р === номзад ? 1 : -1;
    }
    бозгашт номзад;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", унсуриАксарият([3, 2, 3]), 3);
санҷ("мисол 2", унсуриАксарият([2, 2, 1, 1, 1, 2, 2]), 2);
санҷ("як унсур", унсуриАксарият([1]), 1);
санҷ("рақамҳои манфӣ", унсуриАксарият([-1, -1, 2]), -1);
санҷ("аксарият дар охир", унсуриАксарият([6, 5, 5]), 5);
санҷ("ҳама якхела", унсуриАксарият([9, 9, 9, 9]), 9);

// Рӯйхати калон: 5001 то 7 ва 5000 рақами гуногун, омехта.
собит рӯйхатиБузург: рақам[] = [];
барои (тағ и = 0; и < 5000; и++) {
    рӯйхатиБузург.илова(7);
    рӯйхатиБузург.илова(-и - 1);
}
рӯйхатиБузург.илова(7);
санҷ("рӯйхати калон", унсуриАксарият(рӯйхатиБузург), 7);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
