// 79. Ҷустуҷӯи калима (Word Search)
// https://leetcode.com/problems/word-search/
// Сатҳ: Миёна (Medium)
//
// Шарт: Тахтаи m×n аз ҳарфҳо ва калимаи word дода шудаанд. Оё калима дар
// тахта мавҷуд аст? Калима аз ҳарфҳои хонаҳои пай дар пайи ҳамсоя (уфуқӣ ё
// амудӣ) сохта мешавад; як хонаро ду бор истифода бурдан мумкин нест.
//
// Усул: Ҷустуҷӯ дар умқ (DFS) бо бозгашт: аз ҳар хона оғоз карда, ҳарф ба ҳарф
// пеш меравем ва хонаи истифодашударо муваққатан бо "#" ишора мекунем.
// Буридани пешакӣ: агар дар тахта ягон ҳарф камтар аз калима бошад — нодуруст;
// агар ҳарфи аввали калима нисбат ба охиринаш зиёдтар вохӯрад, калимаро
// баръакс меҷӯем (шохаҳои камтар).
// Мураккабӣ: вақт O(m·n·3^L) (L — дарозии калима), хотира O(L) барои рекурсия.

функсия калимаМавҷудАст(тахта: сатр[][], калима: сатр): мантиқӣ {
    собит қаторҳо = тахта.дарозӣ;
    агар (қаторҳо === 0 || калима.дарозӣ === 0) {
        бозгашт калима.дарозӣ === 0;
    }
    собит сутунҳо = тахта[0].дарозӣ;
    агар (калима.дарозӣ > қаторҳо * сутунҳо) {
        бозгашт нодуруст;
    }

    // Басомади ҳарфҳо дар тахта
    собит басомад = нав Map<сатр, рақам>();
    барои (собит қатор аз тахта) {
        барои (собит ҳарф аз қатор) {
            басомад.гузоштан(ҳарф, (басомад.бозгирифтан(ҳарф) ?? 0) + 1);
        }
    }
    // Ҳар ҳарфи калима бояд дар тахта кофӣ бошад
    собит лозим = нав Map<сатр, рақам>();
    барои (собит ҳарф аз калима) {
        собит шумора = (лозим.бозгирифтан(ҳарф) ?? 0) + 1;
        агар (шумора > (басомад.бозгирифтан(ҳарф) ?? 0)) {
            бозгашт нодуруст;
        }
        лозим.гузоштан(ҳарф, шумора);
    }

    тағ ҳадаф = калима;
    собит аввал = басомад.бозгирифтан(калима[0]) ?? 0;
    собит охир = басомад.бозгирифтан(калима[калима.дарозӣ - 1]) ?? 0;
    агар (аввал > охир) {
        ҳадаф = калима.ҷудокунӣ("").баргардон().пайвастКардан("");
    }

    собит нусха = тахта.харита((қатор: сатр[]) => қатор.буридан());

    функсия ҷустан(р: рақам, с: рақам, и: рақам): мантиқӣ {
        агар (и === ҳадаф.дарозӣ) {
            бозгашт дуруст;
        }
        агар (р < 0 || р >= қаторҳо || с < 0 || с >= сутунҳо || нусха[р][с] !== ҳадаф[и]) {
            бозгашт нодуруст;
        }
        собит ҳарф = нусха[р][с];
        нусха[р][с] = "#";
        собит ёфт = ҷустан(р + 1, с, и + 1) || ҷустан(р - 1, с, и + 1) ||
            ҷустан(р, с + 1, и + 1) || ҷустан(р, с - 1, и + 1);
        нусха[р][с] = ҳарф;
        бозгашт ёфт;
    }

    барои (тағ р = 0; р < қаторҳо; р++) {
        барои (тағ с = 0; с < сутунҳо; с++) {
            агар (ҷустан(р, с, 0)) {
                бозгашт дуруст;
            }
        }
    }
    бозгашт нодуруст;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

собит тахтаиМисол: сатр[][] = [
    ["A", "B", "C", "E"],
    ["S", "F", "C", "S"],
    ["A", "D", "E", "E"]
];
санҷ("мисол 1", калимаМавҷудАст(тахтаиМисол, "ABCCED"), дуруст);
санҷ("мисол 2", калимаМавҷудАст(тахтаиМисол, "SEE"), дуруст);
санҷ("мисол 3", калимаМавҷудАст(тахтаиМисол, "ABCB"), нодуруст);
санҷ("тахта тағйир наёфт", тахтаиМисол[0].пайвастКардан(""), "ABCE");
санҷ("як хона — ёфт", калимаМавҷудАст([["a"]], "a"), дуруст);
санҷ("калима аз тахта дарозтар", калимаМавҷудАст([["a"]], "ab"), нодуруст);
санҷ("хонаро ду бор истифода бурдан мумкин нест", калимаМавҷудАст([["a", "a"]], "aaa"), нодуруст);
санҷ("гардиш дар 2×2", калимаМавҷудАст([["a", "b"], ["c", "d"]], "abdc"), дуруст);
санҷ("диагонал ҳамсоя нест", калимаМавҷудАст([["a", "b"], ["c", "d"]], "abcd"), нодуруст);
санҷ("ҳарфи нест", калимаМавҷудАст(тахтаиМисол, "ABZ"), нодуруст);

// Тахтаи 6×6 пур аз "A" — ҳолатҳои вазнин барои бозгашт
собит пурА: сатр[][] = [];
барои (тағ р = 0; р < 6; р++) {
    пурА.илова(нав рӯйхат<сатр>(6).пурКардан("A"));
}
санҷ("6×6: 36 ҳарф (тамоми тахта)", калимаМавҷудАст(пурА, "A".такрор(36)), дуруст);
санҷ("6×6: ҳарфи B нест (буридани пешакӣ)", калимаМавҷудАст(пурА, "A".такрор(15) + "B"), нодуруст);
пурА[5][5] = "B";
санҷ("6×6: B дар кунҷ, калимаи баръакс", калимаМавҷудАст(пурА, "A".такрор(34) + "B"), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
