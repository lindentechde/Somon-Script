// 104. Чуқурии ҳадди аксари дарахти дуӣ (Maximum Depth of Binary Tree)
// https://leetcode.com/problems/maximum-depth-of-binary-tree/
// Сатҳ: Осон (Easy)
//
// Шарт: Решаи дарахти дуӣ дода шудааст. Чуқурии ҳадди аксари онро
// баргардонед — шумораи гиреҳҳо дар роҳи дарозтарин аз реша то барг.
//
// Усул: Ҷустуҷӯ дар чуқурӣ (DFS): чуқурии дарахт = 1 + ҳадди аксари
// чуқурии зердарахтҳои чап ва рост; дарахти холӣ чуқурии 0 дорад.
// Барои муқоиса варианти такрорӣ бо ҷустуҷӯ дар паҳнӣ (BFS, сатҳ ба сатҳ) ҳам ҳаст.
// Мураккабӣ: вақт O(n), хотира O(h) барои DFS (h — баландӣ), O(w) барои BFS
// (w — паҳнои ҳадди аксар).

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

// Варианти рекурсивӣ (DFS)
функсия чуқурииАксар(реша: ГиреҳиДарахт | холӣ): рақам {
    агар (реша === холӣ) {
        бозгашт 0;
    }
    бозгашт 1 + Риёзӣ.ҳаддиАксар(чуқурииАксар(реша.чап), чуқурииАксар(реша.рост));
}

// Варианти такрорӣ (BFS): сатҳҳоро мешуморем
функсия чуқурииАксарТакрорӣ(реша: ГиреҳиДарахт | холӣ): рақам {
    агар (реша === холӣ) {
        бозгашт 0;
    }
    тағ сатҳ: ГиреҳиДарахт[] = [реша];
    тағ чуқурӣ = 0;
    то (сатҳ.дарозӣ > 0) {
        чуқурӣ++;
        собит сатҳиНав: ГиреҳиДарахт[] = [];
        барои (собит гиреҳ аз сатҳ) {
            агар (гиреҳ.чап !== холӣ) {
                сатҳиНав.илова(гиреҳ.чап);
            }
            агар (гиреҳ.рост !== холӣ) {
                сатҳиНав.илова(гиреҳ.рост);
            }
        }
        сатҳ = сатҳиНав;
    }
    бозгашт чуқурӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Ҳар ду вариантро месанҷад
функсия санҷиДарахт(ном: сатр, қиматҳо: (рақам | холӣ)[], интизорӣ: рақам): беджавоб {
    собит реша = сохтаниДарахт(қиматҳо);
    санҷ(ном, чуқурииАксар(реша), интизорӣ);
    санҷ(ном + " (BFS)", чуқурииАксарТакрорӣ(реша), интизорӣ);
}

санҷиДарахт("мисол 1", [3, 9, 20, холӣ, холӣ, 15, 7], 3);
санҷиДарахт("мисол 2", [1, холӣ, 2], 2);
санҷиДарахт("дарахти холӣ", [], 0);
санҷиДарахт("як гиреҳ", [0], 1);
санҷиДарахт("шохаи чуқур дар чап", [1, 2, 3, 4, холӣ, холӣ, 5, 6], 4);
санҷиДарахт("қиматҳои манфӣ", [-1, -2, -3, холӣ, -4], 3);

// Калон: занҷири 1000 гиреҳ танҳо ба рост ([1, холӣ, 2, холӣ, 3, ...])
собит занҷир: (рақам | холӣ)[] = [1];
барои (тағ и = 2; и <= 1000; и++) {
    занҷир.илова(холӣ);
    занҷир.илова(и);
}
санҷиДарахт("занҷири рости 1000 гиреҳ", занҷир, 1000);

// Калон: дарахти пурраи 10 сатҳ (1023 гиреҳ)
собит пурра: (рақам | холӣ)[] = [];
барои (тағ и = 1; и <= 1023; и++) {
    пурра.илова(и);
}
санҷиДарахт("дарахти пурраи 1023 гиреҳ", пурра, 10);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
