// 322. Иваз кардани танга (Coin Change)
// https://leetcode.com/problems/coin-change/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати арзиши тангаҳо ва маблағи amount дода шудааст. Камтарин
// шумораи тангаҳоеро ёбед, ки ҷамъашон ба amount баробар аст (ҳар навъи
// танга беохир аст). Агар ин ғайриимкон бошад, -1 баргардонед.
//
// Усул: Барномасозии динамикӣ (халтаи беохир, unbounded knapsack) —
// кам[м] = 1 + min(кам[м - танга]) барои ҳар танга <= м.
// Мураккабӣ: вақт O(amount · k), хотира O(amount), k — шумораи тангаҳо.

функсия ивазиТанга(тангаҳо: рақам[], маблағ: рақам): рақам {
    // Қимати "маблағ + 1" ҳамчун беохир хизмат мекунад (ҷавоб ҳеҷ гоҳ аз маблағ зиёд нест).
    собит беохир = маблағ + 1;
    собит кам: рақам[] = нав рӯйхат(маблағ + 1).пурКардан(беохир);
    кам[0] = 0;
    барои (тағ м = 1; м <= маблағ; м++) {
        барои (собит танга аз тангаҳо) {
            агар (танга <= м && кам[м - танга] + 1 < кам[м]) {
                кам[м] = кам[м - танга] + 1;
            }
        }
    }
    бозгашт кам[маблағ] === беохир ? -1 : кам[маблағ];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ивазиТанга([1, 2, 5], 11), 3);
санҷ("мисол 2", ивазиТанга([2], 3), -1);
санҷ("мисол 3", ивазиТанга([1], 0), 0);
санҷ("як танга", ивазиТанга([1], 1), 1);
санҷ("тангаҳои бетартиб", ивазиТанга([2, 5, 10, 1], 27), 4);
санҷ("ғайриимкон", ивазиТанга([3, 7], 11), -1);
санҷ("ҳарисӣ кор намекунад", ивазиТанга([186, 419, 83, 408], 6249), 20);
санҷ("маблағи калон", ивазиТанга([1, 5, 10, 25], 10000), 400);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
