// 1. Ду адад бо ҷамъи додашуда (Two Sum)
// https://leetcode.com/problems/two-sum/
// Сатҳ: Осон (Easy)
//
// Шарт: Дар рӯйхати рақамҳо ду индексеро ёбед, ки ҷамъи қиматҳояшон ба
// ҳадаф баробар аст. Ҳар вуруд маҳз як ҷавоб дорад.
//
// Усул: Хеш-ҷадвал (Map) — барои ҳар рақам фарқи "ҳадаф - рақам"-ро
// дар байни рақамҳои пештар дидашуда меҷӯем.
// Мураккабӣ: вақт O(n), хотира O(n).

функсия дуҶамъ(рақамҳо: рақам[], ҳадаф: рақам): рақам[] {
    собит дидашуда = нав Map<рақам, рақам>();
    барои (тағ и = 0; и < рақамҳо.дарозӣ; и++) {
        // бозгирифтан (get) барои калиди нодида беқимат бармегардонад
        собит ҷуфт = дидашуда.бозгирифтан(ҳадаф - рақамҳо[и]);
        агар (ҷуфт !== беқимат) {
            бозгашт [ҷуфт, и];
        }
        дидашуда.гузоштан(рақамҳо[и], и);
    }
    бозгашт [];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дуҶамъ([2, 7, 11, 15], 9), [0, 1]);
санҷ("мисол 2", дуҶамъ([3, 2, 4], 6), [1, 2]);
санҷ("мисол 3", дуҶамъ([3, 3], 6), [0, 1]);
санҷ("рақамҳои манфӣ", дуҶамъ([-1, -2, -3, -4, -5], -8), [2, 4]);
санҷ("сифр", дуҶамъ([0, 4, 3, 0], 0), [0, 3]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
