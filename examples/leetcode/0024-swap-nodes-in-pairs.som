// 24. Ҷой иваз кардани гиреҳҳо ҷуфт-ҷуфт (Swap Nodes in Pairs)
// https://leetcode.com/problems/swap-nodes-in-pairs/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сари рӯйхати пайваст дода шудааст. Ҳар ду гиреҳи ҳамсояро ҷой иваз
// кунед ва сари рӯйхатро баргардонед. Қиматҳоро тағйир додан мумкин нест —
// танҳо худи гиреҳҳо (пайвандҳо) иваз мешаванд.
//
// Усул: Гиреҳи қалбакӣ (dummy) пеш аз сар. Барои ҳар ҷуфти (якум, дуюм) пас аз
// гиреҳи "пеш" се пайвандро аз нав мебандем: пеш -> дуюм -> якум -> боқимонда.
// Мураккабӣ: вақт O(n), хотира O(1).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

функсия ивазиҶуфтҳо(сар: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    собит қалбакӣ = нав ГиреҳиРӯйхат(0, сар);
    тағ пеш = қалбакӣ;
    то (пеш.навбатӣ !== холӣ && пеш.навбатӣ.навбатӣ !== холӣ) {
        собит якум = пеш.навбатӣ;
        собит дуюм = пеш.навбатӣ.навбатӣ;
        якум.навбатӣ = дуюм.навбатӣ;
        дуюм.навбатӣ = якум;
        пеш.навбатӣ = дуюм;
        пеш = якум;
    }
    бозгашт қалбакӣ.навбатӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия иваз(рақамҳо: рақам[]): рақам[] {
    бозгашт баРақамҳо(ивазиҶуфтҳо(рӯйхатиПайваст(рақамҳо)));
}

санҷ("мисол 1", иваз([1, 2, 3, 4]), [2, 1, 4, 3]);
санҷ("мисол 2", иваз([]), []);
санҷ("мисол 3", иваз([1]), [1]);
санҷ("мисол 4", иваз([1, 2, 3]), [2, 1, 3]);
санҷ("шаш гиреҳ", иваз([1, 2, 3, 4, 5, 6]), [2, 1, 4, 3, 6, 5]);
санҷ("қиматҳои такрорӣ ва манфӣ", иваз([-1, -1, 0, 5, 5]), [-1, -1, 5, 0, 5]);

// Гиреҳҳо иваз мешаванд, на қиматҳо: гиреҳи дуюм сари нав мегардад
собит р = рӯйхатиПайваст([10, 20]);
собит дуюмиАслӣ = р === холӣ ? холӣ : р.навбатӣ;
санҷ("гиреҳҳо иваз шуданд", ивазиҶуфтҳо(р) === дуюмиАслӣ, дуруст);

собит дароз = рӯйхат.аз({ length: 100 }, (_: ҳар, и: рақам) => и);
собит интизориДароз = дароз.харита((қ: рақам) => қ ^ 1);
санҷ("рӯйхати дароз", иваз(дароз), интизориДароз);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
