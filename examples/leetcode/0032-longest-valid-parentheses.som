// 32. Дарозтарин қавсҳои дуруст (Longest Valid Parentheses)
// https://leetcode.com/problems/longest-valid-parentheses/
// Сатҳ: Душвор (Hard)
//
// Шарт: Сатре дода шудааст, ки танҳо аз аломатҳои '(' ва ')' иборат аст.
// Дарозии дарозтарин зерсатри пайвастаи қавсҳои дуруст (well-formed)-ро ёбед.
//
// Усул: Стек аз индексҳо. Дар қаъри стек индекси "сарҳад" — охирин ')'-и
// ҷуфтнашуда (дар аввал -1) меистад. Барои '(' индексро илова мекунем;
// барои ')' болоро мебарорем: агар стек холӣ шавад, индекси ҷориро сарҳади
// нав мекунем, вагарна дарозии "и - болои стек"-ро бо ҷавоб муқоиса мекунем.
// Мураккабӣ: вақт O(n), хотира O(n).

функсия дарозтаринҚавсҳо(қавсҳо: сатр): рақам {
    собит стек: рақам[] = [-1];
    тағ беҳтарин: рақам = 0;
    барои (тағ и = 0; и < қавсҳо.дарозӣ; и++) {
        агар (қавсҳо[и] === "(") {
            стек.илова(и);
        } вагарна {
            стек.баровардан();
            агар (стек.дарозӣ === 0) {
                стек.илова(и);
            } вагарна {
                беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, и - стек[стек.дарозӣ - 1]);
            }
        }
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дарозтаринҚавсҳо("(()"), 2);
санҷ("мисол 2", дарозтаринҚавсҳо(")()())"), 4);
санҷ("мисол 3", дарозтаринҚавсҳо(""), 0);
санҷ("як ҷуфт", дарозтаринҚавсҳо("()"), 2);
санҷ("ҳама кушода", дарозтаринҚавсҳо("((("), 0);
санҷ("тартиби баръакс", дарозтаринҚавсҳо("))(("), 0);
санҷ("қисми ҷудошуда", дарозтаринҚавсҳо("()(()"), 2);
санҷ("дарунӣ ва паси ҳам", дарозтаринҚавсҳо("()(())"), 6);
санҷ("мураккаб", дарозтаринҚавсҳо(")(((((()())()()))()(()))("), 22);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
