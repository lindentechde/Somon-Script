// 56. Муттаҳид кардани фосилаҳо (Merge Intervals)
// https://leetcode.com/problems/merge-intervals/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати фосилаҳо [оғоз, анҷом] дода шудааст. Ҳамаи фосилаҳои
// бо ҳам бархӯрандаро муттаҳид карда, рӯйхати фосилаҳои ғайрибархӯрандаро
// баргардонед, ки ҳамаи фосилаҳои вурудиро фаро мегиранд.
//
// Усул: Фосилаҳоро аз рӯи оғоз тартиб медиҳем ва аз чап ба рост мегузарем.
// Агар оғози фосилаи ҷорӣ аз анҷоми фосилаи охирини натиҷа зиёд набошад,
// онҳо бархӯрда, анҷоми охиринро васеъ мекунем; вагарна фосилаи нав илова
// мекунем. Вуруд тағйир дода намешавад (нусха тартиб дода мешавад).
// Мураккабӣ: вақт O(n log n), хотира O(n).

функсия муттаҳидКардан(фосилаҳо: рақам[][]): рақам[][] {
    собит тартибдода = фосилаҳо.буридан().тартиб((а, б) => а[0] - б[0]);
    собит натиҷа: рақам[][] = [];
    барои (собит ф аз тартибдода) {
        агар (натиҷа.дарозӣ > 0 && ф[0] <= натиҷа[натиҷа.дарозӣ - 1][1]) {
            собит охирин = натиҷа[натиҷа.дарозӣ - 1];
            охирин[1] = Риёзӣ.ҳаддиАксар(охирин[1], ф[1]);
        } вагарна {
            натиҷа.илова([ф[0], ф[1]]);
        }
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", муттаҳидКардан([[1, 3], [2, 6], [8, 10], [15, 18]]), [[1, 6], [8, 10], [15, 18]]);
санҷ("мисол 2", муттаҳидКардан([[1, 4], [4, 5]]), [[1, 5]]);
санҷ("мисол 3", муттаҳидКардан([[4, 7], [1, 4]]), [[1, 7]]);
санҷ("як фосила", муттаҳидКардан([[2, 3]]), [[2, 3]]);
санҷ("тартибнашуда", муттаҳидКардан([[8, 10], [1, 3], [15, 18], [2, 6]]), [[1, 6], [8, 10], [15, 18]]);
санҷ("дарунӣ", муттаҳидКардан([[1, 10], [2, 3], [4, 5]]), [[1, 10]]);
санҷ("фосилаҳои нуқтагӣ", муттаҳидКардан([[0, 0], [1, 1], [1, 2]]), [[0, 0], [1, 2]]);
санҷ("ҳама муттаҳид", муттаҳидКардан([[1, 4], [0, 2], [3, 5]]), [[0, 5]]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
