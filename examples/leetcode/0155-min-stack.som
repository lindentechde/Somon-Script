// 155. Стеки хурдтарин (Min Stack)
// https://leetcode.com/problems/min-stack/
// Сатҳ: Миёна (Medium)
//
// Шарт: Стеке тарҳрезӣ кунед, ки амалҳои push, pop, top ва гирифтани
// хурдтарин унсурро (getMin) дар вақти O(1) иҷро мекунад.
//
// Усул: Ду стек: дар стеки асосӣ қиматҳо, дар стеки ёрирасон — хурдтарин
// қимат то ҳамон сатҳ. Ҳангоми push ба стеки ёрирасон min(х, хурдтарини
// ҷорӣ)-ро мегузорем, ҳангоми pop аз ҳар ду стек як унсур мебарорем.
// Мураккабӣ: ҳар амал O(1), хотира O(n).

синф СтекиХурдтарин {
    хосусӣ қиматҳоиСтек: рақам[];
    хосусӣ хурдтаринҳо: рақам[];

    конструктор() {
        ин.қиматҳоиСтек = [];
        ин.хурдтаринҳо = [];
    }

    // push
    ҷойгирКун(х: рақам): беджавоб {
        ин.қиматҳоиСтек.илова(х);
        собит н = ин.хурдтаринҳо.дарозӣ;
        собит хурдтариниҶорӣ = н === 0 ? х : Риёзӣ.ҳаддиАқал(х, ин.хурдтаринҳо[н - 1]);
        ин.хурдтаринҳо.илова(хурдтариниҶорӣ);
    }

    // pop
    хориҷКун(): беджавоб {
        ин.қиматҳоиСтек.баровардан();
        ин.хурдтаринҳо.баровардан();
    }

    // top
    қулла(): рақам {
        бозгашт ин.қиматҳоиСтек[ин.қиматҳоиСтек.дарозӣ - 1];
    }

    // getMin
    гирифтаниХурдтарин(): рақам {
        бозгашт ин.хурдтаринҳо[ин.хурдтаринҳо.дарозӣ - 1];
    }
}

// Пайдарпайии амалҳои LeetCode-ро иҷро карда, рӯйхати натиҷаҳоро бармегардонад.
функсия иҷрокунӣ(амалҳо: сатр[], аргументҳо: рақам[][]): (рақам | холӣ)[] {
    тағ стек = нав СтекиХурдтарин();
    собит натиҷаҳо: (рақам | холӣ)[] = [];
    барои (тағ и = 0; и < амалҳо.дарозӣ; и++) {
        интихоб (амалҳо[и]) {
            ҳолат "MinStack":
                стек = нав СтекиХурдтарин();
                натиҷаҳо.илова(холӣ);
                шикастан;
            ҳолат "push":
                стек.ҷойгирКун(аргументҳо[и][0]);
                натиҷаҳо.илова(холӣ);
                шикастан;
            ҳолат "pop":
                стек.хориҷКун();
                натиҷаҳо.илова(холӣ);
                шикастан;
            ҳолат "top":
                натиҷаҳо.илова(стек.қулла());
                шикастан;
            ҳолат "getMin":
                натиҷаҳо.илова(стек.гирифтаниХурдтарин());
                шикастан;
            пешфарз:
                партофтан нав Хато("Амали номаълум: " + амалҳо[и]);
        }
    }
    бозгашт натиҷаҳо;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ(
    "мисол 1",
    иҷрокунӣ(
        ["MinStack", "push", "push", "push", "getMin", "pop", "top", "getMin"],
        [[], [-2], [0], [-3], [], [], [], []]
    ),
    [холӣ, холӣ, холӣ, холӣ, -3, холӣ, 0, -2]
);
санҷ(
    "хурдтарини такрорӣ",
    иҷрокунӣ(
        ["MinStack", "push", "push", "push", "getMin", "pop", "getMin", "pop", "getMin"],
        [[], [0], [1], [0], [], [], [], [], []]
    ),
    [холӣ, холӣ, холӣ, холӣ, 0, холӣ, 0, холӣ, 0]
);
санҷ(
    "барқароршавии хурдтарин",
    иҷрокунӣ(
        ["MinStack", "push", "push", "push", "push", "getMin", "pop", "getMin", "pop", "getMin", "top", "pop", "getMin", "top"],
        [[], [5], [3], [7], [3], [], [], [], [], [], [], [], [], []]
    ),
    [холӣ, холӣ, холӣ, холӣ, холӣ, 3, холӣ, 3, холӣ, 3, 3, холӣ, 5, 5]
);
санҷ(
    "як унсур",
    иҷрокунӣ(["MinStack", "push", "top", "getMin"], [[], [-2147483648], [], []]),
    [холӣ, холӣ, -2147483648, -2147483648]
);

// Стеки калон: 10000 .. 1 бо тартиби камшавӣ.
собит стекиКалон = нав СтекиХурдтарин();
барои (тағ х = 10000; х >= 1; х--) {
    стекиКалон.ҷойгирКун(х);
}
собит хурдтарин1 = стекиКалон.гирифтаниХурдтарин();
барои (тағ и = 0; и < 9999; и++) {
    стекиКалон.хориҷКун();
}
санҷ("стеки калон", [хурдтарин1, стекиКалон.гирифтаниХурдтарин(), стекиКалон.қулла()], [1, 10000, 10000]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
