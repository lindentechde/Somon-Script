// 25. Баръакс кардани гиреҳҳо дар гурӯҳҳои k-тоӣ (Reverse Nodes in k-Group)
// https://leetcode.com/problems/reverse-nodes-in-k-group/
// Сатҳ: Душвор (Hard)
//
// Шарт: Сари рӯйхати пайваст ва адади мусбати k дода шудааст. Гиреҳҳои
// рӯйхатро дар гурӯҳҳои k-тоӣ баръакс кунед. Агар шумораи гиреҳҳои боқимонда
// аз k кам бошад, онҳо ба ҳамон тартиб мемонанд. Танҳо худи гиреҳҳоро иваз
// кардан мумкин аст, на қиматҳои онҳоро.
//
// Усул: Гиреҳи сохтагӣ (dummy) пеш аз сар мегузорем. Барои ҳар гурӯҳ аввал
// месанҷем, ки k гиреҳ ҳаст; баъд гурӯҳро дар ҷояш баръакс карда, онро бо
// қисми пешина ва қисми баъдӣ пайваст мекунем.
// Мураккабӣ: вақт O(n), хотира O(1).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

функсия баръаксиГурӯҳҳо(сар: ГиреҳиРӯйхат | холӣ, к: рақам): ГиреҳиРӯйхат | холӣ {
    собит сохтагӣ = нав ГиреҳиРӯйхат(0, сар);
    тағ пешазГурӯҳ: ГиреҳиРӯйхат = сохтагӣ;
    то (дуруст) {
        // Гиреҳи охирини гурӯҳро меёбем (k қадам пас аз пешазГурӯҳ)
        тағ охириГурӯҳ: ГиреҳиРӯйхат | холӣ = пешазГурӯҳ;
        барои (тағ и = 0; и < к && охириГурӯҳ !== холӣ; и++) {
            охириГурӯҳ = охириГурӯҳ.навбатӣ;
        }
        агар (охириГурӯҳ === холӣ) {
            шикастан; // камтар аз k гиреҳ монд
        }
        собит аввалиГурӯҳ = пешазГурӯҳ.навбатӣ;
        собит баъдазГурӯҳ = охириГурӯҳ.навбатӣ;

        // Гурӯҳро баръакс мекунем; аввалин гиреҳ ба баъдазГурӯҳ пайваст мешавад
        тағ пешина: ГиреҳиРӯйхат | холӣ = баъдазГурӯҳ;
        тағ ҷорӣ: ГиреҳиРӯйхат | холӣ = аввалиГурӯҳ;
        то (ҷорӣ !== холӣ && ҷорӣ !== баъдазГурӯҳ) {
            собит оянда: ГиреҳиРӯйхат | холӣ = ҷорӣ.навбатӣ;
            ҷорӣ.навбатӣ = пешина;
            пешина = ҷорӣ;
            ҷорӣ = оянда;
        }

        // Гурӯҳи баръаксшударо ба қисми пешина мепайвандем
        пешазГурӯҳ.навбатӣ = охириГурӯҳ;
        агар (аввалиГурӯҳ === холӣ) {
            шикастан;
        }
        пешазГурӯҳ = аввалиГурӯҳ;
    }
    бозгашт сохтагӣ.навбатӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия ҳал(рақамҳо: рақам[], к: рақам): рақам[] {
    бозгашт баРақамҳо(баръаксиГурӯҳҳо(рӯйхатиПайваст(рақамҳо), к));
}

санҷ("мисол 1", ҳал([1, 2, 3, 4, 5], 2), [2, 1, 4, 3, 5]);
санҷ("мисол 2", ҳал([1, 2, 3, 4, 5], 3), [3, 2, 1, 4, 5]);
санҷ("k = 1 (бетағйир)", ҳал([1, 2, 3], 1), [1, 2, 3]);
санҷ("k = n (тамоман баръакс)", ҳал([1, 2, 3, 4], 4), [4, 3, 2, 1]);
санҷ("k > n", ҳал([1, 2], 3), [1, 2]);
санҷ("як гиреҳ", ҳал([7], 1), [7]);
санҷ("ду гурӯҳи пурра", ҳал([1, 2, 3, 4, 5, 6], 3), [3, 2, 1, 6, 5, 4]);
санҷ("такрорҳо ва манфӣ", ҳал([-1, -1, 0, 2, 2, 5, 9], 2), [-1, -1, 2, 0, 5, 2, 9]);

// Рӯйхати калон: 1..1000, k = 7
собит калонВуруд: рақам[] = [];
барои (тағ и = 1; и <= 1000; и++) {
    калонВуруд.илова(и);
}
собит калонИнтизор: рақам[] = [];
барои (тағ оғоз = 0; оғоз < 1000; оғоз += 7) {
    собит интиҳо = Риёзӣ.ҳаддиАқал(оғоз + 7, 1000);
    агар (интиҳо - оғоз === 7) {
        барои (тағ и = интиҳо - 1; и >= оғоз; и--) {
            калонИнтизор.илова(калонВуруд[и]);
        }
    } вагарна {
        барои (тағ и = оғоз; и < интиҳо; и++) {
            калонИнтизор.илова(калонВуруд[и]);
        }
    }
}
санҷ("рӯйхати калон (1000, k = 7)", ҳал(калонВуруд, 7), калонИнтизор);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
