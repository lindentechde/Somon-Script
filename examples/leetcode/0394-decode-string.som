// 394. Кушодани сатри рамзгузоришуда (Decode String)
// https://leetcode.com/problems/decode-string/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сатр бо қоидаи k[матн] рамзгузорӣ шудааст: матни дохили қавсҳои
// квадратӣ маҳз k маротиба такрор мешавад (k — адади мусбат, қавсҳо метавонанд
// дарунӣ бошанд). Сатри кушодашударо баргардонед.
//
// Усул: Ду стек — яке барои шумораи такрор, дигаре барои матни то "[" ҷамъшуда.
// Дар "[" ҳолати ҷориро ба стекҳо мегузорем ва аз нав сар мекунем; дар "]"
// матни ҷориро k маротиба такрор карда, ба матни пешина мечаспонем.
// Мураккабӣ: вақт O(дарозии натиҷа), хотира O(дарозии натиҷа).

функсия кушоданиСатр(с: сатр): сатр {
    собит стекиШумора: рақам[] = [];
    собит стекиМатн: сатр[] = [];
    тағ ҷорӣ = "";
    тағ шумора = 0;
    барои (собит ҳарф аз с) {
        агар (ҳарф >= "0" && ҳарф <= "9") {
            шумора = шумора * 10 + (ҳарф.кодиАломатДар(0) - 48);
        } вагарна агар (ҳарф === "[") {
            стекиШумора.илова(шумора);
            стекиМатн.илова(ҷорӣ);
            шумора = 0;
            ҷорӣ = "";
        } вагарна агар (ҳарф === "]") {
            собит к = стекиШумора.баровардан() ?? 0;
            собит пешина = стекиМатн.баровардан() ?? "";
            ҷорӣ = пешина + ҷорӣ.такрор(к);
        } вагарна {
            ҷорӣ += ҳарф;
        }
    }
    бозгашт ҷорӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", кушоданиСатр("3[a]2[bc]"), "aaabcbc");
санҷ("мисол 2", кушоданиСатр("3[a2[c]]"), "accaccacc");
санҷ("мисол 3", кушоданиСатр("2[abc]3[cd]ef"), "abcabccdcdcdef");
санҷ("бе қавс", кушоданиСатр("leetcode"), "leetcode");
санҷ("адади дурақама", кушоданиСатр("10[a]"), "aaaaaaaaaa");
санҷ("қавсҳои дарунӣ бо ҳарфҳо дар канор", кушоданиСатр("a2[b3[c]]d"), "abcccbcccd");
санҷ("се сатҳ", кушоданиСатр("2[2[2[x]]]"), "xxxxxxxx");

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
