// 153. Ёфтани хурдтарин дар рӯйхати мураттаби давршуда
//      (Find Minimum in Rotated Sorted Array)
// https://leetcode.com/problems/find-minimum-in-rotated-sorted-array/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати бо тартиби афзоиш мураттаби рақамҳои гуногун аз 1 то n
// маротиба давр зада шудааст. Хурдтарин унсурро дар вақти O(log n) ёбед.
//
// Усул: Ҷустуҷӯи дуӣ: агар рақамҳо[миёна] > рақамҳо[рост] бошад, хурдтарин
// дар тарафи рости миёна аст; вагарна дар [чап..миёна]. Вақте ки чап ба
// рост баробар шуд, он индекси хурдтарин аст.
// Мураккабӣ: вақт O(log n), хотира O(1).

функсия хурдтаринДаврӣ(рақамҳо: рақам[]): рақам {
    тағ чап = 0;
    тағ рост = рақамҳо.дарозӣ - 1;
    то (чап < рост) {
        собит миёна = чап + ((рост - чап) >> 1);
        агар (рақамҳо[миёна] > рақамҳо[рост]) {
            чап = миёна + 1;
        } вагарна {
            рост = миёна;
        }
    }
    бозгашт рақамҳо[чап];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", хурдтаринДаврӣ([3, 4, 5, 1, 2]), 1);
санҷ("мисол 2", хурдтаринДаврӣ([4, 5, 6, 7, 0, 1, 2]), 0);
санҷ("мисол 3", хурдтаринДаврӣ([11, 13, 15, 17]), 11);
санҷ("як унсур", хурдтаринДаврӣ([42]), 42);
санҷ("ду унсур", хурдтаринДаврӣ([2, 1]), 1);
санҷ("хурдтарин дар охир", хурдтаринДаврӣ([2, 3, 4, 5, 1]), 1);
санҷ("рақамҳои манфӣ", хурдтаринДаврӣ([-2, 0, 5, -10, -7]), -10);
собит рӯйхатиКалон: рақам[] = рӯйхат.аз({ length: 5000 }, (_: ҳар, и: рақам) => (и + 1234) % 5000 - 2500);
санҷ("рӯйхати калон", хурдтаринДаврӣ(рӯйхатиКалон), -2500);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
