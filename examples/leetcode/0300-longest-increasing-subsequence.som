// 300. Дарозтарин зерпайдарпаии афзоянда (Longest Increasing Subsequence)
// https://leetcode.com/problems/longest-increasing-subsequence/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳо дода шудааст. Дарозии дарозтарин зерпайдарпаии
// қатъиян афзояндаро баргардонед (унсурҳо бояд тартиби аслии худро нигоҳ
// доранд, вале ҳатман паси ҳам набошанд).
//
// Усул: "Ҷобаҷокунии сабр" (patience sorting) — рӯйхати думҳо[к] хурдтарин
// унсури охирини зерпайдарпаии афзояндаи дарозиаш к+1-ро нигоҳ медорад.
// Ин рӯйхат ҳамеша мураттаб аст, бинобар ин барои ҳар рақам бо ҷустуҷӯи
// дуӣ (binary search) аввалин думи >= рақамро иваз мекунем ё ба охир илова
// мекунем. Дарозии рӯйхат — ҷавоб.
// Мураккабӣ: вақт O(n log n), хотира O(n).

функсия дарозтаринЗерпайдарпаӣ(рақамҳо: рақам[]): рақам {
    собит думҳо: рақам[] = [];
    барои (собит рақамӣ аз рақамҳо) {
        // Ҷустуҷӯи дуӣ: аввалин индекс, ки думҳо[индекс] >= рақамӣ.
        тағ чап: рақам = 0;
        тағ рост: рақам = думҳо.дарозӣ;
        то (чап < рост) {
            собит миёна = (чап + рост) >> 1;
            агар (думҳо[миёна] < рақамӣ) {
                чап = миёна + 1;
            } вагарна {
                рост = миёна;
            }
        }
        агар (чап === думҳо.дарозӣ) {
            думҳо.илова(рақамӣ);
        } вагарна {
            думҳо[чап] = рақамӣ;
        }
    }
    бозгашт думҳо.дарозӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дарозтаринЗерпайдарпаӣ([10, 9, 2, 5, 3, 7, 101, 18]), 4);
санҷ("мисол 2", дарозтаринЗерпайдарпаӣ([0, 1, 0, 3, 2, 3]), 4);
санҷ("мисол 3", дарозтаринЗерпайдарпаӣ([7, 7, 7, 7, 7, 7, 7]), 1);
санҷ("як унсур", дарозтаринЗерпайдарпаӣ([5]), 1);
санҷ("рақамҳои манфӣ", дарозтаринЗерпайдарпаӣ([-2, -1]), 2);
санҷ("афзоянда", дарозтаринЗерпайдарпаӣ([1, 2, 3, 4, 5]), 5);
санҷ("камшаванда", дарозтаринЗерпайдарпаӣ([5, 4, 3, 2, 1]), 1);
санҷ("такрорҳо", дарозтаринЗерпайдарпаӣ([4, 10, 4, 3, 8, 9]), 3);
санҷ("омехта", дарозтаринЗерпайдарпаӣ([3, 5, 6, 2, 5, 4, 19, 5, 6, 7, 12]), 6);
санҷ("калон (2500 унсур)", дарозтаринЗерпайдарпаӣ(рӯйхат.аз({ length: 2500 }, (_, и) => и)), 2500);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
