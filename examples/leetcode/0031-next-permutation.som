// 31. Ҷойгиркунии навбатӣ (Next Permutation)
// https://leetcode.com/problems/next-permutation/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳоро дар ҷояш (in-place) ба ҷойгиркунии навбатии
// аз ҷиҳати луғавӣ калонтар табдил диҳед. Агар чунин ҷойгиркунӣ набошад
// (рӯйхат камшаванда аст), онро ба тартиби афзоянда (хурдтарин) баргардонед.
// Хотираи иловагӣ бояд доимӣ бошад.
//
// Усул: Аз рост аввалин индекси и-ро меёбем, ки рақамҳо[и] < рақамҳо[и+1].
// Баъд аз рост аввалин унсури аз рақамҳо[и] калонтарро ёфта, ҷояшонро
// иваз мекунем ва қисми пас аз и-ро баръакс мекунем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия ивазиҶой(рақамҳо: рақам[], а: рақам, б: рақам): беджавоб {
    собит муваққат = рақамҳо[а];
    рақамҳо[а] = рақамҳо[б];
    рақамҳо[б] = муваққат;
}

функсия ҷойгиркунииНавбатӣ(рақамҳо: рақам[]): беджавоб {
    тағ и = рақамҳо.дарозӣ - 2;
    то (и >= 0 && рақамҳо[и] >= рақамҳо[и + 1]) {
        и--;
    }
    агар (и >= 0) {
        тағ ҷ = рақамҳо.дарозӣ - 1;
        то (рақамҳо[ҷ] <= рақамҳо[и]) {
            ҷ--;
        }
        ивазиҶой(рақамҳо, и, ҷ);
    }
    // Қисми рост камшаванда аст — баръакс кардан онро афзоянда мекунад.
    тағ чап = и + 1;
    тағ рост = рақамҳо.дарозӣ - 1;
    то (чап < рост) {
        ивазиҶой(рақамҳо, чап, рост);
        чап++;
        рост--;
    }
}

// Нусхаро тағйир дода бармегардонад (барои санҷишҳо).
функсия навбатӣ(рақамҳо: рақам[]): рақам[] {
    собит нусха = рақамҳо.буридан();
    ҷойгиркунииНавбатӣ(нусха);
    бозгашт нусха;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", навбатӣ([1, 2, 3]), [1, 3, 2]);
санҷ("мисол 2", навбатӣ([3, 2, 1]), [1, 2, 3]);
санҷ("мисол 3", навбатӣ([1, 1, 5]), [1, 5, 1]);
санҷ("як унсур", навбатӣ([1]), [1]);
санҷ("ҳама якхела", навбатӣ([2, 2, 2]), [2, 2, 2]);
санҷ("такрорҳо", навбатӣ([1, 5, 1]), [5, 1, 1]);
санҷ("[2,3,1]", навбатӣ([2, 3, 1]), [3, 1, 2]);
санҷ("дарозтар", навбатӣ([2, 2, 0, 4, 3, 1]), [2, 2, 1, 0, 3, 4]);
санҷ("бо иваз ва баръакс", навбатӣ([5, 4, 7, 5, 3, 2]), [5, 5, 2, 3, 4, 7]);

// Аз [1,2,3,4] пас аз 24 қадам бояд ба ҳамон ҷо баргардем ва ҳамаи
// ҷойгиркуниҳо бояд гуногун бошанд.
собит ҷорӣ = [1, 2, 3, 4];
собит дидашуда = нав Set<сатр>();
барои (тағ қадам = 0; қадам < 24; қадам++) {
    дидашуда.add(JSON.stringify(ҷорӣ));
    ҷойгиркунииНавбатӣ(ҷорӣ);
}
санҷ("давраи пурра (24 ҷойгиркунӣ)", [дидашуда.ҳаҷм, ҷорӣ], [24, [1, 2, 3, 4]]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
