// 236. Наздиктарин аҷдоди умумӣ дар дарахти дуӣ (Lowest Common Ancestor of a Binary Tree)
// https://leetcode.com/problems/lowest-common-ancestor-of-a-binary-tree/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дар дарахти дуӣ ду гиреҳи гуногуни p ва q дода шудаанд (ҳарду дар
// дарахт мавҷуданд). Наздиктарин аҷдоди умумии онҳоро ёбед — гиреҳи
// поёнтарине, ки ҳам p ва ҳам q насли он мебошанд (гиреҳ насли худаш ҳисоб меёбад).
//
// Усул: Ҷустуҷӯ дар умқ (DFS) — агар гиреҳ худи p ё q бошад, онро бармегардонем.
// Агар ҳарду зердарахт натиҷаи ғайрихолӣ диҳанд, гиреҳи ҷорӣ ҷавоб аст;
// вагарна натиҷаи ғайрихолиро боло мебарем.
// Мураккабӣ: вақт O(n), хотира O(h), ки h баландии дарахт аст.

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

функсия аҷдодиУмумӣ(
    реша: ГиреҳиДарахт | холӣ,
    п: ГиреҳиДарахт | холӣ,
    қ: ГиреҳиДарахт | холӣ
): ГиреҳиДарахт | холӣ {
    агар (реша === холӣ || реша === п || реша === қ) {
        бозгашт реша;
    }
    собит чапӣ = аҷдодиУмумӣ(реша.чап, п, қ);
    собит ростӣ = аҷдодиУмумӣ(реша.рост, п, қ);
    агар (чапӣ !== холӣ && ростӣ !== холӣ) {
        бозгашт реша;
    }
    бозгашт чапӣ !== холӣ ? чапӣ : ростӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Гиреҳро аз рӯи қиматаш меёбад (қиматҳо дар дарахт гуногунанд)
функсия гиреҳиБоҚимат(реша: ГиреҳиДарахт | холӣ, қимат: рақам): ГиреҳиДарахт | холӣ {
    агар (реша === холӣ || реша.қимат === қимат) {
        бозгашт реша;
    }
    собит дарЧап = гиреҳиБоҚимат(реша.чап, қимат);
    бозгашт дарЧап !== холӣ ? дарЧап : гиреҳиБоҚимат(реша.рост, қимат);
}

функсия қиматиАҷдод(қиматҳо: (рақам | холӣ)[], п: рақам, қ: рақам): рақам | холӣ {
    собит реша = сохтаниДарахт(қиматҳо);
    собит натиҷа = аҷдодиУмумӣ(реша, гиреҳиБоҚимат(реша, п), гиреҳиБоҚимат(реша, қ));
    бозгашт натиҷа !== холӣ ? натиҷа.қимат : холӣ;
}

собит дарахт1: (рақам | холӣ)[] = [3, 5, 1, 6, 2, 0, 8, холӣ, холӣ, 7, 4];
санҷ("мисол 1", қиматиАҷдод(дарахт1, 5, 1), 3);
санҷ("мисол 2", қиматиАҷдод(дарахт1, 5, 4), 5);
санҷ("мисол 3", қиматиАҷдод([1, 2], 1, 2), 1);
санҷ("ду барг дар як зердарахт", қиматиАҷдод(дарахт1, 7, 4), 2);
санҷ("баргҳои дур", қиматиАҷдод(дарахт1, 7, 8), 3);
санҷ("амак ва ҷиян", қиматиАҷдод(дарахт1, 6, 4), 5);
санҷ("занҷири чап", қиматиАҷдод([1, 2, холӣ, 3, холӣ, 4], 4, 2), 2);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
