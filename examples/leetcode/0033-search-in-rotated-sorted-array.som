// 33. Ҷустуҷӯ дар рӯйхати мураттаби давршуда (Search in Rotated Sorted Array)
// https://leetcode.com/problems/search-in-rotated-sorted-array/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати бо тартиби афзоиш мураттаби рақамҳои гуногун дар нуқтае
// номаълум давр зада шудааст (масалан, [0,1,2,4,5,6,7] → [4,5,6,7,0,1,2]).
// Индекси ҳадафро ёбед ё -1 баргардонед. Вақт бояд O(log n) бошад.
//
// Усул: Ҷустуҷӯи дуӣ. Дар ҳар қадам ақаллан яке аз нимаҳо ([чап..миёна] ё
// [миёна..рост]) мураттаб аст; месанҷем, ки ҳадаф дар нимаи мураттаб
// ҷойгир аст ё не, ва нимаи заруриро интихоб мекунем.
// Мураккабӣ: вақт O(log n), хотира O(1).

функсия ҷустуҷӯиДавршуда(рақамҳо: рақам[], ҳадаф: рақам): рақам {
    тағ чап = 0;
    тағ рост = рақамҳо.дарозӣ - 1;
    то (чап <= рост) {
        собит миёна = чап + ((рост - чап) >> 1);
        агар (рақамҳо[миёна] === ҳадаф) {
            бозгашт миёна;
        }
        агар (рақамҳо[чап] <= рақамҳо[миёна]) {
            // Нимаи чап мураттаб аст.
            агар (рақамҳо[чап] <= ҳадаф && ҳадаф < рақамҳо[миёна]) {
                рост = миёна - 1;
            } вагарна {
                чап = миёна + 1;
            }
        } вагарна {
            // Нимаи рост мураттаб аст.
            агар (рақамҳо[миёна] < ҳадаф && ҳадаф <= рақамҳо[рост]) {
                чап = миёна + 1;
            } вагарна {
                рост = миёна - 1;
            }
        }
    }
    бозгашт -1;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷустуҷӯиДавршуда([4, 5, 6, 7, 0, 1, 2], 0), 4);
санҷ("мисол 2", ҷустуҷӯиДавршуда([4, 5, 6, 7, 0, 1, 2], 3), -1);
санҷ("мисол 3", ҷустуҷӯиДавршуда([1], 0), -1);
санҷ("як унсур, ёфт шуд", ҷустуҷӯиДавршуда([1], 1), 0);
санҷ("давр нашудааст", ҷустуҷӯиДавршуда([1, 2, 3, 4, 5], 4), 3);
санҷ("ду унсур", ҷустуҷӯиДавршуда([3, 1], 1), 1);
санҷ("дар нимаи чап", ҷустуҷӯиДавршуда([4, 5, 6, 7, 0, 1, 2], 5), 1);
санҷ("рақамҳои манфӣ", ҷустуҷӯиДавршуда([-1, 3, 8, -20, -7, -4], -7), 4);
санҷ("охирин унсур", ҷустуҷӯиДавршуда([6, 7, 1, 2, 3, 4, 5], 5), 6);
собит рӯйхатиКалон: рақам[] = рӯйхат.аз({ length: 1000 }, (_: ҳар, и: рақам) => (и + 700) % 1000);
санҷ("рӯйхати калон", ҷустуҷӯиДавршуда(рӯйхатиКалон, 123), 423);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
