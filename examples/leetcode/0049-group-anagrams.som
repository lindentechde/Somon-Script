// 49. Гурӯҳбандии анаграммаҳо (Group Anagrams)
// https://leetcode.com/problems/group-anagrams/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати сатрҳо дода шудааст. Анаграммаҳоро (калимаҳое, ки аз
// ҳамон ҳарфҳо бо ҳамон миқдор иборатанд) дар як гурӯҳ ҷамъ кунед.
// Тартиби гурӯҳҳо ва калимаҳо аҳамият надорад. Ҳарфҳо — лотинии хурд (a-z).
//
// Усул: Барои ҳар калима калиди "шумораи ҳарфҳо"-ро (26 ҳисобкунак)
// месозем ва калимаҳоро бо ҳамин калид дар хеш-ҷадвал (Map) гурӯҳ мекунем.
// Мураккабӣ: вақт O(n·k), хотира O(n·k), ки k — дарозии калимаи дарозтарин.

функсия калидиАнаграмма(калима: сатр): сатр {
    собит шумора: рақам[] = нав рӯйхат(26).пурКардан(0);
    собит кодиA = "a".кодиАломатДар(0);
    барои (тағ и = 0; и < калима.дарозӣ; и++) {
        шумора[калима.кодиАломатДар(и) - кодиA]++;
    }
    бозгашт шумора.пайвастКардан("#");
}

функсия гурӯҳиАнаграммаҳо(калимаҳо: сатр[]): сатр[][] {
    собит гурӯҳҳо = нав Map<сатр, сатр[]>();
    барои (собит калима аз калимаҳо) {
        собит калид = калидиАнаграмма(калима);
        собит гурӯҳ = гурӯҳҳо.бозгирифтан(калид);
        агар (гурӯҳ === беқимат) {
            гурӯҳҳо.гузоштан(калид, [калима]);
        } вагарна {
            гурӯҳ.илова(калима);
        }
    }
    бозгашт рӯйхат.аз(гурӯҳҳо.қиматҳо());
}

// Тартиби гурӯҳҳо ва калимаҳо аҳамият надорад, бинобар ин ҳардуро тартиб медиҳем.
функсия муқаррарсозӣ(гурӯҳҳо: сатр[][]): сатр[][] {
    собит натиҷа = гурӯҳҳо.харита((гурӯҳ: сатр[]) => гурӯҳ.буридан().тартиб());
    натиҷа.тартиб((а: сатр[], б: сатр[]) => {
        собит ка = JSON.stringify(а);
        собит кб = JSON.stringify(б);
        бозгашт ка < кб ? -1 : ка > кб ? 1 : 0;
    });
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ(
    "мисол 1",
    муқаррарсозӣ(гурӯҳиАнаграммаҳо(["eat", "tea", "tan", "ate", "nat", "bat"])),
    муқаррарсозӣ([["bat"], ["nat", "tan"], ["ate", "eat", "tea"]])
);
санҷ("мисол 2", муқаррарсозӣ(гурӯҳиАнаграммаҳо([""])), [[""]]);
санҷ("мисол 3", муқаррарсозӣ(гурӯҳиАнаграммаҳо(["a"])), [["a"]]);
санҷ("рӯйхати холӣ", гурӯҳиАнаграммаҳо([]), []);
санҷ(
    "такрорҳо",
    муқаррарсозӣ(гурӯҳиАнаграммаҳо(["ab", "ba", "ab", "", ""])),
    муқаррарсозӣ([["ab", "ab", "ba"], ["", ""]])
);
санҷ(
    "ҳарфҳои якхела бо миқдори гуногун",
    муқаррарсозӣ(гурӯҳиАнаграммаҳо(["aab", "abb", "bab", "aba"])),
    муқаррарсозӣ([["aab", "aba"], ["abb", "bab"]])
);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
