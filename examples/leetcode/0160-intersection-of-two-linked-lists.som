// 160. Буриши ду рӯйхати пайваст (Intersection of Two Linked Lists)
// https://leetcode.com/problems/intersection-of-two-linked-lists/
// Сатҳ: Осон (Easy)
//
// Шарт: Сарҳои ду рӯйхати яксӯяи пайваст дода шудаанд. Гиреҳеро баргардонед,
// ки аз он ду рӯйхат якҷоя мешаванд (ҳамон як гиреҳ, на танҳо қимати баробар).
// Агар буриш набошад, холӣ баргардонед. Рӯйхатҳо набояд тағйир ёбанд.
//
// Усул: Ду ишорагар — ҳар яке рӯйхати худро тай карда, баъд ба сари рӯйхати
// дигар мегузарад. Ҳарду ишорагар роҳи якхела (a + c + b) мепаймоянд, бинобар
// ин дар гиреҳи буриш (ё дар холӣ, агар буриш набошад) вомехӯранд.
// Мураккабӣ: вақт O(m + n), хотира O(1).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

функсия гиреҳиБуриш(сарА: ГиреҳиРӯйхат | холӣ, сарБ: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    тағ а = сарА;
    тағ б = сарБ;
    то (а !== б) {
        а = а === холӣ ? сарБ : а.навбатӣ;
        б = б === холӣ ? сарА : б.навбатӣ;
    }
    бозгашт а;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Рақамҳоро пеш аз думи додашуда илова мекунад: [а, б] + дум => а -> б -> дум
функсия рӯйхатБоДум(рақамҳо: рақам[], дум: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    тағ сар = дум;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Ду рӯйхат месозад, ки гиреҳҳои қисми "умумӣ"-ро воқеан тақсим мекунанд.
// Бармегардонад: [ҳамон гиреҳи буриш аст?, қимати гиреҳи ёфтшуда, А, Б]
// (А ва Б — барои санҷидани он ки рӯйхатҳо тағйир наёфтаанд).
функсия санҷиБуриш(қисмиА: рақам[], қисмиБ: рақам[], умумӣ: рақам[]): ҳар[] {
    собит буриш = рӯйхатиПайваст(умумӣ);
    собит сарА = рӯйхатБоДум(қисмиА, буриш);
    собит сарБ = рӯйхатБоДум(қисмиБ, буриш);
    собит натиҷа = гиреҳиБуриш(сарА, сарБ);
    собит қимат = натиҷа === холӣ ? холӣ : натиҷа.қимат;
    бозгашт [натиҷа === буриш, қимат, баРақамҳо(сарА), баРақамҳо(сарБ)];
}

// мисол 1: intersectVal = 8, listA = [4,1,8,4,5], listB = [5,6,1,8,4,5], skipA = 2, skipB = 3
санҷ("мисол 1", санҷиБуриш([4, 1], [5, 6, 1], [8, 4, 5]),
    [дуруст, 8, [4, 1, 8, 4, 5], [5, 6, 1, 8, 4, 5]]);
// мисол 2: intersectVal = 2, listA = [1,9,1,2,4], listB = [3,2,4], skipA = 3, skipB = 1
санҷ("мисол 2", санҷиБуриш([1, 9, 1], [3], [2, 4]),
    [дуруст, 2, [1, 9, 1, 2, 4], [3, 2, 4]]);
// мисол 3: intersectVal = 0, listA = [2,6,4], listB = [1,5] — буриш нест
санҷ("мисол 3", санҷиБуриш([2, 6, 4], [1, 5], []),
    [дуруст, холӣ, [2, 6, 4], [1, 5]]);
санҷ("қиматҳо баробар, гиреҳҳо не", санҷиБуриш([1, 2, 3], [1, 2, 3], []),
    [дуруст, холӣ, [1, 2, 3], [1, 2, 3]]);
санҷ("рӯйхатҳои якхела", санҷиБуриш([], [], [7, 8]),
    [дуруст, 7, [7, 8], [7, 8]]);
санҷ("Б — думи А", санҷиБуриш([1, 2], [], [3, 4]),
    [дуруст, 3, [1, 2, 3, 4], [3, 4]]);
санҷ("буриш дар гиреҳи охир", санҷиБуриш([1, 2, 3], [4], [9]),
    [дуруст, 9, [1, 2, 3, 9], [4, 9]]);
санҷ("рӯйхати холӣ", санҷиБуриш([], [1, 2], []),
    [дуруст, холӣ, [], [1, 2]]);

собит дарозА = рӯйхат.аз({ length: 1000 }, (_: ҳар, и: рақам) => и);
собит натиҷаиДароз = санҷиБуриш(дарозА, [5, 5, 5], [-1, -2]);
санҷ("рӯйхатҳои дарозиашон гуногун", натиҷаиДароз.буридан(0, 2), [дуруст, -1]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
