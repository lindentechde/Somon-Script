// 1143. Дарозтарин зерпайдарпаии умумӣ (Longest Common Subsequence)
// https://leetcode.com/problems/longest-common-subsequence/
// Сатҳ: Миёна (Medium)
//
// Шарт: Ду сатр дода шудааст. Дарозии дарозтарин зерпайдарпаии умумии
// онҳоро баргардонед (зерпайдарпаӣ — аломатҳое, ки бо ҳамон тартиб, вале
// на ҳатман паи ҳам меоянд). Агар умумӣ набошад, 0.
//
// Усул: Барномасозии динамикӣ: дп[и][ҷ] = дп[и-1][ҷ-1] + 1, агар аломатҳо
// баробар бошанд, вагарна max(дп[и-1][ҷ], дп[и][ҷ-1]). Ҷадвал ба як сатр
// фишурда мешавад; қимати диагоналиро дар тағйирёбандаи алоҳида нигоҳ медорем.
// Мураккабӣ: вақт O(m·n), хотира O(min(m, n)).

функсия дарозтаринЗерпайдарпаииУмумӣ(матн1: сатр, матн2: сатр): рақам {
    // Сатри кӯтоҳтаринро барои сутунҳо истифода мебарем, то хотира кам шавад.
    агар (матн2.дарозӣ > матн1.дарозӣ) {
        бозгашт дарозтаринЗерпайдарпаииУмумӣ(матн2, матн1);
    }
    собит n = матн2.дарозӣ;
    собит дп: рақам[] = нав рӯйхат(n + 1).пурКардан(0);
    барои (тағ и = 1; и <= матн1.дарозӣ; и++) {
        тағ диагонал = 0; // дп[и-1][ҷ-1]
        барои (тағ ҷ = 1; ҷ <= n; ҷ++) {
            собит пештара = дп[ҷ]; // дп[и-1][ҷ]
            агар (матн1[и - 1] === матн2[ҷ - 1]) {
                дп[ҷ] = диагонал + 1;
            } вагарна {
                дп[ҷ] = Риёзӣ.ҳаддиАксар(дп[ҷ], дп[ҷ - 1]);
            }
            диагонал = пештара;
        }
    }
    бозгашт дп[n];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дарозтаринЗерпайдарпаииУмумӣ("abcde", "ace"), 3);
санҷ("мисол 2", дарозтаринЗерпайдарпаииУмумӣ("abc", "abc"), 3);
санҷ("мисол 3", дарозтаринЗерпайдарпаииУмумӣ("abc", "def"), 0);
санҷ("як аломат", дарозтаринЗерпайдарпаииУмумӣ("a", "a"), 1);
санҷ("сатри холӣ", дарозтаринЗерпайдарпаииУмумӣ("", "abc"), 0);
санҷ("такрорҳо", дарозтаринЗерпайдарпаииУмумӣ("bsbininm", "jmjkbkjkv"), 1);
санҷ("сатри кӯтоҳ дар аввал", дарозтаринЗерпайдарпаииУмумӣ("ezupkr", "ubmrapg"), 2);
санҷ("кириллӣ", дарозтаринЗерпайдарпаииУмумӣ("салом", "саломат"), 5);
санҷ("сатрҳои дароз", дарозтаринЗерпайдарпаииУмумӣ("ab".такрор(300), "ba".такрор(300)), 599);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
