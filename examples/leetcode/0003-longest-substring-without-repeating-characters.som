// 3. Дарозтарин зерсатр бе аломатҳои такрорӣ
//    (Longest Substring Without Repeating Characters)
// https://leetcode.com/problems/longest-substring-without-repeating-characters/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сатри с дода шудааст. Дарозии дарозтарин зерсатреро ёбед, ки
// дар он ягон аломат такрор намешавад.
//
// Усул: Равзанаи лағжанда (sliding window). Барои ҳар аломат индекси
// охирини дидашударо дар хеш-ҷадвал (Map) нигоҳ медорем. Агар аломат
// дар дохили равзана такрор шавад, канори чапи равзанаро ба баъд аз
// пайдоиши қаблии он мегузаронем.
// Мураккабӣ: вақт O(n), хотира O(min(n, m)), ки m — андозаи алифбо.

функсия дарозтаринБеТакрор(с: сатр): рақам {
    собит охирин = нав Map<сатр, рақам>();
    тағ чап = 0;
    тағ беҳтарин = 0;
    барои (тағ рост = 0; рост < с.дарозӣ; рост++) {
        собит аломат = с[рост];
        собит пешина = охирин.бозгирифтан(аломат);
        агар (пешина !== беқимат && пешина >= чап) {
            чап = пешина + 1;
        }
        охирин.гузоштан(аломат, рост);
        беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, рост - чап + 1);
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дарозтаринБеТакрор("abcabcbb"), 3);
санҷ("мисол 2", дарозтаринБеТакрор("bbbbb"), 1);
санҷ("мисол 3", дарозтаринБеТакрор("pwwkew"), 3);
санҷ("сатри холӣ", дарозтаринБеТакрор(""), 0);
санҷ("фосила", дарозтаринБеТакрор(" "), 1);
санҷ("dvdf", дарозтаринБеТакрор("dvdf"), 3);
санҷ("abba (такрори берун аз равзана)", дарозтаринБеТакрор("abba"), 2);
санҷ("tmmzuxt", дарозтаринБеТакрор("tmmzuxt"), 5);
санҷ("ҳарфҳои тоҷикӣ ва рақамҳо", дарозтаринБеТакрор("салом 123 олам"), 9);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
