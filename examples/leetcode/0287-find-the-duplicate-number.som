// 287. Ёфтани рақами такрорӣ (Find the Duplicate Number)
// https://leetcode.com/problems/find-the-duplicate-number/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхат n + 1 рақам дорад, ки ҳар яки онҳо дар фосилаи [1, n] аст.
// Танҳо як рақам такрор мешавад (шояд якчанд маротиба). Онро бе тағйир
// додани рӯйхат ва бо хотираи доимӣ ёбед.
//
// Усул: Ёфтани давра бо усули Флойд ("сангпушт ва харгӯш"). Рӯйхатро
// ҳамчун рӯйхати пайваст и → рақамҳо[и] мебинем; рақами такрорӣ даромадгоҳи
// давра аст. Марҳилаи 1: ишорагари суст як қадам, тез ду қадам то вохӯрӣ.
// Марҳилаи 2: як ишорагар аз аввал, дигаре аз ҷои вохӯрӣ, ҳар ду як қадамӣ —
// ҷои вохӯрии нав даромадгоҳи давра аст.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия рақамиТакрорӣ(рақамҳо: рақам[]): рақам {
    // Марҳилаи 1: вохӯрӣ дар дохили давра (аз гиреҳи 0 оғоз).
    тағ суст = рақамҳо[0];
    тағ тез = рақамҳо[рақамҳо[0]];
    то (суст !== тез) {
        суст = рақамҳо[суст];
        тез = рақамҳо[рақамҳо[тез]];
    }
    // Марҳилаи 2: даромадгоҳи давра.
    тағ ҷӯянда = 0;
    то (ҷӯянда !== суст) {
        ҷӯянда = рақамҳо[ҷӯянда];
        суст = рақамҳо[суст];
    }
    бозгашт ҷӯянда;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", рақамиТакрорӣ([1, 3, 4, 2, 2]), 2);
санҷ("мисол 2", рақамиТакрорӣ([3, 1, 3, 4, 2]), 3);
санҷ("мисол 3", рақамиТакрорӣ([3, 3, 3, 3, 3]), 3);
санҷ("хурдтарин (n = 1)", рақамиТакрорӣ([1, 1]), 1);
санҷ("такрори бисёр", рақамиТакрорӣ([2, 5, 9, 6, 9, 3, 8, 9, 7, 1]), 9);
санҷ("такрор дар охир", рақамиТакрорӣ([1, 4, 4, 2, 4]), 4);

// Рӯйхати калон: 1..10000 ва 6789 боз як маротиба; рӯйхат набояд тағйир ёбад.
собит рӯйхатиБузург: рақам[] = [];
барои (тағ и = 10000; и >= 1; и--) {
    рӯйхатиБузург.илова(и);
}
рӯйхатиБузург.пайваст(3000, 0, 6789);
собит нусхаиКалон = JSON.stringify(рӯйхатиБузург);
санҷ("рӯйхати калон", рақамиТакрорӣ(рӯйхатиБузург), 6789);
санҷ("рӯйхат тағйир наёфт", JSON.stringify(рӯйхатиБузург) === нусхаиКалон, дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
