// 17. Омезиши ҳарфҳои рақами телефон (Letter Combinations of a Phone Number)
// https://leetcode.com/problems/letter-combinations-of-a-phone-number/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сатре аз рақамҳои 2–9 дода шудааст. Ҳамаи омезишҳои ҳарфҳоеро, ки ин
// рақамҳо дар клавиатураи телефон ифода мекунанд, бо ҳар тартиб баргардонед
// (2 → "abc", 3 → "def", …, 9 → "wxyz"). Барои сатри холӣ — рӯйхати холӣ.
//
// Усул: Бозгашт (backtracking): барои ҳар рақам яке аз ҳарфҳои онро ба
// омезиши ҷорӣ илова карда, ба рақами навбатӣ мегузарем.
// Мураккабӣ: вақт O(4^n · n), хотира O(n) (бе ҳисоби ҷавоб).

собит ҲАРФҲОИ_ТУГМА: сатр[] = ["", "", "abc", "def", "ghi", "jkl", "mno", "pqrs", "tuv", "wxyz"];

функсия омезишиҲарфҳо(рақамҳо: сатр): сатр[] {
    собит натиҷа: сатр[] = [];
    агар (рақамҳо.дарозӣ === 0) {
        бозгашт натиҷа;
    }
    собит роҳ: сатр[] = [];

    функсия бозгаштӣ(индекс: рақам): беджавоб {
        агар (индекс === рақамҳо.дарозӣ) {
            натиҷа.илова(роҳ.пайвастКардан(""));
            бозгашт;
        }
        собит ҳарфҳо = ҲАРФҲОИ_ТУГМА[рақамҳо.кодиАломатДар(индекс) - 48];
        барои (собит ҳарф аз ҳарфҳо) {
            роҳ.илова(ҳарф);
            бозгаштӣ(индекс + 1);
            роҳ.баровардан();
        }
    }

    бозгаштӣ(0);
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия мураттаб(сатрҳо: сатр[]): сатр[] {
    бозгашт сатрҳо.буридан().тартиб();
}

санҷ("мисол 1", мураттаб(омезишиҲарфҳо("23")),
    мураттаб(["ad", "ae", "af", "bd", "be", "bf", "cd", "ce", "cf"]));
санҷ("мисол 2", омезишиҲарфҳо(""), []);
санҷ("мисол 3", мураттаб(омезишиҲарфҳо("2")), мураттаб(["a", "b", "c"]));
санҷ("рақами чорҳарфа", мураттаб(омезишиҲарфҳо("7")), мураттаб(["p", "q", "r", "s"]));
санҷ("рақами такрорӣ", мураттаб(омезишиҲарфҳо("99")), мураттаб([
    "ww", "wx", "wy", "wz", "xw", "xx", "xy", "xz",
    "yw", "yx", "yy", "yz", "zw", "zx", "zy", "zz"
]));

// Ҳадди аксар (4 рақам): 4 · 4 · 4 · 4 = 256 омезиш
собит дароз = омезишиҲарфҳо("7979");
санҷ("4 рақам — шумора", дароз.дарозӣ, 256);
санҷ("4 рақам — ҳама гуногун", нав Set<сатр>(дароз).ҳаҷм, 256);
санҷ("4 рақам — аввал ва охир", [мураттаб(дароз)[0], мураттаб(дароз)[255]], ["pwpw", "szsz"]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
