// 105. Сохтани дарахти дуӣ аз гузаришҳои пеш-тартиб ва мобайнӣ (Construct Binary Tree from Preorder and Inorder Traversal)
// https://leetcode.com/problems/construct-binary-tree-from-preorder-and-inorder-traversal/
// Сатҳ: Миёна (Medium)
//
// Шарт: Ду рӯйхат дода шудааст: гузариши пеш-тартиб (preorder) ва гузариши
// мобайнии (inorder) ҳамон як дарахти дуӣ. Ҳамаи қиматҳо гуногунанд.
// Дарахтро барқарор карда, решаи онро баргардонед.
//
// Усул: Унсури навбатии preorder решаи зердарахти ҷорӣ аст; мавқеи он дар
// inorder (аз хеш-ҷадвал, O(1)) бозаро ба зердарахтҳои чап ва рост тақсим мекунад.
// Аввал зердарахти чап, баъд рост бо рекурсия сохта мешавад.
// Мураккабӣ: вақт O(n), хотира O(n).

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

// Дарахтро ба тартиби сатҳӣ табдил медиҳад (холӣ-ҳои охир бурида мешаванд)
функсия баСатҳӣ(реша: ГиреҳиДарахт | холӣ): (рақам | холӣ)[] {
    собит натиҷа: (рақам | холӣ)[] = [];
    собит навбат: (ГиреҳиДарахт | холӣ)[] = [реша];
    барои (тағ и = 0; и < навбат.дарозӣ; и++) {
        собит гиреҳ = навбат[и];
        агар (гиреҳ === холӣ) {
            натиҷа.илова(холӣ);
        } вагарна {
            натиҷа.илова(гиреҳ.қимат);
            навбат.илова(гиреҳ.чап);
            навбат.илова(гиреҳ.рост);
        }
    }
    то (натиҷа.дарозӣ > 0 && натиҷа[натиҷа.дарозӣ - 1] === холӣ) {
        натиҷа.баровардан();
    }
    бозгашт натиҷа;
}

функсия сохтанАзПешВаМобайн(пешТартиб: рақам[], мобайнӣ: рақам[]): ГиреҳиДарахт | холӣ {
    собит мавқеъ = нав Map<рақам, рақам>();
    барои (тағ и = 0; и < мобайнӣ.дарозӣ; и++) {
        мавқеъ.гузоштан(мобайнӣ[и], и);
    }
    тағ индексиПеш = 0;

    функсия бисоз(аввал: рақам, охир: рақам): ГиреҳиДарахт | холӣ {
        агар (аввал > охир) {
            бозгашт холӣ;
        }
        собит қиматиРеша = пешТартиб[индексиПеш];
        индексиПеш++;
        собит гиреҳ = нав ГиреҳиДарахт(қиматиРеша);
        собит м = мавқеъ.бозгирифтан(қиматиРеша) ?? -1;
        гиреҳ.чап = бисоз(аввал, м - 1);
        гиреҳ.рост = бисоз(м + 1, охир);
        бозгашт гиреҳ;
    }

    бозгашт бисоз(0, мобайнӣ.дарозӣ - 1);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", баСатҳӣ(сохтанАзПешВаМобайн([3, 9, 20, 15, 7], [9, 3, 15, 20, 7])), [3, 9, 20, холӣ, холӣ, 15, 7]);
санҷ("мисол 2", баСатҳӣ(сохтанАзПешВаМобайн([-1], [-1])), [-1]);
санҷ("танҳо чап", баСатҳӣ(сохтанАзПешВаМобайн([1, 2, 3], [3, 2, 1])), [1, 2, холӣ, 3]);
санҷ("танҳо рост", баСатҳӣ(сохтанАзПешВаМобайн([1, 2, 3], [1, 2, 3])), [1, холӣ, 2, холӣ, 3]);
санҷ("дарахти пурра", баСатҳӣ(сохтанАзПешВаМобайн([1, 2, 4, 5, 3, 6, 7], [4, 2, 5, 1, 6, 3, 7])), [1, 2, 3, 4, 5, 6, 7]);
санҷ("зигзаг", баСатҳӣ(сохтанАзПешВаМобайн([1, 2, 3, 4], [2, 4, 3, 1])), [1, 2, холӣ, холӣ, 3, 4]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
