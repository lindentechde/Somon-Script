// 189. Гардонидани рӯйхат (Rotate Array)
// https://leetcode.com/problems/rotate-array/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳоро k қадам ба тарафи рост гардонед (k ≥ 0).
// Тағйирот бояд дар худи рӯйхат (in-place) анҷом дода шавад.
//
// Усул: Се маротиба чаппа кардан (reversal). Аввал тамоми рӯйхатро чаппа
// мекунем, баъд k унсури аввал ва n - k унсури боқимондаро алоҳида чаппа
// мекунем. Пеш аз ин k = k mod n.
// Мураккабӣ: вақт O(n), хотираи иловагӣ O(1).

функсия чаппаКардан(рақамҳо: рақам[], чап: рақам, рост: рақам): беджавоб {
    то (чап < рост) {
        собит муваққатӣ = рақамҳо[чап];
        рақамҳо[чап] = рақамҳо[рост];
        рақамҳо[рост] = муваққатӣ;
        чап++;
        рост--;
    }
}

функсия гардонидан(рақамҳо: рақам[], к: рақам): беджавоб {
    собит н = рақамҳо.дарозӣ;
    агар (н === 0) {
        бозгашт;
    }
    собит қадам = к % н;
    чаппаКардан(рақамҳо, 0, н - 1);
    чаппаКардан(рақамҳо, 0, қадам - 1);
    чаппаКардан(рақамҳо, қадам, н - 1);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия гардонидаШуда(рақамҳо: рақам[], к: рақам): рақам[] {
    гардонидан(рақамҳо, к);
    бозгашт рақамҳо;
}

санҷ("мисол 1", гардонидаШуда([1, 2, 3, 4, 5, 6, 7], 3), [5, 6, 7, 1, 2, 3, 4]);
санҷ("мисол 2", гардонидаШуда([-1, -100, 3, 99], 2), [3, 99, -1, -100]);
санҷ("k = 0", гардонидаШуда([1, 2, 3], 0), [1, 2, 3]);
санҷ("k = n", гардонидаШуда([1, 2, 3], 3), [1, 2, 3]);
санҷ("k > n", гардонидаШуда([1, 2, 3], 4), [3, 1, 2]);
санҷ("як унсур", гардонидаШуда([7], 5), [7]);
санҷ("ду унсур", гардонидаШуда([1, 2], 1), [2, 1]);

// Санҷиши дар-ҷой: худи рӯйхати додашуда тағйир меёбад.
собит рӯйхатиАслӣ = [1, 2, 3, 4, 5, 6];
гардонидан(рӯйхатиАслӣ, 4);
санҷ("дар ҷой (in-place)", рӯйхатиАслӣ, [3, 4, 5, 6, 1, 2]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
