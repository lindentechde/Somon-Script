// 139. Ҷудо кардани калимаҳо (Word Break)
// https://leetcode.com/problems/word-break/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сатри s ва луғати wordDict дода шудаанд. Муайян кунед, ки оё s-ро
// ба пайдарпаии як ё якчанд калимаи луғат ҷудо кардан мумкин аст. Ҳар
// калимаро якчанд бор истифода бурдан мумкин аст.
//
// Усул: Барномасозии динамикӣ — мумкин[и] = дуруст, агар пешванди s[0..и)
// ба калимаҳо ҷудо шавад. мумкин[и] = мумкин[ҷ] && s[ҷ..и) дар луғат.
// Калимаҳоро дар Set нигоҳ медорем ва ҷ-ро бо дарозии калонтарин калима
// маҳдуд мекунем.
// Мураккабӣ: вақт O(n · L · L), хотира O(n + луғат), L — дарозии калонтарин калима.

функсия ҷудоКарданиКалимаҳо(матн: сатр, луғат: сатр[]): мантиқӣ {
    собит калимаҳо = нав Set<сатр>(луғат);
    тағ дарозииАксар: рақам = 0;
    барои (собит калима аз луғат) {
        дарозииАксар = Риёзӣ.ҳаддиАксар(дарозииАксар, калима.дарозӣ);
    }
    собит н = матн.дарозӣ;
    собит мумкин: мантиқӣ[] = нав рӯйхат(н + 1).пурКардан(нодуруст);
    мумкин[0] = дуруст;
    барои (тағ и = 1; и <= н; и++) {
        барои (тағ ҷ = и - 1; ҷ >= 0 && и - ҷ <= дарозииАксар; ҷ--) {
            агар (мумкин[ҷ] && калимаҳо.дорадКалид(матн.қисмат(ҷ, и))) {
                мумкин[и] = дуруст;
                шикастан;
            }
        }
    }
    бозгашт мумкин[н];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷудоКарданиКалимаҳо("leetcode", ["leet", "code"]), дуруст);
санҷ("мисол 2", ҷудоКарданиКалимаҳо("applepenapple", ["apple", "pen"]), дуруст);
санҷ("мисол 3", ҷудоКарданиКалимаҳо("catsandog", ["cats", "dog", "sand", "and", "cat"]), нодуруст);
санҷ("як ҳарф", ҷудоКарданиКалимаҳо("a", ["a"]), дуруст);
санҷ("бақияи ҷудонашаванда", ҷудоКарданиКалимаҳо("ab", ["a"]), нодуруст);
санҷ("бозгашт ба ҷудокунии дигар", ҷудоКарданиКалимаҳо("cars", ["car", "ca", "rs"]), дуруст);
санҷ(
    "сатри дароз бе ҷавоб",
    ҷудоКарданиКалимаҳо("a".такрор(150) + "b", ["a", "aa", "aaa", "aaaa", "aaaaa"]),
    нодуруст
);
санҷ("калимаҳои тоҷикӣ", ҷудоКарданиКалимаҳо("саломдунё", ["салом", "дунё"]), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
