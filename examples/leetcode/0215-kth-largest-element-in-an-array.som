// 215. K-умин бузургтарин унсур дар рӯйхат (Kth Largest Element in an Array)
// https://leetcode.com/problems/kth-largest-element-in-an-array/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳо ва адади k дода шудааст. K-умин бузургтарин унсурро
// (дар тартиби мураттаб, на k-умин унсури гуногун) баргардонед.
//
// Усул: Интихоби тез (quickselect) бо такягоҳи тасодуфӣ ва тақсими сеқисма
// (Dutch national flag): хурдтар | баробар | калонтар аз такягоҳ. Сипас танҳо
// ба он қисме меравем, ки индекси ҷустуҷӯшаванда (n - k) дар он аст. Тақсими
// сеқисма рӯйхатҳои пур аз такрорро ҳам зуд коркард мекунад.
// Мураккабӣ: вақт O(n) ба ҳисоби миёна (бадтарин O(n²)), хотира O(n) барои нусха.

функсия бузургтариниК(рақамҳо: рақам[], к: рақам): рақам {
    собит р = рақамҳо.буридан();
    собит ҳадаф = р.дарозӣ - к;
    тағ чап = 0;
    тағ рост = р.дарозӣ - 1;
    то (чап < рост) {
        собит такягоҳ = р[чап + Риёзӣ.поён(Риёзӣ.тасодуфӣ() * (рост - чап + 1))];
        // [чап, кам) < такягоҳ, [кам, ҷорӣ) = такягоҳ, (зиёд, рост] > такягоҳ
        тағ кам = чап;
        тағ ҷорӣ = чап;
        тағ зиёд = рост;
        то (ҷорӣ <= зиёд) {
            агар (р[ҷорӣ] < такягоҳ) {
                [р[кам], р[ҷорӣ]] = [р[ҷорӣ], р[кам]];
                кам++;
                ҷорӣ++;
            } вагарна агар (р[ҷорӣ] > такягоҳ) {
                [р[ҷорӣ], р[зиёд]] = [р[зиёд], р[ҷорӣ]];
                зиёд--;
            } вагарна {
                ҷорӣ++;
            }
        }
        агар (ҳадаф < кам) {
            рост = кам - 1;
        } вагарна агар (ҳадаф > зиёд) {
            чап = зиёд + 1;
        } вагарна {
            бозгашт такягоҳ;
        }
    }
    бозгашт р[ҳадаф];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", бузургтариниК([3, 2, 1, 5, 6, 4], 2), 5);
санҷ("мисол 2", бузургтариниК([3, 2, 3, 1, 2, 4, 5, 5, 6], 4), 4);
санҷ("як унсур", бузургтариниК([1], 1), 1);
санҷ("манфӣ ва такрор", бузургтариниК([-1, -1], 2), -1);
санҷ("хурдтарин (k = n)", бузургтариниК([7, 6, 5, 4, 3, 2, 1], 7), 1);
санҷ("бузургтарин (k = 1)", бузургтариниК([2, 1], 1), 2);

// Рӯйхати калон: ҷойивазкунии 0..10006 (10007 — адади содда)
собит омехта: рақам[] = рӯйхат.аз({ length: 10007 }, (_: ҳар, и: рақам) => (и * 7919) % 10007);
санҷ("рӯйхати калон", бузургтариниК(омехта, 100), 9907);
собит якхелаҳо: рақам[] = нав рӯйхат(50000).пурКардан(1);
санҷ("50000 унсури якхела", бузургтариниК(якхелаҳо, 25000), 1);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
