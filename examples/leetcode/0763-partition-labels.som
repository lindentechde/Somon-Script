// 763. Тақсимоти нишонаҳо (Partition Labels)
// https://leetcode.com/problems/partition-labels/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сатри s-ро ба ҳарчи бештар қисмҳо тақсим кунед, ба тавре ки ҳар ҳарф
// танҳо дар як қисм ояд. Рӯйхати дарозии қисмҳоро (бо тартиби онҳо) баргардонед.
//
// Усул: Ҳарисона (greedy) — аввал индекси охирини ҳар ҳарфро ёбем. Сипас сатрро
// гузашта, охири қисми ҷориро ҳамчун ҳадди аксари индексҳои охирини ҳарфҳои
// дидашуда нигоҳ медорем; вақте индекси ҷорӣ ба он мерасад, қисм пӯшида мешавад.
// Мураккабӣ: вақт O(n), хотира O(1) (26 ҳарф).

функсия тақсимотиНишонаҳо(с: сатр): рақам[] {
    собит охирин: рақам[] = нав рӯйхат(26).пурКардан(-1);
    барои (тағ и = 0; и < с.дарозӣ; и++) {
        охирин[с.кодиАломатДар(и) - 97] = и;
    }
    собит натиҷа: рақам[] = [];
    тағ оғоз = 0;
    тағ анҷом = 0;
    барои (тағ и = 0; и < с.дарозӣ; и++) {
        анҷом = Риёзӣ.ҳаддиАксар(анҷом, охирин[с.кодиАломатДар(и) - 97]);
        агар (и === анҷом) {
            натиҷа.илова(анҷом - оғоз + 1);
            оғоз = и + 1;
        }
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", тақсимотиНишонаҳо("ababcbacadefegdehijhklij"), [9, 7, 8]);
санҷ("мисол 2", тақсимотиНишонаҳо("eccbbbbdec"), [10]);
санҷ("як ҳарф", тақсимотиНишонаҳо("a"), [1]);
санҷ("ҳама гуногун", тақсимотиНишонаҳо("abc"), [1, 1, 1]);
санҷ("ҳама якхела", тақсимотиНишонаҳо("aaaa"), [4]);
санҷ("қисми охирини якҳарфа", тақсимотиНишонаҳо("abac"), [3, 1]);
санҷ("қисми аввали якҳарфа", тақсимотиНишонаҳо("caedbdedda"), [1, 9]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
