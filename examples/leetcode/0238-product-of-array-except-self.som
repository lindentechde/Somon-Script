// 238. Ҳосили зарби рӯйхат ба ғайр аз худ (Product of Array Except Self)
// https://leetcode.com/problems/product-of-array-except-self/
// Сатҳ: Миёна (Medium)
//
// Шарт: Барои рӯйхати рақамҳо рӯйхати ҷавобе созед, ки ҷавоб[и] ба ҳосили
// зарби ҳамаи унсурҳо ба ғайр аз рақамҳо[и] баробар аст. Тақсимро истифода
// набаред; алгоритм бояд дар вақти O(n) кор кунад.
//
// Усул: Ду гузар. Аввал ба ҷавоб[и] ҳосили зарби ҳамаи унсурҳои чапи и-ро
// (префикс) менависем, баъд аз рост ба чап гузашта, онро ба ҳосили зарби
// унсурҳои рост (суффикс) зарб мекунем.
// Мураккабӣ: вақт O(n), хотираи иловагӣ O(1) (ба ғайр аз рӯйхати ҷавоб).

функсия ҳосилиҒайрАзХуд(рақамҳо: рақам[]): рақам[] {
    собит н = рақамҳо.дарозӣ;
    собит ҷавоб: рақам[] = нав рӯйхат(н).пурКардан(1);
    тағ префикс = 1;
    барои (тағ и = 0; и < н; и++) {
        ҷавоб[и] = префикс;
        префикс *= рақамҳо[и];
    }
    тағ суффикс = 1;
    барои (тағ и = н - 1; и >= 0; и--) {
        ҷавоб[и] *= суффикс;
        суффикс *= рақамҳо[и];
    }
    бозгашт ҷавоб;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Эзоҳ: JSON.stringify(-0) "0" медиҳад, бинобар ин -0 ва 0 баробар ҳисобида мешаванд.
санҷ("мисол 1", ҳосилиҒайрАзХуд([1, 2, 3, 4]), [24, 12, 8, 6]);
санҷ("мисол 2", ҳосилиҒайрАзХуд([-1, 1, 0, -3, 3]), [0, 0, 9, 0, 0]);
санҷ("ду унсур", ҳосилиҒайрАзХуд([3, 5]), [5, 3]);
санҷ("ду сифр", ҳосилиҒайрАзХуд([0, 4, 0, 2]), [0, 0, 0, 0]);
санҷ("як сифр", ҳосилиҒайрАзХуд([2, 0, 5]), [0, 10, 0]);
санҷ("манфӣ", ҳосилиҒайрАзХуд([-2, -3, 4]), [-12, -8, 6]);
санҷ("такрорӣ", ҳосилиҒайрАзХуд([2, 2, 2, 2, 2]), [16, 16, 16, 16, 16]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
