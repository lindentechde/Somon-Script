// 142. Давр дар рӯйхати пайваст II (Linked List Cycle II)
// https://leetcode.com/problems/linked-list-cycle-ii/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сари рӯйхати пайваст дода шудааст. Гиреҳеро баргардонед, ки давр аз
// он сар мешавад; агар давр набошад — холӣ. Рӯйхат набояд тағйир ёбад.
//
// Усул: Алгоритми Флойд. Аввал суст (1 қадам) ва тез (2 қадам) дар дохили
// давр вомехӯранд. Масофа аз сар то оғози давр ба масофа аз ҷои вохӯрӣ то
// оғози давр (бо гардишҳои пурра) баробар аст, бинобар ин як ишорагарро ба
// сар бурда, ҳардуро якқадамӣ пеш мебарем — онҳо дар оғози давр вомехӯранд.
// Мураккабӣ: вақт O(n), хотира O(1).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

функсия оғозиДавр(сар: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    тағ суст = сар;
    тағ тез = сар;
    то (суст !== холӣ && тез !== холӣ && тез.навбатӣ !== холӣ) {
        суст = суст.навбатӣ;
        тез = тез.навбатӣ.навбатӣ;
        агар (суст === тез) {
            // Вохӯрӣ дар дохили давр: аз сар ва аз ҷои вохӯрӣ якқадамӣ меравем
            тағ азСар = сар;
            то (азСар !== суст && азСар !== холӣ && суст !== холӣ) {
                азСар = азСар.навбатӣ;
                суст = суст.навбатӣ;
            }
            бозгашт азСар;
        }
    }
    бозгашт холӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Рӯйхат месозад, думашро ба гиреҳи индекси `мавқеъ` мепайвандад (мавқеъ = -1 —
// давр нест) ва индекси гиреҳи баргардондаи оғозиДавр-ро медиҳад (-1 — холӣ).
// Инчунин месанҷад, ки рӯйхат тағйир наёфтааст.
функсия индексиОғоз(рақамҳо: рақам[], мавқеъ: рақам): рақам {
    собит сар = рӯйхатиПайваст(рақамҳо);
    собит гиреҳҳо: ГиреҳиРӯйхат[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        гиреҳҳо.илова(ҷорӣ);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    агар (мавқеъ >= 0) {
        гиреҳҳо[гиреҳҳо.дарозӣ - 1].навбатӣ = гиреҳҳо[мавқеъ];
    }

    собит натиҷа = оғозиДавр(сар);

    барои (тағ и = 0; и < гиреҳҳо.дарозӣ; и++) {
        собит интизорӣ = и + 1 < гиреҳҳо.дарозӣ ? гиреҳҳо[и + 1] : (мавқеъ >= 0 ? гиреҳҳо[мавқеъ] : холӣ);
        агар (гиреҳҳо[и].навбатӣ !== интизорӣ) {
            партофтан нав Хато("рӯйхат тағйир ёфт");
        }
    }
    бозгашт натиҷа === холӣ ? -1 : гиреҳҳо.индекси(натиҷа);
}

санҷ("мисол 1", индексиОғоз([3, 2, 0, -4], 1), 1);
санҷ("мисол 2", индексиОғоз([1, 2], 0), 0);
санҷ("мисол 3", индексиОғоз([1], -1), -1);
санҷ("рӯйхати холӣ", индексиОғоз([], -1), -1);
санҷ("як гиреҳ ба худаш", индексиОғоз([1], 0), 0);
санҷ("дум ба худаш", индексиОғоз([1, 2, 3, 4, 5], 4), 4);
санҷ("қиматҳои такрорӣ", индексиОғоз([7, 7, 7, 7, 7, 7], 3), 3);
санҷ("бе давр", индексиОғоз([1, 2, 3, 4], -1), -1);

собит дароз = рӯйхат.аз({ length: 10000 }, (_: ҳар, и: рақам) => и);
санҷ("рӯйхати дароз — давр дар охир", индексиОғоз(дароз, 9999), 9999);
санҷ("рӯйхати дароз — давр дар миёна", индексиОғоз(дароз, 1234), 1234);
санҷ("рӯйхати дароз — давр аз сар", индексиОғоз(дароз, 0), 0);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
