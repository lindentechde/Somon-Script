// 739. Ҳарорати рӯзона (Daily Temperatures)
// https://leetcode.com/problems/daily-temperatures/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати ҳарорати ҳаррӯза дода шудааст. Барои ҳар рӯз ёбед, ки баъд аз
// чанд рӯз ҳарорати гармтар меояд. Агар чунин рӯз набошад, 0 гузоред.
//
// Усул: Стеки монотонӣ (monotonic stack) — индексҳои рӯзҳое, ки ҳанӯз рӯзи
// гармтар наёфтаанд, бо ҳарорати камшаванда нигоҳ дошта мешаванд. Ҳар рӯзи нав
// ҳамаи рӯзҳои сардтари болои стекро "ҳал" мекунад.
// Мураккабӣ: вақт O(n), хотира O(n).

функсия ҳароратиРӯзона(ҳароратҳо: рақам[]): рақам[] {
    собит н = ҳароратҳо.дарозӣ;
    собит ҷавоб: рақам[] = нав рӯйхат(н).пурКардан(0);
    собит стек: рақам[] = [];
    барои (тағ и = 0; и < н; и++) {
        то (стек.дарозӣ > 0 && ҳароратҳо[стек[стек.дарозӣ - 1]] < ҳароратҳо[и]) {
            собит рӯз = стек.баровардан() ?? 0;
            ҷавоб[рӯз] = и - рӯз;
        }
        стек.илова(и);
    }
    бозгашт ҷавоб;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҳароратиРӯзона([73, 74, 75, 71, 69, 72, 76, 73]), [1, 1, 4, 2, 1, 1, 0, 0]);
санҷ("мисол 2", ҳароратиРӯзона([30, 40, 50, 60]), [1, 1, 1, 0]);
санҷ("мисол 3", ҳароратиРӯзона([30, 60, 90]), [1, 1, 0]);
санҷ("як рӯз", ҳароратиРӯзона([50]), [0]);
санҷ("камшаванда", ҳароратиРӯзона([80, 70, 60]), [0, 0, 0]);
санҷ("ҳарорати баробар", ҳароратиРӯзона([70, 70, 70]), [0, 0, 0]);
санҷ("баробарҳо пеш аз гармтар", ҳароратиРӯзона([55, 50, 50, 60]), [3, 2, 1, 0]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
