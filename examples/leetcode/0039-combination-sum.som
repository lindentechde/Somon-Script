// 39. Ҷамъи омезишҳо (Combination Sum)
// https://leetcode.com/problems/combination-sum/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳои мусбати гуногун (candidates) ва ҳадаф (target) дода
// шудаанд. Ҳамаи омезишҳои беназиреро ёбед, ки ҷамъашон ба ҳадаф баробар аст.
// Ҳар рақамро беҳад бор истифода бурдан мумкин аст; ду омезиш гуногунанд, агар
// ақаллан басомади як рақам фарқ кунад. Тартиб аҳамият надорад.
//
// Усул: Бозгашт (backtracking) бо рақамҳои мураттаб: аз индекси оғоз ба пеш
// рақам интихоб карда (ҳамон индексро боз иҷозат медиҳем — истифодаи такрорӣ),
// бақияро кам мекунем. Вақте ки рақам аз бақия калон шуд, давом намедиҳем
// (буридани шохаҳо), чунки рақамҳои баъдӣ боз ҳам калонтаранд.
// Мураккабӣ: вақт O(n^(T/m + 1)) (T — ҳадаф, m — рақами хурдтарин),
// хотира O(T/m) барои умқи рекурсия (бе ҳисоби ҷавоб).

функсия ҷамъиОмезишҳо(номзадҳо: рақам[], ҳадаф: рақам): рақам[][] {
    собит мураттаб = номзадҳо.буридан().тартиб((а: рақам, б: рақам) => а - б);
    собит натиҷа: рақам[][] = [];
    собит роҳ: рақам[] = [];

    функсия бозгаштӣ(оғоз: рақам, бақия: рақам): беджавоб {
        агар (бақия === 0) {
            натиҷа.илова(роҳ.буридан());
            бозгашт;
        }
        барои (тағ и = оғоз; и < мураттаб.дарозӣ && мураттаб[и] <= бақия; и++) {
            роҳ.илова(мураттаб[и]);
            бозгаштӣ(и, бақия - мураттаб[и]);
            роҳ.баровардан();
        }
    }

    бозгаштӣ(0, ҳадаф);
    бозгашт натиҷа;
}

// ---- Ёрирасон барои санҷиш: ҳар омезиш ва худи рӯйхат мураттаб ----
функсия муқоисаиРӯйхатҳо(а: рақам[], б: рақам[]): рақам {
    собит н = Риёзӣ.ҳаддиАқал(а.дарозӣ, б.дарозӣ);
    барои (тағ и = 0; и < н; и++) {
        агар (а[и] !== б[и]) {
            бозгашт а[и] - б[и];
        }
    }
    бозгашт а.дарозӣ - б.дарозӣ;
}

функсия мураттабСоз(рӯйхатҳо: рақам[][]): рақам[][] {
    бозгашт рӯйхатҳо
        .харита((р: рақам[]) => р.буридан().тартиб((а: рақам, б: рақам) => а - б))
        .тартиб(муқоисаиРӯйхатҳо);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", мураттабСоз(ҷамъиОмезишҳо([2, 3, 6, 7], 7)), мураттабСоз([[2, 2, 3], [7]]));
санҷ("мисол 2", мураттабСоз(ҷамъиОмезишҳо([2, 3, 5], 8)),
    мураттабСоз([[2, 2, 2, 2], [2, 3, 3], [3, 5]]));
санҷ("мисол 3", ҷамъиОмезишҳо([2], 1), []);
санҷ("як рақам, такрори он", ҷамъиОмезишҳо([1], 2), [[1, 1]]);
санҷ("рақам баробари ҳадаф", ҷамъиОмезишҳо([5], 5), [[5]]);
санҷ("номзадҳои номураттаб", мураттабСоз(ҷамъиОмезишҳо([7, 3, 2, 6], 7)), мураттабСоз([[2, 2, 3], [7]]));
санҷ("ҳама калонтар аз ҳадаф", ҷамъиОмезишҳо([8, 9, 10], 7), []);
санҷ("[3, 4, 5] → 12", мураттабСоз(ҷамъиОмезишҳо([3, 4, 5], 12)),
    мураттабСоз([[3, 3, 3, 3], [3, 4, 5], [4, 4, 4]]));
// Шумораи омезишҳо бо барномарезии динамикӣ санҷида шудааст
санҷ("[2, 3, 5, 7] → 30 (шумора)", ҷамъиОмезишҳо([2, 3, 5, 7], 30).дарозӣ, 45);
санҷ("[1, 2] → 10 (шумора)", ҷамъиОмезишҳо([1, 2], 10).дарозӣ, 6);
собит вуруд = [7, 3, 2];
ҷамъиОмезишҳо(вуруд, 7);
санҷ("вуруд тағйир наёфт", вуруд, [7, 3, 2]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
