// 45. Бозии ҷаҳиш II (Jump Game II)
// https://leetcode.com/problems/jump-game-ii/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳо дода шудааст; аз индекси 0 сар мекунем ва ҳар унсур
// дарозии ҳадди аксари ҷаҳишро нишон медиҳад. Шумораи камтарини ҷаҳишҳоро то
// индекси охирин ёбед (кафолат дода мешавад, ки расидан мумкин аст).
//
// Усул: Ҳарисона (greedy, ба монанди BFS аз рӯи сатҳҳо) — "охири ҷаҳиши ҷорӣ"
// ва "дуртарин"-и дастрасро нигоҳ медорем. Вақте ба охири ҷаҳиши ҷорӣ мерасем,
// ҷаҳиши навро ҳисоб карда, сарҳадро ба дуртарин мебарем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия камтаринҶаҳишҳо(рақамҳо: рақам[]): рақам {
    тағ ҷаҳишҳо = 0;
    тағ охириҶорӣ = 0;
    тағ дуртарин = 0;
    барои (тағ и = 0; и < рақамҳо.дарозӣ - 1; и++) {
        дуртарин = Риёзӣ.ҳаддиАксар(дуртарин, и + рақамҳо[и]);
        агар (и === охириҶорӣ) {
            ҷаҳишҳо++;
            охириҶорӣ = дуртарин;
            агар (охириҶорӣ >= рақамҳо.дарозӣ - 1) {
                шикастан;
            }
        }
    }
    бозгашт ҷаҳишҳо;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", камтаринҶаҳишҳо([2, 3, 1, 1, 4]), 2);
санҷ("мисол 2", камтаринҶаҳишҳо([2, 3, 0, 1, 4]), 2);
санҷ("як унсур", камтаринҶаҳишҳо([0]), 0);
санҷ("ду унсур", камтаринҶаҳишҳо([1, 2]), 1);
санҷ("як ҷаҳиши калон", камтаринҶаҳишҳо([5, 1, 1, 1, 1, 1]), 1);
санҷ("ҷаҳиши дурт беҳтар нест", камтаринҶаҳишҳо([1, 2, 1, 1, 1]), 3);
собит якҳо: рақам[] = нав рӯйхат(10000).пурКардан(1);
санҷ("10000 яка", камтаринҶаҳишҳо(якҳо), 9999);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
