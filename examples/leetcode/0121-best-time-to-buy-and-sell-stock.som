// 121. Вақти беҳтарин барои харидан ва фурӯхтани саҳмия (Best Time to Buy and Sell Stock)
// https://leetcode.com/problems/best-time-to-buy-and-sell-stock/
// Сатҳ: Осон (Easy)
//
// Шарт: Нархи саҳмия барои ҳар рӯз дода шудааст. Як рӯз харида, дар яке аз
// рӯзҳои баъдӣ фурӯхтан мумкин аст. Фоидаи ҳадди аксарро баргардонед; агар
// фоида ба даст наояд, 0.
//
// Усул: Як гузар — нархи ҳадди ақали то ҳол дидашударо нигоҳ медорем ва барои
// ҳар рӯз фоидаи "имрӯз фурӯхтан"-ро бо беҳтарин муқоиса мекунем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия фоидаиБеҳтарин(нархҳо: рақам[]): рақам {
    тағ арзонтарин = Infinity;
    тағ беҳтарин = 0;
    барои (собит нарх аз нархҳо) {
        агар (нарх < арзонтарин) {
            арзонтарин = нарх;
        } вагарна агар (нарх - арзонтарин > беҳтарин) {
            беҳтарин = нарх - арзонтарин;
        }
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", фоидаиБеҳтарин([7, 1, 5, 3, 6, 4]), 5);
санҷ("мисол 2", фоидаиБеҳтарин([7, 6, 4, 3, 1]), 0);
санҷ("як рӯз", фоидаиБеҳтарин([5]), 0);
санҷ("ду рӯз", фоидаиБеҳтарин([1, 2]), 1);
санҷ("ҳадди ақал пас аз ҳадди аксар", фоидаиБеҳтарин([2, 4, 1]), 2);
санҷ("нархҳои баробар", фоидаиБеҳтарин([3, 3, 3]), 0);
санҷ("ҳадди ақали нав фоидаи беҳтар намедиҳад", фоидаиБеҳтарин([3, 2, 6, 5, 0, 3]), 4);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
