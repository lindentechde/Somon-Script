// 2. Ҷамъи ду адад (Add Two Numbers)
// https://leetcode.com/problems/add-two-numbers/
// Сатҳ: Миёна (Medium)
//
// Шарт: Ду адади ғайриманфӣ ҳамчун рӯйхатҳои пайваст дода шудаанд; рақамҳо бо
// тартиби баръакс нигоҳ дошта мешаванд (аввал воҳидҳо) ва ҳар гиреҳ як рақам
// дорад. Ҷамъи ин ду ададро ҳамчун рӯйхати пайваст бо ҳамон тартиб баргардонед.
//
// Усул: Ҷамъи сутунӣ, мисли мактаб — рақамҳоро аз воҳидҳо сар карда ҷамъ
// мекунем ва "интиқол"-ро (carry) ба рақами навбатӣ мегузаронем.
// Мураккабӣ: вақт O(max(m, n)), хотира O(max(m, n)) барои натиҷа.

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

функсия ҷамъиДуАдад(рӯйхат1: ГиреҳиРӯйхат | холӣ, рӯйхат2: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    собит қалбакӣ = нав ГиреҳиРӯйхат(0);
    тағ дум = қалбакӣ;
    тағ а = рӯйхат1;
    тағ б = рӯйхат2;
    тағ интиқол = 0;
    то (а !== холӣ || б !== холӣ || интиқол > 0) {
        тағ ҳосил = интиқол;
        агар (а !== холӣ) {
            ҳосил += а.қимат;
            а = а.навбатӣ;
        }
        агар (б !== холӣ) {
            ҳосил += б.қимат;
            б = б.навбатӣ;
        }
        интиқол = Риёзӣ.поён(ҳосил / 10);
        собит гиреҳ = нав ГиреҳиРӯйхат(ҳосил % 10);
        дум.навбатӣ = гиреҳ;
        дум = гиреҳ;
    }
    бозгашт қалбакӣ.навбатӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия ҷамъ(а: рақам[], б: рақам[]): рақам[] {
    бозгашт баРақамҳо(ҷамъиДуАдад(рӯйхатиПайваст(а), рӯйхатиПайваст(б)));
}

// 342 + 465 = 807
санҷ("мисол 1", ҷамъ([2, 4, 3], [5, 6, 4]), [7, 0, 8]);
санҷ("мисол 2", ҷамъ([0], [0]), [0]);
// 9999999 + 9999 = 10009998
санҷ("мисол 3", ҷамъ([9, 9, 9, 9, 9, 9, 9], [9, 9, 9, 9]), [8, 9, 9, 9, 0, 0, 0, 1]);
санҷ("интиқол дар охир", ҷамъ([5], [5]), [0, 1]);
санҷ("дарозии гуногун", ҷамъ([1, 8], [0]), [1, 8]);
санҷ("бе интиқол", ҷамъ([1, 2, 3], [4, 5, 6]), [5, 7, 9]);

// Адади 60-рақама (аз Number.MAX_SAFE_INTEGER калонтар): (10^60 - 1) + 1 = 10^60
собит нӯҳҳо = нав рӯйхат(60).пурКардан(9);
собит сифрҳоВаЯк = нав рӯйхат(60).пурКардан(0).пайвастан([1]);
санҷ("адади хеле калон", ҷамъ(нӯҳҳо, [1]), сифрҳоВаЯк);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
