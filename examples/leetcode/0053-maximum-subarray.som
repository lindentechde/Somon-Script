// 53. Зеррӯйхати ҳадди аксар (Maximum Subarray)
// https://leetcode.com/problems/maximum-subarray/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дар рӯйхати рақамҳо зеррӯйхати пайвастаи ғайрихолиеро ёбед, ки
// ҷамъи унсурҳояш калонтарин аст, ва ҳамин ҷамъро баргардонед.
//
// Усул: Алгоритми Кадане (Kadane). Барои ҳар индекс беҳтарин ҷамъи
// зеррӯйхатеро, ки дар ҳамин индекс анҷом меёбад, ҳисоб мекунем: ё
// зеррӯйхати пештараро идома медиҳем, ё аз унсури ҷорӣ нав сар мекунем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия ҷамъиҲаддиАксар(рақамҳо: рақам[]): рақам {
    тағ ҷорӣ = рақамҳо[0];
    тағ беҳтарин = рақамҳо[0];
    барои (тағ и = 1; и < рақамҳо.дарозӣ; и++) {
        ҷорӣ = Риёзӣ.ҳаддиАксар(рақамҳо[и], ҷорӣ + рақамҳо[и]);
        беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, ҷорӣ);
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷамъиҲаддиАксар([-2, 1, -3, 4, -1, 2, 1, -5, 4]), 6);
санҷ("мисол 2", ҷамъиҲаддиАксар([1]), 1);
санҷ("мисол 3", ҷамъиҲаддиАксар([5, 4, -1, 7, 8]), 23);
санҷ("ҳама манфӣ", ҷамъиҲаддиАксар([-3, -1, -2]), -1);
санҷ("як унсури манфӣ", ҷамъиҲаддиАксар([-5]), -5);
санҷ("сифрҳо", ҷамъиҲаддиАксар([0, -1, 0, -2]), 0);
санҷ("ҷамъи пурра", ҷамъиҲаддиАксар([2, -1, 2, -1, 2]), 4);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
