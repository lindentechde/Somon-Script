// 19. Ҳазфи гиреҳи n-ум аз охири рӯйхат (Remove Nth Node From End of List)
// https://leetcode.com/problems/remove-nth-node-from-end-of-list/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сари рӯйхати пайваст ва адади n дода шудаанд. Гиреҳи n-умро аз охири
// рӯйхат ҳазф карда, сари рӯйхатро баргардонед (1 <= n <= дарозии рӯйхат).
//
// Усул: Як гузар бо ду ишорагар ва гиреҳи қалбакӣ (dummy). Ишорагари тезро
// n + 1 қадам пеш мебарем, баъд ҳардуро якҷоя то охир меронем — суст дар
// гиреҳи пеш аз гиреҳи ҳазфшаванда меистад.
// Мураккабӣ: вақт O(n), хотира O(1).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

функсия ҳазфиАзОхир(сар: ГиреҳиРӯйхат | холӣ, н: рақам): ГиреҳиРӯйхат | холӣ {
    собит қалбакӣ = нав ГиреҳиРӯйхат(0, сар);
    тағ тез: ГиреҳиРӯйхат | холӣ = қалбакӣ;
    тағ суст: ГиреҳиРӯйхат | холӣ = қалбакӣ;
    // Байни суст ва тез n гиреҳ меистад
    барои (тағ и = 0; и <= н && тез !== холӣ; и++) {
        тез = тез.навбатӣ;
    }
    то (тез !== холӣ && суст !== холӣ) {
        тез = тез.навбатӣ;
        суст = суст.навбатӣ;
    }
    // суст — гиреҳи пеш аз гиреҳи ҳазфшаванда
    агар (суст !== холӣ && суст.навбатӣ !== холӣ) {
        суст.навбатӣ = суст.навбатӣ.навбатӣ;
    }
    бозгашт қалбакӣ.навбатӣ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия ҳазф(рақамҳо: рақам[], н: рақам): рақам[] {
    бозгашт баРақамҳо(ҳазфиАзОхир(рӯйхатиПайваст(рақамҳо), н));
}

санҷ("мисол 1", ҳазф([1, 2, 3, 4, 5], 2), [1, 2, 3, 5]);
санҷ("мисол 2", ҳазф([1], 1), []);
санҷ("мисол 3", ҳазф([1, 2], 1), [1]);
санҷ("ҳазфи сар (ду гиреҳ)", ҳазф([1, 2], 2), [2]);
санҷ("ҳазфи сар", ҳазф([1, 2, 3, 4, 5], 5), [2, 3, 4, 5]);
санҷ("ҳазфи гиреҳи охир", ҳазф([1, 2, 3, 4, 5], 1), [1, 2, 3, 4]);
санҷ("қиматҳои такрорӣ", ҳазф([7, 7, 7, 7], 3), [7, 7, 7]);

собит дароз = рӯйхат.аз({ length: 30 }, (_: ҳар, и: рақам) => и + 1);
собит бидуниҲаждаҳ = дароз.филтр((қ: рақам) => қ !== 18);
санҷ("рӯйхати дароз (30, n = 13)", ҳазф(дароз, 13), бидуниҲаждаҳ);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
