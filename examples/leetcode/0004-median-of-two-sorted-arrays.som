// 4. Медианаи ду рӯйхати мураттаб (Median of Two Sorted Arrays)
// https://leetcode.com/problems/median-of-two-sorted-arrays/
// Сатҳ: Душвор (Hard)
//
// Шарт: Ду рӯйхати мураттаби а (андозаи m) ва б (андозаи n) дода шудаанд.
// Медианаи ҳамаи унсурҳои онҳоро ёбед. Вақт бояд O(log(m + n)) бошад.
//
// Усул: Ҷустуҷӯи дуӣ дар рӯйхати кӯтоҳтар барои ёфтани «буриш»: аз а
// и унсур ва аз б ҷ = (m + n + 1) / 2 - и унсурро ба нимаи чап мегирем.
// Буриш дуруст аст, агар а[и-1] <= б[ҷ] ва б[ҷ-1] <= а[и] бошад. Он гоҳ
// медиана аз калонтарини нимаи чап ва хурдтарини нимаи рост ҳисоб мешавад.
// Мураккабӣ: вақт O(log(min(m, n))), хотира O(1).

функсия медианаиДуРӯйхат(рӯйхат1: рақам[], рӯйхат2: рақам[]): рақам {
    // Ҷустуҷӯро дар рӯйхати кӯтоҳтар мебарем.
    агар (рӯйхат1.дарозӣ > рӯйхат2.дарозӣ) {
        бозгашт медианаиДуРӯйхат(рӯйхат2, рӯйхат1);
    }
    собит м = рӯйхат1.дарозӣ;
    собит н = рӯйхат2.дарозӣ;
    собит нимаиЧап = (м + н + 1) >> 1;
    тағ чап = 0;
    тағ рост = м;
    то (чап <= рост) {
        собит и = (чап + рост) >> 1;
        собит ҷ = нимаиЧап - и;
        собит чап1 = и > 0 ? рӯйхат1[и - 1] : -Infinity;
        собит рост1 = и < м ? рӯйхат1[и] : Infinity;
        собит чап2 = ҷ > 0 ? рӯйхат2[ҷ - 1] : -Infinity;
        собит рост2 = ҷ < н ? рӯйхат2[ҷ] : Infinity;
        агар (чап1 <= рост2 && чап2 <= рост1) {
            собит калонтариниЧап = Риёзӣ.ҳаддиАксар(чап1, чап2);
            агар ((м + н) % 2 === 1) {
                бозгашт калонтариниЧап;
            }
            собит хурдтариниРост = Риёзӣ.ҳаддиАқал(рост1, рост2);
            бозгашт (калонтариниЧап + хурдтариниРост) / 2;
        }
        агар (чап1 > рост2) {
            рост = и - 1;
        } вагарна {
            чап = и + 1;
        }
    }
    // Ба ин ҷо намерасем, агар рӯйхатҳо мураттаб бошанд.
    бозгашт 0;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", медианаиДуРӯйхат([1, 3], [2]), 2);
санҷ("мисол 2", медианаиДуРӯйхат([1, 2], [3, 4]), 2.5);
санҷ("рӯйхати якум холӣ", медианаиДуРӯйхат([], [1]), 1);
санҷ("рӯйхати дуюм холӣ", медианаиДуРӯйхат([2, 3], []), 2.5);
санҷ("якхела", медианаиДуРӯйхат([0, 0], [0, 0]), 0);
санҷ("бе омехташавӣ", медианаиДуРӯйхат([1, 2, 3], [4, 5, 6, 7]), 4);
санҷ("рақамҳои манфӣ", медианаиДуРӯйхат([-5, -3, -1], [-4, -2]), -3);
санҷ("андозаҳои гуногун", медианаиДуРӯйхат([3], [-2, -1]), -1);
санҷ("ду унсури якхела", медианаиДуРӯйхат([1, 1], [1, 2]), 1);
собит тоқҳо: рақам[] = рӯйхат.аз({ length: 500 }, (_: ҳар, и: рақам) => 2 * и + 1);
собит ҷуфтҳо: рақам[] = рӯйхат.аз({ length: 300 }, (_: ҳар, и: рақам) => 2 * и);
// Ҳамагӣ 800 унсур: 0..599 (ҳама) ва 601, 603, ..., 999. Медиана = (399 + 400) / 2.
санҷ("рӯйхатҳои калон", медианаиДуРӯйхат(тоқҳо, ҷуфтҳо), 399.5);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
