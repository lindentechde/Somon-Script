// 437. Ҷамъи роҳ III (Path Sum III)
// https://leetcode.com/problems/path-sum-iii/
// Сатҳ: Миёна (Medium)
//
// Шарт: Решаи дарахти дуӣ ва адади ҳадаф (targetSum) дода шудааст. Шумораи
// роҳҳоеро ёбед, ки ҷамъи қиматҳояшон ба ҳадаф баробар аст. Роҳ бояд аз
// гиреҳи дилхоҳ сар шуда, танҳо ба поён (аз падар ба фарзанд) равад.
//
// Усул: Ҷамъҳои пешванд (prefix sums) дар роҳи аз реша то гиреҳи ҷорӣ.
// Дар хеш-ҷадвал шумораи ҳар ҷамъи пешвандро нигоҳ медорем; барои гиреҳи
// ҷорӣ шумораи роҳҳо = шумораи пешвандҳои "ҷамъиҶорӣ - ҳадаф". Ҳангоми
// баргаштан аз рекурсия (backtracking) шумораро кам мекунем.
// Мураккабӣ: вақт O(n), хотира O(n).

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

функсия ҷамъиРоҳIII(реша: ГиреҳиДарахт | холӣ, ҳадаф: рақам): рақам {
    собит пешвандҳо = нав Map<рақам, рақам>();
    пешвандҳо.гузоштан(0, 1);

    функсия ҷустуҷӯ(гиреҳ: ГиреҳиДарахт | холӣ, ҷамъиПеш: рақам): рақам {
        агар (гиреҳ === холӣ) {
            бозгашт 0;
        }
        собит ҷамъиҶорӣ = ҷамъиПеш + гиреҳ.қимат;
        тағ шумора = пешвандҳо.бозгирифтан(ҷамъиҶорӣ - ҳадаф) ?? 0;

        пешвандҳо.гузоштан(ҷамъиҶорӣ, (пешвандҳо.бозгирифтан(ҷамъиҶорӣ) ?? 0) + 1);
        шумора += ҷустуҷӯ(гиреҳ.чап, ҷамъиҶорӣ);
        шумора += ҷустуҷӯ(гиреҳ.рост, ҷамъиҶорӣ);
        пешвандҳо.гузоштан(ҷамъиҶорӣ, (пешвандҳо.бозгирифтан(ҷамъиҶорӣ) ?? 0) - 1);

        бозгашт шумора;
    }

    бозгашт ҷустуҷӯ(реша, 0);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷамъиРоҳIII(сохтаниДарахт([10, 5, -3, 3, 2, холӣ, 11, 3, -2, холӣ, 1]), 8), 3);
санҷ("мисол 2", ҷамъиРоҳIII(сохтаниДарахт([5, 4, 8, 11, холӣ, 13, 4, 7, 2, холӣ, холӣ, 5, 1]), 22), 3);
санҷ("дарахти холӣ", ҷамъиРоҳIII(сохтаниДарахт([]), 0), 0);
санҷ("як гиреҳ", ҷамъиРоҳIII(сохтаниДарахт([1]), 1), 1);
санҷ("сифрҳо", ҷамъиРоҳIII(сохтаниДарахт([0, 1, 1]), 1), 4);
санҷ("манфӣ ва мусбат", ҷамъиРоҳIII(сохтаниДарахт([1, -2, -3, 1, 3, -2, холӣ, -1]), -1), 4);
санҷ(
    "қиматҳои калон",
    ҷамъиРоҳIII(сохтаниДарахт([1000000000, 1000000000, холӣ, 294967296, холӣ, 1000000000, холӣ, 1000000000, холӣ, 1000000000]), 0),
    0
);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
