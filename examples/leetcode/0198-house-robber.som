// 198. Дузди хонаҳо (House Robber)
// https://leetcode.com/problems/house-robber/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дар қатор хонаҳо ҷойгиранд, дар ҳар хона маблағи муайяни пул ҳаст.
// Аз ду хонаи ҳамсоя дар як шаб дуздӣ кардан мумкин нест. Ҳадди аксари
// маблағеро, ки бе вайрон кардани ин шарт гирифтан мумкин аст, ёбед.
//
// Усул: Барномасозии динамикӣ — беҳтарин(и) = max(беҳтарин(и-1),
// беҳтарин(и-2) + пул[и]). Танҳо ду қимати охиринро нигоҳ медорем.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия дуздӣ(пулҳо: рақам[]): рақам {
    тағ бидуниОхирин: рақам = 0; // беҳтарин то хонаи и-2
    тағ беҳтарин: рақам = 0; // беҳтарин то хонаи и-1
    барои (собит пул аз пулҳо) {
        собит ҷорӣ = Риёзӣ.ҳаддиАксар(беҳтарин, бидуниОхирин + пул);
        бидуниОхирин = беҳтарин;
        беҳтарин = ҷорӣ;
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дуздӣ([1, 2, 3, 1]), 4);
санҷ("мисол 2", дуздӣ([2, 7, 9, 3, 1]), 12);
санҷ("як хона", дуздӣ([5]), 5);
санҷ("ду хонаи дур аз ҳам", дуздӣ([2, 1, 1, 2]), 4);
санҷ("ҳама сифр", дуздӣ([0, 0, 0]), 0);
санҷ("канорҳо", дуздӣ([10, 1, 1, 10]), 20);
санҷ("рӯйхати холӣ", дуздӣ([]), 0);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
