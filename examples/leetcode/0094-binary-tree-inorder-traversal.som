// 94. Гузариши мобайнии дарахти дуӣ (Binary Tree Inorder Traversal)
// https://leetcode.com/problems/binary-tree-inorder-traversal/
// Сатҳ: Осон (Easy)
//
// Шарт: Решаи дарахти дуӣ дода шудааст. Қиматҳои гиреҳҳоро бо тартиби
// мобайнӣ (inorder: зердарахти чап, гиреҳ, зердарахти рост) баргардонед.
//
// Усул: Такрорӣ бо стек: то ҳадди охир ба чап мефуроем ва гиреҳҳоро ба стек
// мегузорем; баъд гиреҳро аз стек гирифта, қиматашро сабт мекунем ва ба
// зердарахти росташ мегузарем. Барои муқоиса варианти рекурсивӣ ҳам ҳаст.
// Мураккабӣ: вақт O(n), хотира O(h) (h — баландии дарахт).

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

// Варианти такрорӣ бо стек
функсия гузаришиМобайнӣ(реша: ГиреҳиДарахт | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    собит стек: ГиреҳиДарахт[] = [];
    тағ ҷорӣ: ГиреҳиДарахт | холӣ = реша;
    то (ҷорӣ !== холӣ || стек.дарозӣ > 0) {
        // То ҳадди охир ба чап мефуроем
        то (ҷорӣ !== холӣ) {
            стек.илова(ҷорӣ);
            ҷорӣ = ҷорӣ.чап;
        }
        собит гиреҳ = стек.баровардан();
        агар (гиреҳ === беқимат) {
            шикастан;
        }
        натиҷа.илова(гиреҳ.қимат);
        ҷорӣ = гиреҳ.рост;
    }
    бозгашт натиҷа;
}

// Варианти рекурсивӣ (барои муқоиса)
функсия гузаришиРекурсивӣ(реша: ГиреҳиДарахт | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    функсия гаштан(гиреҳ: ГиреҳиДарахт | холӣ): беджавоб {
        агар (гиреҳ === холӣ) {
            бозгашт;
        }
        гаштан(гиреҳ.чап);
        натиҷа.илова(гиреҳ.қимат);
        гаштан(гиреҳ.рост);
    }
    гаштан(реша);
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Ҳар ду вариантро месанҷад
функсия санҷиДарахт(ном: сатр, қиматҳо: (рақам | холӣ)[], интизорӣ: рақам[]): беджавоб {
    собит реша = сохтаниДарахт(қиматҳо);
    санҷ(ном, гузаришиМобайнӣ(реша), интизорӣ);
    санҷ(ном + " (рекурсивӣ)", гузаришиРекурсивӣ(реша), интизорӣ);
}

санҷиДарахт("мисол 1", [1, холӣ, 2, 3], [1, 3, 2]);
санҷиДарахт("мисол 2", [1, 2, 3, 4, 5, холӣ, 8, холӣ, холӣ, 6, 7, 9], [4, 2, 6, 5, 7, 1, 3, 9, 8]);
санҷиДарахт("мисол 3 (дарахти холӣ)", [], []);
санҷиДарахт("мисол 4 (як гиреҳ)", [1], [1]);
санҷиДарахт("танҳо ба чап", [3, 2, холӣ, 1], [1, 2, 3]);
санҷиДарахт("дарахти ҷустуҷӯ (BST) — мураттаб", [5, 3, 8, 1, 4, 7, 9, холӣ, 2], [1, 2, 3, 4, 5, 7, 8, 9]);
санҷиДарахт("манфӣ ва такрорӣ", [0, -1, -1], [-1, 0, -1]);

// Калон: занҷири 3000 гиреҳ танҳо ба чап (3000, 2999, ..., 1) — стек бояд кор кунад
тағ занҷир: ГиреҳиДарахт | холӣ = холӣ;
собит интизориЗанҷир: рақам[] = [];
барои (тағ и = 1; и <= 3000; и++) {
    занҷир = нав ГиреҳиДарахт(и, занҷир);
    интизориЗанҷир.илова(и);
}
санҷ("занҷири чапи 3000 гиреҳ", гузаришиМобайнӣ(занҷир), интизориЗанҷир);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
