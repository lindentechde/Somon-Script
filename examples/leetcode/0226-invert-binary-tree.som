// 226. Чаппа кардани дарахти дуӣ (Invert Binary Tree)
// https://leetcode.com/problems/invert-binary-tree/
// Сатҳ: Осон (Easy)
//
// Шарт: Решаи дарахти дуӣ дода шудааст. Дарахтро чаппа кунед (инъикоси
// оинавӣ): дар ҳар гиреҳ зердарахтҳои чап ва рост ҷой иваз мекунанд.
// Решаро баргардонед.
//
// Усул: Рекурсия (DFS): аввал ҳар ду зердарахтро чаппа мекунем, баъд
// онҳоро ҷой иваз мекунем. Барои муқоиса варианти такрорӣ бо навбат (BFS) ҳам ҳаст.
// Мураккабӣ: вақт O(n), хотира O(h) (h — баландии дарахт).

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

// Дарахтро ба тартиби сатҳӣ табдил медиҳад (холӣ-ҳои охир бурида мешаванд)
функсия баСатҳӣ(реша: ГиреҳиДарахт | холӣ): (рақам | холӣ)[] {
    собит натиҷа: (рақам | холӣ)[] = [];
    собит навбат: (ГиреҳиДарахт | холӣ)[] = [реша];
    барои (тағ и = 0; и < навбат.дарозӣ; и++) {
        собит гиреҳ = навбат[и];
        агар (гиреҳ === холӣ) {
            натиҷа.илова(холӣ);
        } вагарна {
            натиҷа.илова(гиреҳ.қимат);
            навбат.илова(гиреҳ.чап);
            навбат.илова(гиреҳ.рост);
        }
    }
    то (натиҷа.дарозӣ > 0 && натиҷа[натиҷа.дарозӣ - 1] === холӣ) {
        натиҷа.баровардан();
    }
    бозгашт натиҷа;
}

// Варианти рекурсивӣ
функсия чаппаКардан(реша: ГиреҳиДарахт | холӣ): ГиреҳиДарахт | холӣ {
    агар (реша === холӣ) {
        бозгашт холӣ;
    }
    собит чапиНав = чаппаКардан(реша.рост);
    собит ростиНав = чаппаКардан(реша.чап);
    реша.чап = чапиНав;
    реша.рост = ростиНав;
    бозгашт реша;
}

// Варианти такрорӣ бо навбат: дар ҳар гиреҳ кӯдаконро ҷой иваз мекунем
функсия чаппаКарданТакрорӣ(реша: ГиреҳиДарахт | холӣ): ГиреҳиДарахт | холӣ {
    агар (реша === холӣ) {
        бозгашт холӣ;
    }
    собит навбат: ГиреҳиДарахт[] = [реша];
    барои (тағ и = 0; и < навбат.дарозӣ; и++) {
        собит гиреҳ = навбат[и];
        собит муваққатӣ = гиреҳ.чап;
        гиреҳ.чап = гиреҳ.рост;
        гиреҳ.рост = муваққатӣ;
        агар (гиреҳ.чап !== холӣ) {
            навбат.илова(гиреҳ.чап);
        }
        агар (гиреҳ.рост !== холӣ) {
            навбат.илова(гиреҳ.рост);
        }
    }
    бозгашт реша;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Ҳар ду вариантро месанҷад
функсия санҷиДарахт(ном: сатр, қиматҳо: (рақам | холӣ)[], интизорӣ: (рақам | холӣ)[]): беджавоб {
    санҷ(ном, баСатҳӣ(чаппаКардан(сохтаниДарахт(қиматҳо))), интизорӣ);
    санҷ(ном + " (такрорӣ)", баСатҳӣ(чаппаКарданТакрорӣ(сохтаниДарахт(қиматҳо))), интизорӣ);
}

санҷиДарахт("мисол 1", [4, 2, 7, 1, 3, 6, 9], [4, 7, 2, 9, 6, 3, 1]);
санҷиДарахт("мисол 2", [2, 1, 3], [2, 3, 1]);
санҷиДарахт("мисол 3 (дарахти холӣ)", [], []);
санҷиДарахт("як гиреҳ", [1], [1]);
санҷиДарахт("танҳо кӯдаки чап", [1, 2], [1, холӣ, 2]);
санҷиДарахт("дарахти номутавозин", [1, 2, 3, 4], [1, 3, 2, холӣ, холӣ, холӣ, 4]);
санҷиДарахт(
    "бо холӣ дар байн ва манфӣ",
    [5, -3, 8, 1, 4, 7, 9, холӣ, -2],
    [5, 8, -3, 9, 7, 4, 1, холӣ, холӣ, холӣ, холӣ, холӣ, холӣ, -2]
);

// Калон: дарахти пурраи 1023 гиреҳ; ду бор чаппа кардан бояд дарахти аслиро диҳад
собит пурра: (рақам | холӣ)[] = [];
барои (тағ и = 1; и <= 1023; и++) {
    пурра.илова(и);
}
санҷ("ду бор чаппа = аслӣ (1023 гиреҳ)", баСатҳӣ(чаппаКардан(чаппаКардан(сохтаниДарахт(пурра)))), пурра);
// Як бор чаппа: ҳар сатҳ баръакс мешавад
собит интизориЧаппа: рақам[] = [];
барои (тағ сатҳ = 0; сатҳ < 10; сатҳ++) {
    собит оғоз = 2 ** сатҳ;
    барои (тағ к = 2 * оғоз - 1; к >= оғоз; к--) {
        интизориЧаппа.илова(к);
    }
}
санҷ("чаппаи дарахти пурра — сатҳҳо баръакс", баСатҳӣ(чаппаКарданТакрорӣ(сохтаниДарахт(пурра))), интизориЧаппа);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
