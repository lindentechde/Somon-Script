// 51. N малика (N-Queens)
// https://leetcode.com/problems/n-queens/
// Сатҳ: Душвор (Hard)
//
// Шарт: n маликаро дар тахтаи шоҳмоти n×n тавре ҷойгир кунед, ки ҳеҷ ду
// малика якдигарро зада натавонанд (дар як қатор, сутун ё диагонал набошанд).
// Ҳамаи ҳалҳои гуногунро баргардонед; дар ҳар ҳал 'Q' — малика, '.' — хонаи холӣ.
//
// Усул: Ақибгардӣ (backtracking) қатор ба қатор бо ниқобҳои битӣ (bitmask):
// сутунҳо, диагоналҳои «\» ва «/»-и бандшуда ҳар кадом як адади бутун аст.
// Хонаҳои озоди қатор = ҳама & ~(сутунҳо | диаг1 | диаг2); битҳои озодро
// аз хурдтарин (озод & -озод) сар карда яке-яке месанҷем. Ҳангоми гузаштан
// ба қатори навбатӣ диагоналҳо як бит ба чап ва рост мелағжанд.
// Мураккабӣ: вақт O(n!), хотира O(n) (бе ҳисоби ҷавоб).

функсия маликаҳо(н: рақам): сатр[][] {
    собит ҳалҳо: сатр[][] = [];
    // сутуниМалика[қ] — сутуни маликаи қатори қ.
    собит сутуниМалика: рақам[] = нав рӯйхат(н).пурКардан(0);
    собит ҳамаиСутунҳо = (1 << н) - 1;

    функсия сохтаниТахта(): сатр[] {
        собит тахта: сатр[] = [];
        барои (собит сутун аз сутуниМалика) {
            тахта.илова(".".такрор(сутун) + "Q" + ".".такрор(н - сутун - 1));
        }
        бозгашт тахта;
    }

    функсия ҷойгиркунӣ(қатор: рақам, сутунҳо: рақам, диаг1: рақам, диаг2: рақам): беджавоб {
        агар (қатор === н) {
            ҳалҳо.илова(сохтаниТахта());
            бозгашт;
        }
        тағ озод = ҳамаиСутунҳо & ~(сутунҳо | диаг1 | диаг2);
        то (озод !== 0) {
            собит бит = озод & -озод;
            озод ^= бит;
            сутуниМалика[қатор] = 31 - Риёзӣ.clz32(бит);
            ҷойгиркунӣ(қатор + 1, сутунҳо | бит, (диаг1 | бит) << 1, (диаг2 | бит) >> 1);
        }
    }

    ҷойгиркунӣ(0, 0, 0, 0);
    бозгашт ҳалҳо;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Тартиби ҳалҳо аҳамият надорад — ҳар ду тарафро мураттаб мекунем.
функсия мураттаб(ҳалҳо: сатр[][]): сатр[] {
    бозгашт ҳалҳо.харита((тахта: сатр[]) => JSON.stringify(тахта)).тартиб();
}

санҷ(
    "мисол 1 (n = 4)",
    мураттаб(маликаҳо(4)),
    мураттаб([
        [".Q..", "...Q", "Q...", "..Q."],
        ["..Q.", "Q...", "...Q", ".Q.."],
    ])
);
санҷ("мисол 2 (n = 1)", мураттаб(маликаҳо(1)), мураттаб([["Q"]]));
санҷ("n = 2, ҳал нест", маликаҳо(2), []);
санҷ("n = 3, ҳал нест", маликаҳо(3), []);
санҷ(
    "n = 6",
    мураттаб(маликаҳо(6)),
    мураттаб([
        [".Q....", "...Q..", ".....Q", "Q.....", "..Q...", "....Q."],
        ["..Q...", ".....Q", ".Q....", "....Q.", "Q.....", "...Q.."],
        ["...Q..", "Q.....", "....Q.", ".Q....", ".....Q", "..Q..."],
        ["....Q.", "..Q...", "Q.....", ".....Q", "...Q..", ".Q...."],
    ])
);

// Шумораи ҳалҳо барои n = 1..8.
собит шумораҳо: рақам[] = [];
барои (тағ н = 1; н <= 8; н++) {
    шумораҳо.илова(маликаҳо(н).дарозӣ);
}
санҷ("шумораи ҳалҳо n = 1..8", шумораҳо, [1, 0, 0, 2, 10, 4, 40, 92]);

// Ҳар ҳали n = 8 бояд дуруст бошад: дар ҳар қатор як малика, сутунҳо ва
// диагоналҳо такрор намешаванд.
функсия ҳалиДуруст(тахта: сатр[]): мантиқӣ {
    собит н = тахта.дарозӣ;
    собит сутунҳо = нав Set<рақам>();
    собит диагоналҳо1 = нав Set<рақам>();
    собит диагоналҳо2 = нав Set<рақам>();
    барои (тағ қ = 0; қ < н; қ++) {
        собит с = тахта[қ].индекси("Q");
        агар (с < 0 || тахта[қ].индекси("Q", с + 1) >= 0) {
            бозгашт нодуруст;
        }
        агар (сутунҳо.дорадКалид(с) || диагоналҳо1.дорадКалид(қ - с) || диагоналҳо2.дорадКалид(қ + с)) {
            бозгашт нодуруст;
        }
        сутунҳо.add(с);
        диагоналҳо1.add(қ - с);
        диагоналҳо2.add(қ + с);
    }
    бозгашт дуруст;
}
собит ҳалҳои8 = маликаҳо(8);
санҷ("ҳалҳои n = 8 дурустанд", ҳалҳои8.филтр((т: сатр[]) => !ҳалиДуруст(т)).дарозӣ, 0);
санҷ("ҳалҳои n = 8 гуногунанд", нав Set<сатр>(мураттаб(ҳалҳои8)).ҳаҷм, 92);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
