// 124. Ҷамъи ҳадди аксари роҳ дар дарахти дуӣ (Binary Tree Maximum Path Sum)
// https://leetcode.com/problems/binary-tree-maximum-path-sum/
// Сатҳ: Душвор (Hard)
//
// Шарт: Роҳ — пайдарпаии гиреҳҳоест, ки ҳар ду гиреҳи ҳамсоя бо қирра пайваст
// буда, ҳар гиреҳ на бештар аз як бор меояд; роҳ набояд аз реша гузарад.
// Ҷамъи ҳадди аксари қиматҳои роҳи ғайрихолиро баргардонед.
//
// Усул: Ҷустуҷӯ дар умқ (DFS) — барои ҳар гиреҳ "фоидаи" беҳтарини роҳи
// поёнравро (гиреҳ + беҳтарин шоха, шохаҳои манфӣ = 0) ҳисоб мекунем.
// Роҳе, ки дар ин гиреҳ "хам мешавад" = қимат + фоидаи чап + фоидаи рост;
// беҳтарини онҳоро дар тағйирёбандаи умумӣ нигоҳ медорем.
// Мураккабӣ: вақт O(n), хотира O(h), ки h баландии дарахт аст.

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

функсия ҷамъиАксариРоҳ(реша: ГиреҳиДарахт | холӣ): рақам {
    тағ беҳтарин: рақам = -Infinity;

    функсия фоида(гиреҳ: ГиреҳиДарахт | холӣ): рақам {
        агар (гиреҳ === холӣ) {
            бозгашт 0;
        }
        собит чапӣ = Риёзӣ.ҳаддиАксар(фоида(гиреҳ.чап), 0);
        собит ростӣ = Риёзӣ.ҳаддиАксар(фоида(гиреҳ.рост), 0);
        беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, гиреҳ.қимат + чапӣ + ростӣ);
        бозгашт гиреҳ.қимат + Риёзӣ.ҳаддиАксар(чапӣ, ростӣ);
    }

    фоида(реша);
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҷамъиАксариРоҳ(сохтаниДарахт([1, 2, 3])), 6);
санҷ("мисол 2", ҷамъиАксариРоҳ(сохтаниДарахт([-10, 9, 20, холӣ, холӣ, 15, 7])), 42);
санҷ("як гиреҳи манфӣ", ҷамъиАксариРоҳ(сохтаниДарахт([-3])), -3);
санҷ("ҳама манфӣ", ҷамъиАксариРоҳ(сохтаниДарахт([-2, -1, -3])), -1);
санҷ("фарзанди манфӣ", ҷамъиАксариРоҳ(сохтаниДарахт([2, -1])), 2);
санҷ("роҳ бе реша", ҷамъиАксариРоҳ(сохтаниДарахт([-1, 5, -2, 4, 3])), 12);
санҷ("дарахти калонтар", ҷамъиАксариРоҳ(сохтаниДарахт([5, 4, 8, 11, холӣ, 13, 4, 7, 2, холӣ, холӣ, холӣ, 1])), 48);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
