// 347. K унсури бештар такроршаванда (Top K Frequent Elements)
// https://leetcode.com/problems/top-k-frequent-elements/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати рақамҳо ва адади k дода шудааст. K унсуреро, ки аз ҳама бештар
// такрор мешаванд, бо ҳар тартиб баргардонед. Ҷавоб ягона аст.
//
// Усул: Ҳисоби басомад бо Map, сипас ҷудокунии сабадӣ (bucket sort): сабади
// рақами f ҳамаи унсурҳоеро дорад, ки маҳз f маротиба омадаанд. Сабадҳоро аз
// басомади калонтарин ба поён мегузарем, то k унсур ҷамъ шавад.
// Мураккабӣ: вақт O(n), хотира O(n).

функсия бештарТакроршаванда(рақамҳо: рақам[], к: рақам): рақам[] {
    собит басомад = нав Map<рақам, рақам>();
    барои (собит адад аз рақамҳо) {
        басомад.гузоштан(адад, (басомад.бозгирифтан(адад) ?? 0) + 1);
    }
    собит сабадҳо: рақам[][] = рӯйхат.аз({ length: рақамҳо.дарозӣ + 1 }, () => []);
    барои (собит ҷуфт аз басомад) {
        собит [адад, шумора] = ҷуфт;
        сабадҳо[шумора].илова(адад);
    }
    собит натиҷа: рақам[] = [];
    барои (тағ ф = сабадҳо.дарозӣ - 1; ф > 0 && натиҷа.дарозӣ < к; ф--) {
        барои (собит адад аз сабадҳо[ф]) {
            натиҷа.илова(адад);
            агар (натиҷа.дарозӣ === к) {
                шикастан;
            }
        }
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Тартиби ҷавоб аҳамият надорад — ҳарду тарафро мураттаб мекунем
функсия мураттаб(р: рақам[]): рақам[] {
    бозгашт р.буридан().тартиб((а: рақам, б: рақам) => а - б);
}

санҷ("мисол 1", мураттаб(бештарТакроршаванда([1, 1, 1, 2, 2, 3], 2)), мураттаб([1, 2]));
санҷ("мисол 2", мураттаб(бештарТакроршаванда([1], 1)), мураттаб([1]));
санҷ("мисол 3", мураттаб(бештарТакроршаванда([1, 2, 1, 2, 1, 2, 3, 1, 3, 2], 2)), мураттаб([1, 2]));
санҷ("рақамҳои манфӣ", мураттаб(бештарТакроршаванда([-1, -1, -2, -2, -2, 3], 2)), мураттаб([-2, -1]));
санҷ("k ба шумораи гуногунҳо баробар", мураттаб(бештарТакроршаванда([4, 5, 6], 3)), мураттаб([6, 5, 4]));
санҷ("ҳама якхела", мураттаб(бештарТакроршаванда([5, 5, 5, 5], 1)), мураттаб([5]));

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
