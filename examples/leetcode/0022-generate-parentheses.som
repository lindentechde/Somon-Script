// 22. Тавлиди қавсҳо (Generate Parentheses)
// https://leetcode.com/problems/generate-parentheses/
// Сатҳ: Миёна (Medium)
//
// Шарт: Адади n дода шудааст. Ҳамаи омезишҳои дурусти (мутавозини) n ҷуфт
// қавсро тавлид кунед.
//
// Усул: Бозгашт (backtracking): қавси кушодаро то вақте ки шумораашон аз n кам
// аст, ва қавси пӯшидаро танҳо вақте ки аз кушодаҳо кам аст, илова мекунем —
// ҳамин тавр танҳо сатрҳои дуруст сохта мешаванд.
// Мураккабӣ: вақт O(4^n / √n) (адади Каталан · n), хотира O(n) барои умқи
// рекурсия (бе ҳисоби ҷавоб).

функсия тавлидиҚавсҳо(н: рақам): сатр[] {
    собит натиҷа: сатр[] = [];
    собит роҳ: сатр[] = [];

    функсия бозгаштӣ(кушода: рақам, пӯшида: рақам): беджавоб {
        агар (роҳ.дарозӣ === 2 * н) {
            натиҷа.илова(роҳ.пайвастКардан(""));
            бозгашт;
        }
        агар (кушода < н) {
            роҳ.илова("(");
            бозгаштӣ(кушода + 1, пӯшида);
            роҳ.баровардан();
        }
        агар (пӯшида < кушода) {
            роҳ.илова(")");
            бозгаштӣ(кушода, пӯшида + 1);
            роҳ.баровардан();
        }
    }

    бозгаштӣ(0, 0);
    бозгашт натиҷа;
}

// ---- Ёрирасон барои санҷиш ----
функсия мураттаб(сатрҳо: сатр[]): сатр[] {
    бозгашт сатрҳо.буридан().тартиб();
}

// Оё сатри қавсҳо мутавозин аст
функсия мутавозин(с: сатр): мантиқӣ {
    тағ тавозун = 0;
    барои (собит ҳарф аз с) {
        тавозун += ҳарф === "(" ? 1 : -1;
        агар (тавозун < 0) {
            бозгашт нодуруст;
        }
    }
    бозгашт тавозун === 0;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", мураттаб(тавлидиҚавсҳо(3)),
    мураттаб(["((()))", "(()())", "(())()", "()(())", "()()()"]));
санҷ("мисол 2", тавлидиҚавсҳо(1), ["()"]);
санҷ("n = 2", мураттаб(тавлидиҚавсҳо(2)), мураттаб(["(())", "()()"]));
санҷ("n = 0", тавлидиҚавсҳо(0), [""]);
санҷ("n = 4 (адади Каталан 14)", тавлидиҚавсҳо(4).дарозӣ, 14);

// Ҳадди аксар n = 8: адади Каталан C(8) = 1430
собит ҳашт = тавлидиҚавсҳо(8);
санҷ("n = 8 — шумора", ҳашт.дарозӣ, 1430);
санҷ("n = 8 — ҳама гуногун", нав Set<сатр>(ҳашт).ҳаҷм, 1430);
санҷ("n = 8 — ҳама мутавозин", ҳашт.ҳама((с: сатр) => с.дарозӣ === 16 && мутавозин(с)), дуруст);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
