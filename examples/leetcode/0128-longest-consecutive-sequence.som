// 128. Дарозтарин пайдарпаии пай дар пай (Longest Consecutive Sequence)
// https://leetcode.com/problems/longest-consecutive-sequence/
// Сатҳ: Миёна (Medium)
//
// Шарт: Рӯйхати номураттаби рақамҳо дода шудааст. Дарозии дарозтарин
// пайдарпаии рақамҳои пай дар пайро (х, х+1, х+2, ...) ёбед.
// Алгоритм бояд дар вақти O(n) кор кунад.
//
// Усул: Ҳамаи рақамҳоро ба маҷмӯъ (Set) мегузорем. Пайдарпаиро танҳо аз
// рақаме оғоз мекунем, ки "рақам - 1" дар маҷмӯъ нест (яъне оғози силсила),
// ва то он даме, ки рақами навбатӣ ҳаст, ба пеш меравем.
// Мураккабӣ: вақт O(n) (ҳар рақам ҳадди аксар ду маротиба дида мешавад),
// хотира O(n).

функсия дарозтаринПайдарпаӣ(рақамҳо: рақам[]): рақам {
    собит маҷмӯъ = нав Set<рақам>(рақамҳо);
    тағ беҳтарин = 0;
    барои (собит х аз маҷмӯъ) {
        агар (маҷмӯъ.дорадКалид(х - 1)) {
            давом;
        }
        тағ ҷорӣ = х;
        тағ дарозиСилсила = 1;
        то (маҷмӯъ.дорадКалид(ҷорӣ + 1)) {
            ҷорӣ++;
            дарозиСилсила++;
        }
        беҳтарин = Риёзӣ.ҳаддиАксар(беҳтарин, дарозиСилсила);
    }
    бозгашт беҳтарин;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", дарозтаринПайдарпаӣ([100, 4, 200, 1, 3, 2]), 4);
санҷ("мисол 2", дарозтаринПайдарпаӣ([0, 3, 7, 2, 5, 8, 4, 6, 0, 1]), 9);
санҷ("мисол 3", дарозтаринПайдарпаӣ([1, 0, 1, 2]), 3);
санҷ("рӯйхати холӣ", дарозтаринПайдарпаӣ([]), 0);
санҷ("як унсур", дарозтаринПайдарпаӣ([7]), 1);
санҷ("рақамҳои манфӣ", дарозтаринПайдарпаӣ([-3, 5, -1, 6, -2, 9]), 3);
санҷ("такрорҳо", дарозтаринПайдарпаӣ([2, 2, 2, 3, 3]), 2);

// Вуруди калон: 0..9999 бо тартиби баръакс ва як рақами ҷудогона.
собит калон: рақам[] = [];
барои (тағ и = 9999; и >= 0; и--) {
    калон.илова(и);
}
калон.илова(20000);
санҷ("вуруди калон", дарозтаринПайдарпаӣ(калон), 10000);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
