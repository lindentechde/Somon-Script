// 138. Нусхабардории рӯйхат бо ишоракунаки ихтиёрӣ (Copy List with Random Pointer)
// https://leetcode.com/problems/copy-list-with-random-pointer/
// Сатҳ: Миёна (Medium)
//
// Шарт: Ҳар гиреҳи рӯйхати пайваст ғайр аз ишоракунаки "навбатӣ" боз
// ишоракунаки "ихтиёрӣ" дорад, ки ба ягон гиреҳи рӯйхат ё ба холӣ ишора
// мекунад. Нусхаи амиқи (deep copy) рӯйхатро созед: ҳамаи гиреҳҳо нав
// бошанд ва ҳеҷ ишоракунаки нусха ба гиреҳи рӯйхати аслӣ ишора накунад.
//
// Усул: Бе хеш-ҷадвал, дар се гузариш:
//   1) пас аз ҳар гиреҳи аслӣ нусхаи онро мегузорем: A → A' → B → B' → ...;
//   2) ихтиёрӣ-и нусха = (ихтиёрӣ-и аслӣ).навбатӣ (яъне нусхаи он);
//   3) ду рӯйхатро аз ҳам ҷудо карда, рӯйхати аслиро барқарор мекунем.
// Мураккабӣ: вақт O(n), хотираи иловагӣ O(1) (ғайр аз худи нусха).

синф Гиреҳ {
    қимат: рақам;
    навбатӣ: Гиреҳ | холӣ;
    ихтиёрӣ: Гиреҳ | холӣ;

    конструктор(қимат: рақам) {
        ин.қимат = қимат;
        ин.навбатӣ = холӣ;
        ин.ихтиёрӣ = холӣ;
    }
}

функсия нусхаиАмиқ(сар: Гиреҳ | холӣ): Гиреҳ | холӣ {
    агар (сар === холӣ) {
        бозгашт холӣ;
    }

    // 1) Нусхаҳоро байни гиреҳҳои аслӣ мегузорем: A → A' → B → B' → ...
    тағ ҷорӣ: Гиреҳ | холӣ = сар;
    то (ҷорӣ !== холӣ) {
        собит нусха = нав Гиреҳ(ҷорӣ.қимат);
        нусха.навбатӣ = ҷорӣ.навбатӣ;
        ҷорӣ.навбатӣ = нусха;
        ҷорӣ = нусха.навбатӣ;
    }

    // 2) Ишоракунакҳои ихтиёрии нусхаҳоро муқаррар мекунем
    ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        собит нусха: Гиреҳ | холӣ = ҷорӣ.навбатӣ;
        агар (нусха === холӣ) {
            шикастан;
        }
        собит ҳадаф = ҷорӣ.ихтиёрӣ;
        нусха.ихтиёрӣ = ҳадаф === холӣ ? холӣ : ҳадаф.навбатӣ;
        ҷорӣ = нусха.навбатӣ;
    }

    // 3) Рӯйхатҳоро ҷудо мекунем ва рӯйхати аслиро барқарор мекунем
    собит сариНусха: Гиреҳ | холӣ = сар.навбатӣ;
    ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        собит нусха: Гиреҳ | холӣ = ҷорӣ.навбатӣ;
        агар (нусха === холӣ) {
            шикастан;
        }
        собит баъдӣ: Гиреҳ | холӣ = нусха.навбатӣ;
        ҷорӣ.навбатӣ = баъдӣ;
        нусха.навбатӣ = баъдӣ === холӣ ? холӣ : баъдӣ.навбатӣ;
        ҷорӣ = баъдӣ;
    }
    бозгашт сариНусха;
}

// ---- Ёрирасонҳо: формати LeetCode [[қимат, индекси_ихтиёрӣ | холӣ], ...] ----
навъ Ҷуфт = [рақам, рақам | холӣ];

функсия сохтаниРӯйхат(ҷуфтҳо: Ҷуфт[]): Гиреҳ | холӣ {
    собит гиреҳҳо: Гиреҳ[] = [];
    барои (собит ҷуфт аз ҷуфтҳо) {
        гиреҳҳо.илова(нав Гиреҳ(ҷуфт[0]));
    }
    барои (тағ и = 0; и < гиреҳҳо.дарозӣ; и++) {
        агар (и + 1 < гиреҳҳо.дарозӣ) {
            гиреҳҳо[и].навбатӣ = гиреҳҳо[и + 1];
        }
        собит индекс = ҷуфтҳо[и][1];
        агар (индекс !== холӣ) {
            гиреҳҳо[и].ихтиёрӣ = гиреҳҳо[индекс];
        }
    }
    бозгашт гиреҳҳо.дарозӣ > 0 ? гиреҳҳо[0] : холӣ;
}

функсия баҶуфтҳо(сар: Гиреҳ | холӣ): Ҷуфт[] {
    собит индексҳо = нав Map<Гиреҳ, рақам>();
    собит тартибӣ: Гиреҳ[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        индексҳо.гузоштан(ҷорӣ, тартибӣ.дарозӣ);
        тартибӣ.илова(ҷорӣ);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    собит натиҷа: Ҷуфт[] = [];
    барои (собит гиреҳ аз тартибӣ) {
        собит ҳадаф = гиреҳ.ихтиёрӣ;
        собит индекс = ҳадаф === холӣ ? беқимат : индексҳо.бозгирифтан(ҳадаф);
        натиҷа.илова([гиреҳ.қимат, индекс === беқимат ? холӣ : индекс]);
    }
    бозгашт натиҷа;
}

// Ҳамаи гиреҳҳои рӯйхатро (бо ишоракунакҳои ихтиёрӣ) ҷамъ мекунад
функсия ҳамаиГиреҳҳо(сар: Гиреҳ | холӣ): Set<Гиреҳ> {
    собит маҷмӯъ = нав Set<Гиреҳ>();
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        маҷмӯъ.add(ҷорӣ);
        агар (ҷорӣ.ихтиёрӣ !== холӣ) {
            маҷмӯъ.add(ҷорӣ.ихтиёрӣ);
        }
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт маҷмӯъ;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Нусха мегирад ва се чизро месанҷад: нусха бо аслӣ баробар аст, рӯйхати
// аслӣ тағйир наёфтааст ва нусха ягон гиреҳи умумӣ бо аслӣ надорад.
функсия санҷиНусха(ном: сатр, ҷуфтҳо: Ҷуфт[]): беджавоб {
    собит аслӣ = сохтаниРӯйхат(ҷуфтҳо);
    собит гиреҳҳоиАслӣ = ҳамаиГиреҳҳо(аслӣ);
    собит нусха = нусхаиАмиқ(аслӣ);
    санҷ(ном, баҶуфтҳо(нусха), ҷуфтҳо);
    санҷ(ном + " — аслӣ бетағйир", баҶуфтҳо(аслӣ), ҷуфтҳо);
    тағ умумӣ = 0;
    барои (собит гиреҳ аз ҳамаиГиреҳҳо(нусха)) {
        агар (гиреҳҳоиАслӣ.has(гиреҳ)) {
            умумӣ++;
        }
    }
    санҷ(ном + " — нусхаи амиқ (гиреҳи умумӣ нест)", умумӣ, 0);
}

санҷиНусха("мисол 1", [[7, холӣ], [13, 0], [11, 4], [10, 2], [1, 0]]);
санҷиНусха("мисол 2", [[1, 1], [2, 1]]);
санҷиНусха("мисол 3", [[3, холӣ], [3, 0], [3, холӣ]]);
санҷиНусха("рӯйхати холӣ", []);
санҷиНусха("як гиреҳ, ихтиёрӣ ба худаш", [[5, 0]]);
санҷиНусха("як гиреҳ, ихтиёрӣ холӣ", [[-5, холӣ]]);

// Рӯйхати калон: 500 гиреҳ, ихтиёрӣ = (и * 7) % 500, ҳар панҷум холӣ
собит калон: Ҷуфт[] = [];
барои (тағ и = 0; и < 500; и++) {
    калон.илова([и - 250, и % 5 === 0 ? холӣ : (и * 7) % 500]);
}
санҷиНусха("рӯйхати калон (500)", калон);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
