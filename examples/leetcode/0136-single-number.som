// 136. Рақами ягона (Single Number)
// https://leetcode.com/problems/single-number/
// Сатҳ: Осон (Easy)
//
// Шарт: Дар рӯйхати ғайрихолӣ ҳар рақам ду маротиба омадааст, ба ҷуз як
// рақам, ки танҳо як маротиба омадааст. Он рақамро ёбед; вақти хаттӣ ва
// хотираи доимӣ лозим аст.
//
// Усул: XOR-и ҳамаи рақамҳо — а ^ а = 0 ва а ^ 0 = а, бинобар ин ҷуфтҳо
// якдигарро бекор мекунанд ва танҳо рақами ягона мемонад.
// Мураккабӣ: вақт O(n), хотира O(1).

функсия рақамиЯгона(рақамҳо: рақам[]): рақам {
    тағ натиҷа = 0;
    барои (собит р аз рақамҳо) {
        натиҷа ^= р;
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", рақамиЯгона([2, 2, 1]), 1);
санҷ("мисол 2", рақамиЯгона([4, 1, 2, 1, 2]), 4);
санҷ("мисол 3", рақамиЯгона([1]), 1);
санҷ("рақами манфӣ", рақамиЯгона([-3, 5, 5]), -3);
санҷ("ҳама манфӣ", рақамиЯгона([-1, -2, -1, -2, -30000]), -30000);
санҷ("сифр ягона аст", рақамиЯгона([7, 0, 7]), 0);

// Рӯйхати калон: ҷуфтҳои 1..10000 ва рақами ягонаи 12345 дар миёна.
собит рӯйхатиБузург: рақам[] = [];
барои (тағ и = 1; и <= 10000; и++) {
    рӯйхатиБузург.илова(и);
}
рӯйхатиБузург.илова(12345);
барои (тағ и = 10000; и >= 1; и--) {
    рӯйхатиБузург.илова(и);
}
санҷ("рӯйхати калон", рақамиЯгона(рӯйхатиБузург), 12345);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
