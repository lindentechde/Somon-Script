// 148. Мураттаб кардани рӯйхат (Sort List)
// https://leetcode.com/problems/sort-list/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сари рӯйхати пайваст дода шудааст. Рӯйхатро бо тартиби афзуншавӣ
// мураттаб карда, сари онро баргардонед.
//
// Усул: Ҷудокунӣ ва якҷоякунӣ (merge sort). Миёнаи рӯйхатро бо ду
// ишоракунак (суст ва тез) меёбем, рӯйхатро ду қисм мекунем, ҳар қисмро
// рекурсивӣ мураттаб мекунем ва ду рӯйхати мураттабро якҷоя мекунем.
// Мураккабӣ: вақт O(n log n), хотира O(log n) (стеки рекурсия).

// ---- Гиреҳи рӯйхати пайваст (ListNode) ----
синф ГиреҳиРӯйхат {
    қимат: рақам;
    навбатӣ: ГиреҳиРӯйхат | холӣ;

    конструктор(қимат: рақам, навбатӣ: ГиреҳиРӯйхат | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.навбатӣ = навбатӣ;
    }
}

// Аз рӯйхати рақамҳо рӯйхати пайваст месозад
функсия рӯйхатиПайваст(рақамҳо: рақам[]): ГиреҳиРӯйхат | холӣ {
    тағ сар: ГиреҳиРӯйхат | холӣ = холӣ;
    барои (тағ и = рақамҳо.дарозӣ - 1; и >= 0; и--) {
        сар = нав ГиреҳиРӯйхат(рақамҳо[и], сар);
    }
    бозгашт сар;
}

// Рӯйхати пайвастро ба рӯйхати рақамҳо табдил медиҳад
функсия баРақамҳо(сар: ГиреҳиРӯйхат | холӣ): рақам[] {
    собит натиҷа: рақам[] = [];
    тағ ҷорӣ = сар;
    то (ҷорӣ !== холӣ) {
        натиҷа.илова(ҷорӣ.қимат);
        ҷорӣ = ҷорӣ.навбатӣ;
    }
    бозгашт натиҷа;
}

// Ду рӯйхати мураттабро якҷоя мекунад (устувор: ҳангоми баробарӣ аввал аз чап)
функсия якҷоякунӣ(а: ГиреҳиРӯйхат | холӣ, б: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    собит сохтагӣ = нав ГиреҳиРӯйхат(0);
    тағ дум: ГиреҳиРӯйхат = сохтагӣ;
    тағ чап = а;
    тағ рост = б;
    то (чап !== холӣ && рост !== холӣ) {
        агар (чап.қимат <= рост.қимат) {
            дум.навбатӣ = чап;
            чап = чап.навбатӣ;
        } вагарна {
            дум.навбатӣ = рост;
            рост = рост.навбатӣ;
        }
        дум = дум.навбатӣ;
    }
    дум.навбатӣ = чап !== холӣ ? чап : рост;
    бозгашт сохтагӣ.навбатӣ;
}

функсия мураттабКардан(сар: ГиреҳиРӯйхат | холӣ): ГиреҳиРӯйхат | холӣ {
    агар (сар === холӣ || сар.навбатӣ === холӣ) {
        бозгашт сар;
    }
    // Миёна: суст як қадам, тез ду қадам мегузарад.
    // Вақте ки тез ба охир мерасад, суст охирини нимаи чап аст.
    тағ суст: ГиреҳиРӯйхат = сар;
    тағ тез: ГиреҳиРӯйхат | холӣ = сар.навбатӣ;
    то (тез !== холӣ && тез.навбатӣ !== холӣ) {
        собит баъдӣ = суст.навбатӣ;
        агар (баъдӣ === холӣ) {
            шикастан;
        }
        суст = баъдӣ;
        тез = тез.навбатӣ.навбатӣ;
    }
    собит нимаиРост = суст.навбатӣ;
    суст.навбатӣ = холӣ;
    бозгашт якҷоякунӣ(мураттабКардан(сар), мураттабКардан(нимаиРост));
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

функсия ҳал(рақамҳо: рақам[]): рақам[] {
    бозгашт баРақамҳо(мураттабКардан(рӯйхатиПайваст(рақамҳо)));
}

санҷ("мисол 1", ҳал([4, 2, 1, 3]), [1, 2, 3, 4]);
санҷ("мисол 2", ҳал([-1, 5, 3, 4, 0]), [-1, 0, 3, 4, 5]);
санҷ("мисол 3 (холӣ)", ҳал([]), []);
санҷ("як гиреҳ", ҳал([42]), [42]);
санҷ("ду гиреҳ", ҳал([2, 1]), [1, 2]);
санҷ("аллакай мураттаб", ҳал([1, 2, 3, 4, 5, 6]), [1, 2, 3, 4, 5, 6]);
санҷ("баръакс мураттаб", ҳал([6, 5, 4, 3, 2, 1]), [1, 2, 3, 4, 5, 6]);
санҷ("такрорҳо ва манфӣ", ҳал([3, -2, 3, 0, -2, 3, 1]), [-2, -2, 0, 1, 3, 3, 3]);
санҷ("ҳама баробар", ҳал([7, 7, 7, 7]), [7, 7, 7, 7]);

// Рӯйхати калон: 5000 рақами псевдотасодуфӣ (LCG), бо тартиби ҷорӣ муқоиса
собит калон: рақам[] = [];
тағ тухм = 12345;
барои (тағ и = 0; и < 5000; и++) {
    тухм = (тухм * 48271) % 2147483647;
    калон.илова((тухм % 200001) - 100000);
}
собит интизориКалон = калон.буридан().тартиб((а: рақам, б: рақам) => а - б);
санҷ("рӯйхати калон (5000)", ҳал(калон), интизориКалон);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
