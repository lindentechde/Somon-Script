// 146. Кеши LRU (LRU Cache)
// https://leetcode.com/problems/lru-cache/
// Сатҳ: Миёна (Medium)
//
// Шарт: Сохтори кешро бо гунҷоиши маҳдуд созед, ки қоидаи LRU (Least
// Recently Used — "аз ҳама дертар истифодашуда") дорад:
//   get(калид)  — қиматро бармегардонад ё -1, агар калид набошад;
//   put(калид, қимат) — қиматро мегузорад ё нав мекунад; агар шумораи
//   калидҳо аз гунҷоиш гузарад, калиди аз ҳама дертар истифодашуда хориҷ
//   мешавад. Ҳар ду амал бояд дар O(1) иҷро шаванд.
//
// Усул: Map (калид → гиреҳ) барои ёфтан дар O(1) ва рӯйхати дутарафаи
// пайваст бо ду гиреҳи посбон (sentinel) барои тартиби истифода: гиреҳи
// навтарин пас аз "сар", кӯҳнатарин пеш аз "дум". Ҳар истифода гиреҳро ба
// сар мекашонад; ҳангоми пуршавӣ гиреҳи пеш аз дум хориҷ мешавад.
// Мураккабӣ: get ва put — O(1), хотира O(гунҷоиш).

синф ГиреҳиДутарафа {
    калид: рақам;
    қимат: рақам;
    пеш: ГиреҳиДутарафа | холӣ;
    пас: ГиреҳиДутарафа | холӣ;

    конструктор(калид: рақам, қимат: рақам) {
        ин.калид = калид;
        ин.қимат = қимат;
        ин.пеш = холӣ;
        ин.пас = холӣ;
    }
}

синф КешиLRU {
    хосусӣ гунҷоиш: рақам;
    хосусӣ гиреҳҳо: Map<рақам, ГиреҳиДутарафа>;
    хосусӣ сар: ГиреҳиДутарафа; // посбон: пас аз он навтарин гиреҳ
    хосусӣ дум: ГиреҳиДутарафа; // посбон: пеш аз он кӯҳнатарин гиреҳ

    конструктор(гунҷоиш: рақам) {
        ин.гунҷоиш = гунҷоиш;
        ин.гиреҳҳо = нав Map<рақам, ГиреҳиДутарафа>();
        ин.сар = нав ГиреҳиДутарафа(0, 0);
        ин.дум = нав ГиреҳиДутарафа(0, 0);
        ин.сар.пас = ин.дум;
        ин.дум.пеш = ин.сар;
    }

    // Гиреҳро аз рӯйхати дутарафа ҷудо мекунад
    хосусӣ ҷудоКардан(гиреҳ: ГиреҳиДутарафа): беджавоб {
        собит пешӣ = гиреҳ.пеш;
        собит пасӣ = гиреҳ.пас;
        агар (пешӣ !== холӣ) {
            пешӣ.пас = пасӣ;
        }
        агар (пасӣ !== холӣ) {
            пасӣ.пеш = пешӣ;
        }
    }

    // Гиреҳро фавран пас аз посбони сар мегузорад (навтарин)
    хосусӣ баСарБурдан(гиреҳ: ГиреҳиДутарафа): беджавоб {
        собит аввалӣ = ин.сар.пас;
        гиреҳ.пеш = ин.сар;
        гиреҳ.пас = аввалӣ;
        агар (аввалӣ !== холӣ) {
            аввалӣ.пеш = гиреҳ;
        }
        ин.сар.пас = гиреҳ;
    }

    // get
    хондан(калид: рақам): рақам {
        собит гиреҳ = ин.гиреҳҳо.бозгирифтан(калид);
        агар (гиреҳ === беқимат) {
            бозгашт -1;
        }
        ин.ҷудоКардан(гиреҳ);
        ин.баСарБурдан(гиреҳ);
        бозгашт гиреҳ.қимат;
    }

    // put
    навиштан(калид: рақам, қимат: рақам): беджавоб {
        собит мавҷуда = ин.гиреҳҳо.бозгирифтан(калид);
        агар (мавҷуда !== беқимат) {
            мавҷуда.қимат = қимат;
            ин.ҷудоКардан(мавҷуда);
            ин.баСарБурдан(мавҷуда);
            бозгашт;
        }
        агар (ин.гиреҳҳо.ҳаҷм >= ин.гунҷоиш) {
            собит кӯҳнатарин = ин.дум.пеш;
            агар (кӯҳнатарин !== холӣ && кӯҳнатарин !== ин.сар) {
                ин.ҷудоКардан(кӯҳнатарин);
                ин.гиреҳҳо.нобудКардан(кӯҳнатарин.калид);
            }
        }
        собит навГиреҳ = нав ГиреҳиДутарафа(калид, қимат);
        ин.гиреҳҳо.гузоштан(калид, навГиреҳ);
        ин.баСарБурдан(навГиреҳ);
    }
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Пайдарпаии амалҳои LeetCode-ро иҷро карда, рӯйхати натиҷаҳоро бармегардонад
функсия иҷроКардан(амалҳо: сатр[], далелҳо: рақам[][]): (рақам | холӣ)[] {
    собит натиҷа: (рақам | холӣ)[] = [];
    тағ кеш: КешиLRU | холӣ = холӣ;
    барои (тағ и = 0; и < амалҳо.дарозӣ; и++) {
        собит д = далелҳо[и];
        агар (амалҳо[и] === "LRUCache") {
            кеш = нав КешиLRU(д[0]);
            натиҷа.илова(холӣ);
            давом;
        }
        агар (кеш === холӣ) {
            партофтан нав Хато("Кеш сохта нашудааст");
        }
        интихоб (амалҳо[и]) {
            ҳолат "get":
                натиҷа.илова(кеш.хондан(д[0]));
                шикастан;
            ҳолат "put":
                кеш.навиштан(д[0], д[1]);
                натиҷа.илова(холӣ);
                шикастан;
            пешфарз:
                партофтан нав Хато("Амали номаълум: " + амалҳо[и]);
        }
    }
    бозгашт натиҷа;
}

// Татбиқи оддии O(n) барои муқоиса: Map барои қиматҳо ва массиви калидҳо
// бо тартиби истифода (аз кӯҳна ба нав).
функсия иҷроиОддӣ(амалҳо: сатр[], далелҳо: рақам[][]): (рақам | холӣ)[] {
    собит натиҷа: (рақам | холӣ)[] = [];
    тағ гунҷоиш = 0;
    собит захира = нав Map<рақам, рақам>();
    тағ тартибот: рақам[] = [];
    барои (тағ и = 0; и < амалҳо.дарозӣ; и++) {
        собит д = далелҳо[и];
        собит калид = д[0];
        агар (амалҳо[и] === "LRUCache") {
            гунҷоиш = д[0];
            натиҷа.илова(холӣ);
        } вагарна агар (амалҳо[и] === "get") {
            собит қ = захира.бозгирифтан(калид);
            агар (қ === беқимат) {
                натиҷа.илова(-1);
            } вагарна {
                тартибот = тартибот.филтр((к: рақам) => к !== калид);
                тартибот.илова(калид);
                натиҷа.илова(қ);
            }
        } вагарна {
            агар (захира.дорадКалид(калид)) {
                тартибот = тартибот.филтр((к: рақам) => к !== калид);
            } вагарна агар (захира.ҳаҷм >= гунҷоиш) {
                собит кӯҳна = тартибот.ҳазфиАввал();
                агар (кӯҳна !== беқимат) {
                    захира.нобудКардан(кӯҳна);
                }
            }
            захира.гузоштан(калид, д[1]);
            тартибот.илова(калид);
            натиҷа.илова(холӣ);
        }
    }
    бозгашт натиҷа;
}

санҷ(
    "мисол 1",
    иҷроКардан(
        ["LRUCache", "put", "put", "get", "put", "get", "put", "get", "get", "get"],
        [[2], [1, 1], [2, 2], [1], [3, 3], [2], [4, 4], [1], [3], [4]]
    ),
    [холӣ, холӣ, холӣ, 1, холӣ, -1, холӣ, -1, 3, 4]
);
санҷ(
    "гунҷоиши 1",
    иҷроКардан(
        ["LRUCache", "put", "get", "put", "get", "get"],
        [[1], [2, 1], [2], [3, 2], [2], [3]]
    ),
    [холӣ, холӣ, 1, холӣ, -1, 2]
);
санҷ(
    "put-и такрорӣ тартибро нав мекунад",
    иҷроКардан(
        ["LRUCache", "put", "put", "put", "put", "get", "get"],
        [[2], [2, 1], [1, 1], [2, 3], [4, 1], [1], [2]]
    ),
    [холӣ, холӣ, холӣ, холӣ, холӣ, -1, 3]
);
санҷ(
    "get тартибро нав мекунад",
    иҷроКардан(
        ["LRUCache", "put", "put", "get", "put", "get", "get", "get"],
        [[2], [1, 10], [2, 20], [1], [3, 30], [2], [1], [3]]
    ),
    [холӣ, холӣ, холӣ, 10, холӣ, -1, 10, 30]
);
санҷ(
    "get-и калиди набуда",
    иҷроКардан(["LRUCache", "get", "put", "get", "get"], [[3], [5], [5, 0], [5], [6]]),
    [холӣ, -1, холӣ, 0, -1]
);

// Калон: 3000 амали псевдотасодуфӣ бо гунҷоиши 50 ва 120 калид,
// натиҷа бо татбиқи оддӣ муқоиса карда мешавад.
собит амалҳоиКалон: сатр[] = ["LRUCache"];
собит далелҳоиКалон: рақам[][] = [[50]];
тағ тухм = 7;
барои (тағ и = 0; и < 3000; и++) {
    тухм = (тухм * 48271) % 2147483647;
    собит калид = тухм % 120;
    агар (Риёзӣ.поён(тухм / 1000) % 3 === 0) {
        амалҳоиКалон.илова("put");
        далелҳоиКалон.илова([калид, и]);
    } вагарна {
        амалҳоиКалон.илова("get");
        далелҳоиКалон.илова([калид]);
    }
}
санҷ(
    "3000 амал (муқоиса бо татбиқи оддӣ)",
    иҷроКардан(амалҳоиКалон, далелҳоиКалон),
    иҷроиОддӣ(амалҳоиКалон, далелҳоиКалон)
);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
