// 108. Табдили рӯйхати мураттаб ба дарахти ҷустуҷӯии дуӣ (Convert Sorted Array to Binary Search Tree)
// https://leetcode.com/problems/convert-sorted-array-to-binary-search-tree/
// Сатҳ: Осон (Easy)
//
// Шарт: Рӯйхати рақамҳо бо тартиби афзоиш мураттаб аст. Онро ба дарахти
// ҷустуҷӯии дуии аз ҷиҳати баландӣ мутавозин (height-balanced BST) табдил диҳед.
//
// Усул: Тақсим ва ғалаба — унсури миёнаи бозаи [чап, рост] реша мешавад,
// нимаи чап зердарахти чап ва нимаи рост зердарахти рост.
// Мураккабӣ: вақт O(n), хотира O(log n) барои стеки рекурсия.

// ---- Гиреҳи дарахти дуӣ (TreeNode) ----
синф ГиреҳиДарахт {
    қимат: рақам;
    чап: ГиреҳиДарахт | холӣ;
    рост: ГиреҳиДарахт | холӣ;

    конструктор(қимат: рақам, чап: ГиреҳиДарахт | холӣ = холӣ, рост: ГиреҳиДарахт | холӣ = холӣ) {
        ин.қимат = қимат;
        ин.чап = чап;
        ин.рост = рост;
    }
}

// Дарахтро аз тартиби сатҳӣ месозад (мисли LeetCode: [3, 9, 20, холӣ, холӣ, 15, 7])
функсия сохтаниДарахт(қиматҳо: (рақам | холӣ)[]): ГиреҳиДарахт | холӣ {
    собит аввал = қиматҳо.дарозӣ > 0 ? қиматҳо[0] : холӣ;
    агар (аввал === холӣ) {
        бозгашт холӣ;
    }
    собит реша = нав ГиреҳиДарахт(аввал);
    собит навбат: ГиреҳиДарахт[] = [реша];
    тағ сар = 0;
    тағ и = 1;
    то (сар < навбат.дарозӣ && и < қиматҳо.дарозӣ) {
        собит гиреҳ = навбат[сар];
        сар++;
        собит чапӣ = қиматҳо[и];
        и++;
        агар (чапӣ !== холӣ) {
            гиреҳ.чап = нав ГиреҳиДарахт(чапӣ);
            навбат.илова(гиреҳ.чап);
        }
        агар (и < қиматҳо.дарозӣ) {
            собит ростӣ = қиматҳо[и];
            и++;
            агар (ростӣ !== холӣ) {
                гиреҳ.рост = нав ГиреҳиДарахт(ростӣ);
                навбат.илова(гиреҳ.рост);
            }
        }
    }
    бозгашт реша;
}

// Дарахтро ба тартиби сатҳӣ табдил медиҳад (холӣ-ҳои охир бурида мешаванд)
функсия баСатҳӣ(реша: ГиреҳиДарахт | холӣ): (рақам | холӣ)[] {
    собит натиҷа: (рақам | холӣ)[] = [];
    собит навбат: (ГиреҳиДарахт | холӣ)[] = [реша];
    барои (тағ и = 0; и < навбат.дарозӣ; и++) {
        собит гиреҳ = навбат[и];
        агар (гиреҳ === холӣ) {
            натиҷа.илова(холӣ);
        } вагарна {
            натиҷа.илова(гиреҳ.қимат);
            навбат.илова(гиреҳ.чап);
            навбат.илова(гиреҳ.рост);
        }
    }
    то (натиҷа.дарозӣ > 0 && натиҷа[натиҷа.дарозӣ - 1] === холӣ) {
        натиҷа.баровардан();
    }
    бозгашт натиҷа;
}

функсия рӯйхатБаДарахт(рақамҳо: рақам[]): ГиреҳиДарахт | холӣ {
    функсия бисоз(аввал: рақам, охир: рақам): ГиреҳиДарахт | холӣ {
        агар (аввал > охир) {
            бозгашт холӣ;
        }
        собит миёна = Риёзӣ.поён((аввал + охир) / 2);
        собит гиреҳ = нав ГиреҳиДарахт(рақамҳо[миёна]);
        гиреҳ.чап = бисоз(аввал, миёна - 1);
        гиреҳ.рост = бисоз(миёна + 1, охир);
        бозгашт гиреҳ;
    }
    бозгашт бисоз(0, рақамҳо.дарозӣ - 1);
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

// Ҷавоб ягона нест, бинобар ин хосиятҳоро месанҷем: гузариши мобайнӣ (inorder)
// бояд ба вуруд баробар бошад (яъне дарахт BST аст) ва дарахт мутавозин бошад.
функсия гузаришиМобайнӣ(гиреҳ: ГиреҳиДарахт | холӣ, натиҷа: рақам[]): рақам[] {
    агар (гиреҳ !== холӣ) {
        гузаришиМобайнӣ(гиреҳ.чап, натиҷа);
        натиҷа.илова(гиреҳ.қимат);
        гузаришиМобайнӣ(гиреҳ.рост, натиҷа);
    }
    бозгашт натиҷа;
}

// Баландии дарахтро бармегардонад, ё -1 агар дарахт мутавозин набошад
функсия баландииМутавозин(гиреҳ: ГиреҳиДарахт | холӣ): рақам {
    агар (гиреҳ === холӣ) {
        бозгашт 0;
    }
    собит чапӣ = баландииМутавозин(гиреҳ.чап);
    собит ростӣ = баландииМутавозин(гиреҳ.рост);
    агар (чапӣ < 0 || ростӣ < 0 || Риёзӣ.мутлақ(чапӣ - ростӣ) > 1) {
        бозгашт -1;
    }
    бозгашт Риёзӣ.ҳаддиАксар(чапӣ, ростӣ) + 1;
}

функсия тафтиш(рақамҳо: рақам[]): ҳар[] {
    собит реша = рӯйхатБаДарахт(рақамҳо);
    бозгашт [гузаришиМобайнӣ(реша, []), баландииМутавозин(реша) >= 0];
}

санҷ("мисол 1", тафтиш([-10, -3, 0, 5, 9]), [[-10, -3, 0, 5, 9], дуруст]);
санҷ("мисол 1 (шакл)", баСатҳӣ(рӯйхатБаДарахт([-10, -3, 0, 5, 9])), [0, -10, 5, холӣ, -3, холӣ, 9]);
санҷ("мисол 2", тафтиш([1, 3]), [[1, 3], дуруст]);
санҷ("мисол 2 (шакл)", баСатҳӣ(рӯйхатБаДарахт([1, 3])), [1, холӣ, 3]);
санҷ("як унсур", баСатҳӣ(рӯйхатБаДарахт([7])), [7]);
санҷ("рӯйхати холӣ", баСатҳӣ(рӯйхатБаДарахт([])), []);
санҷ("ҳафт унсур (пурра)", баСатҳӣ(рӯйхатБаДарахт([1, 2, 3, 4, 5, 6, 7])), [4, 2, 6, 1, 3, 5, 7]);

собит калон: рақам[] = рӯйхат.аз({ length: 1000 }, (_: ҳар, и: рақам) => и * 2 - 999);
санҷ("1000 унсур", тафтиш(калон), [калон, дуруст]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
