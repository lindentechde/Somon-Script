// 34. Ёфтани мавқеи аввал ва охири унсур дар рӯйхати мураттаб
//     (Find First and Last Position of Element in Sorted Array)
// https://leetcode.com/problems/find-first-and-last-position-of-element-in-sorted-array/
// Сатҳ: Миёна (Medium)
//
// Шарт: Дар рӯйхати бо тартиби афзоиш мураттаби рақамҳо индекси аввалин ва
// охирини ҳадафро ёбед. Агар ҳадаф набошад, [-1, -1] баргардонед.
// Алгоритм бояд дар вақти O(log n) кор кунад.
//
// Усул: Ду ҷустуҷӯи дуӣ: «ҳудуди поён» — аввалин индекс бо қимати >= х.
// Мавқеи аввал = ҳудуди поёни ҳадаф, мавқеи охир = ҳудуди поёни (ҳадаф + 1) - 1.
// Мураккабӣ: вақт O(log n), хотира O(1).

// Аввалин индексе, ки рақамҳо[индекс] >= х (ё дарозии рӯйхат).
функсия ҳудудиПоён(рақамҳо: рақам[], х: рақам): рақам {
    тағ чап = 0;
    тағ рост = рақамҳо.дарозӣ;
    то (чап < рост) {
        собит миёна = чап + ((рост - чап) >> 1);
        агар (рақамҳо[миёна] < х) {
            чап = миёна + 1;
        } вагарна {
            рост = миёна;
        }
    }
    бозгашт чап;
}

функсия мавқеиАввалуОхир(рақамҳо: рақам[], ҳадаф: рақам): рақам[] {
    собит аввал = ҳудудиПоён(рақамҳо, ҳадаф);
    агар (аввал === рақамҳо.дарозӣ || рақамҳо[аввал] !== ҳадаф) {
        бозгашт [-1, -1];
    }
    собит охир = ҳудудиПоён(рақамҳо, ҳадаф + 1) - 1;
    бозгашт [аввал, охир];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", мавқеиАввалуОхир([5, 7, 7, 8, 8, 10], 8), [3, 4]);
санҷ("мисол 2", мавқеиАввалуОхир([5, 7, 7, 8, 8, 10], 6), [-1, -1]);
санҷ("мисол 3", мавқеиАввалуОхир([], 0), [-1, -1]);
санҷ("як унсур", мавқеиАввалуОхир([1], 1), [0, 0]);
санҷ("ҳама якхела", мавқеиАввалуОхир([2, 2, 2, 2, 2], 2), [0, 4]);
санҷ("дар ибтидо", мавқеиАввалуОхир([1, 1, 2, 3], 1), [0, 1]);
санҷ("дар охир", мавқеиАввалуОхир([1, 2, 3, 3], 3), [2, 3]);
санҷ("калонтар аз ҳама", мавқеиАввалуОхир([1, 2, 3], 4), [-1, -1]);
санҷ("рақамҳои манфӣ", мавқеиАввалуОхир([-5, -3, -3, -3, 0, 4], -3), [1, 3]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
