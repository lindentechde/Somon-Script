// 62. Роҳҳои беназир (Unique Paths)
// https://leetcode.com/problems/unique-paths/
// Сатҳ: Миёна (Medium)
//
// Шарт: Робот дар кунҷи болои чапи шабакаи m x n истодааст ва танҳо ба
// рост ё ба поён ҳаракат карда метавонад. Чанд роҳи гуногун то кунҷи
// поёни рост вуҷуд дорад?
//
// Усул: Барномасозии динамикӣ бо як сатр — шумораи роҳҳо то ҳуҷра
// ба ҷамъи роҳҳо аз ҳуҷраи боло ва ҳуҷраи чап баробар аст.
// Мураккабӣ: вақт O(m·n), хотира O(n).

функсия роҳҳоиБеназир(m: рақам, n: рақам): рақам {
    собит сатрДП: рақам[] = нав рӯйхат(n).пурКардан(1);
    барои (тағ қ = 1; қ < m; қ++) {
        барои (тағ с = 1; с < n; с++) {
            сатрДП[с] += сатрДП[с - 1];
        }
    }
    бозгашт сатрДП[n - 1];
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", роҳҳоиБеназир(3, 7), 28);
санҷ("мисол 2", роҳҳоиБеназир(3, 2), 3);
санҷ("шабакаи 1x1", роҳҳоиБеназир(1, 1), 1);
санҷ("як сатр", роҳҳоиБеназир(1, 10), 1);
санҷ("як сутун", роҳҳоиБеназир(10, 1), 1);
санҷ("10x10", роҳҳоиБеназир(10, 10), 48620);
санҷ("шабакаи калон 23x12", роҳҳоиБеназир(23, 12), 193536720);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
