// 438. Ёфтани ҳамаи анаграммаҳо дар сатр (Find All Anagrams in a String)
// https://leetcode.com/problems/find-all-anagrams-in-a-string/
// Сатҳ: Миёна (Medium)
//
// Шарт: Ду сатри с ва п дода шудаанд. Индексҳои оғози ҳамаи зерсатрҳои с-ро,
// ки анаграммаи п мебошанд, баргардонед. Ҳарфҳо — лотинии хурд (a-z).
//
// Усул: Равзанаи лағжандаи дарозиаш собит (|п|). Шумораи ҳарфҳои п ва
// равзанаро дар ду рӯйхати 26-унсура нигоҳ медорем ва ҳисоби "мувофиқатҳо"
// (чанд ҳарф шумораи баробар доранд)-ро ҳангоми ҳар қадам дар O(1) нав мекунем.
// Агар ҳамаи 26 ҳарф мувофиқ бошанд, оғози равзана ҷавоб аст.
// Мураккабӣ: вақт O(|с| + |п|), хотира O(1) (26 ҳисобкунак).

функсия ҳамаиАнаграммаҳо(с: сатр, п: сатр): рақам[] {
    собит натиҷа: рақам[] = [];
    собит к = п.дарозӣ;
    агар (к === 0 || к > с.дарозӣ) {
        бозгашт натиҷа;
    }
    собит кодиA = "a".кодиАломатДар(0);
    собит лозим: рақам[] = нав рӯйхат(26).пурКардан(0);
    собит равзана: рақам[] = нав рӯйхат(26).пурКардан(0);
    барои (тағ и = 0; и < к; и++) {
        лозим[п.кодиАломатДар(и) - кодиA]++;
        равзана[с.кодиАломатДар(и) - кодиA]++;
    }
    тағ мувофиқ = 0;
    барои (тағ ҳ = 0; ҳ < 26; ҳ++) {
        агар (лозим[ҳ] === равзана[ҳ]) {
            мувофиқ++;
        }
    }

    // Ҳарфи ҳ-ро ба андозаи тағйир ба равзана илова/хориҷ мекунад ва
    // шумораи мувофиқатҳоро нав мекунад.
    собит навкунӣ = (ҳ: рақам, тағйир: рақам): беджавоб => {
        агар (равзана[ҳ] === лозим[ҳ]) {
            мувофиқ--;
        }
        равзана[ҳ] += тағйир;
        агар (равзана[ҳ] === лозим[ҳ]) {
            мувофиқ++;
        }
    };

    барои (тағ оғоз = 0; ; оғоз++) {
        агар (мувофиқ === 26) {
            натиҷа.илова(оғоз);
        }
        собит охир = оғоз + к;
        агар (охир >= с.дарозӣ) {
            шикастан;
        }
        навкунӣ(с.кодиАломатДар(охир) - кодиA, 1);
        навкунӣ(с.кодиАломатДар(оғоз) - кодиA, -1);
    }
    бозгашт натиҷа;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", ҳамаиАнаграммаҳо("cbaebabacd", "abc"), [0, 6]);
санҷ("мисол 2", ҳамаиАнаграммаҳо("abab", "ab"), [0, 1, 2]);
санҷ("п аз с дарозтар", ҳамаиАнаграммаҳо("a", "ab"), []);
санҷ("як ҳарф", ҳамаиАнаграммаҳо("aaaa", "a"), [0, 1, 2, 3]);
санҷ("такрорҳо дар п", ҳамаиАнаграммаҳо("baa", "aa"), [1]);
санҷ("бе мувофиқат", ҳамаиАнаграммаҳо("xyzxyz", "abc"), []);
санҷ("сатри пурра", ҳамаиАнаграммаҳо("listen", "silent"), [0]);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
