// 41. Аввалин адади мусбати гумшуда (First Missing Positive)
// https://leetcode.com/problems/first-missing-positive/
// Сатҳ: Душвор (Hard)
//
// Шарт: Дар рӯйхати тартибнадодаи рақамҳо хурдтарин адади бутуни мусбатеро
// ёбед, ки дар рӯйхат нест. Алгоритм бояд дар вақти O(n) ва бо хотираи
// иловагии O(1) кор кунад.
//
// Усул: Тартибдиҳии даврӣ (cyclic sort) дар худи рӯйхат. Ҷавоб ҳамеша дар
// фосилаи [1, n + 1] аст, бинобар ин ҳар адади х-ро аз фосилаи [1, n] ба
// ҷойи "худаш" — индекси х - 1 — бо иваз кардан мегузорем. Баъд аввалин
// индекси и-ро меёбем, ки дар он и + 1 нест. Ҳар иваз як ададро ба ҷойи
// ниҳоӣ мегузорад, пас шумораи умумии ивазҳо аз n зиёд нест.
// Эзоҳ: рӯйхати вурудӣ тағйир дода мешавад (мисли ҳалли LeetCode).
// Мураккабӣ: вақт O(n), хотираи иловагӣ O(1).

функсия аввалинМусбатиГумшуда(рақамҳо: рақам[]): рақам {
    собит н = рақамҳо.дарозӣ;
    барои (тағ и = 0; и < н; и++) {
        // То даме ки рақамҳо[и] дар фосила аст ва ҳанӯз дар ҷояш нест, иваз мекунем.
        то (рақамҳо[и] >= 1 && рақамҳо[и] <= н && рақамҳо[рақамҳо[и] - 1] !== рақамҳо[и]) {
            собит ҷой = рақамҳо[и] - 1;
            собит муваққатӣ = рақамҳо[ҷой];
            рақамҳо[ҷой] = рақамҳо[и];
            рақамҳо[и] = муваққатӣ;
        }
    }
    барои (тағ и = 0; и < н; и++) {
        агар (рақамҳо[и] !== и + 1) {
            бозгашт и + 1;
        }
    }
    бозгашт н + 1;
}

// ---- Санҷишҳо (Tests) ----
тағ шумораиХато: рақам = 0;

функсия санҷ(ном: сатр, натиҷа: ҳар, интизорӣ: ҳар): беджавоб {
    собит н = JSON.stringify(натиҷа);
    собит и = JSON.stringify(интизорӣ);
    агар (н === и) {
        чоп.сабт("✓ " + ном);
    } вагарна {
        чоп.сабт("✗ " + ном + ": интизор " + и + ", гирифта шуд " + н);
        шумораиХато++;
    }
}

санҷ("мисол 1", аввалинМусбатиГумшуда([1, 2, 0]), 3);
санҷ("мисол 2", аввалинМусбатиГумшуда([3, 4, -1, 1]), 2);
санҷ("мисол 3", аввалинМусбатиГумшуда([7, 8, 9, 11, 12]), 1);
санҷ("як унсур 1", аввалинМусбатиГумшуда([1]), 2);
санҷ("як унсур 2", аввалинМусбатиГумшуда([2]), 1);
санҷ("такрорӣ", аввалинМусбатиГумшуда([1, 1, 2, 2]), 3);
санҷ("ғайримусбат", аввалинМусбатиГумшуда([-5, -3, 0]), 1);
санҷ("пурра 1..n чаппа", аввалинМусбатиГумшуда([5, 4, 3, 2, 1]), 6);

// Рӯйхати дарозтар: 1000..1 (бе 777) бо тартиби камшаванда ва -1.
собит рӯйхатиДароз: рақам[] = [];
барои (тағ и = 1000; и >= 1; и--) {
    агар (и !== 777) {
        рӯйхатиДароз.илова(и);
    }
}
рӯйхатиДароз.илова(-1);
санҷ("рӯйхати калон", аввалинМусбатиГумшуда(рӯйхатиДароз), 777);

агар (шумораиХато > 0) {
    партофтан нав Хато(шумораиХато + " санҷиш нагузашт");
}
чоп.сабт("Ҳамаи санҷишҳо гузаштанд");
