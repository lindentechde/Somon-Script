тағ н = хонданиРақам();
тағ молҳо = [];
барои (тағ и = 0; и < н; и++) {
  молҳо.илова({ ном: хондан(), нарх: хонданиРақам() });
}
тағ ҳамагӣ = 0;
тағ гаронтарин = молҳо[0];
барои (тағ мол аз молҳо) {
  ҳамагӣ += мол.нарх;
  агар (мол.нарх > гаронтарин.нарх) {
    гаронтарин = мол;
  }
}
чоп("Ҳамагӣ:", ҳамагӣ);
чоп("Гаронтарин:", гаронтарин.ном);
